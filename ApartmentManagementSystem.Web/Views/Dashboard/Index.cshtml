    <!-- Notice Board (Manager & Community Leaders) -->
    @if ((isManager || isCommunityLeader) && Model.NoticeBoard != null && Model.NoticeBoard.Any())
    {
        <div class="row mb-4">
            <div class="col-lg-8">
