@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model ApartmentManagementSystem.Web.ViewModels.Onboarding.InviteSuccessViewModel
@{
    ViewData["Title"] = "Invite Created Successfully";
}

<style>
    :root {
        --gradient-success: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
        --shadow-lg: 0 8px 24px rgba(0, 0, 0, 0.15);
    }

    body {
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .success-card {
        background: white;
        border-radius: 20px;
        box-shadow: var(--shadow-lg);
        overflow: hidden;
        max-width: 600px;
        width: 100%;
        margin: 2rem auto;
        border: 3px solid transparent;
        border-image: var(--gradient-success) 1;
    }

    .card-header-gradient {
        background: var(--gradient-success);
        color: white;
        padding: 1.5rem 2rem;
        text-align: center;
    }

        .card-header-gradient h4 {
            margin: 0;
            font-weight: 700;
            font-size: 1.5rem;
        }

            .card-header-gradient h4 i {
                margin-right: 0.5rem;
            }

    .card-body-custom {
        padding: 2rem;
        text-align: center;
    }

    .alert-success-custom {
        background: linear-gradient(135deg, #e6f7f4 0%, #c8f0e6 100%);
        border-radius: 12px;
        padding: 1rem 1.5rem;
        border-left: 4px solid #11998e;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        margin-bottom: 1.5rem;
    }

        .alert-success-custom i {
            font-size: 1.5rem;
            color: #11998e;
        }

    .section-title {
        color: #2d3748;
        font-weight: 700;
        font-size: 1.15rem;
        margin-bottom: 1rem;
    }

    .info-table {
        background: #f7fafc;
        border-radius: 12px;
        padding: 1rem;
        margin-bottom: 1.5rem;
    }

        .info-table tr {
            display: flex;
            justify-content: space-between;
            padding: 0.75rem 1rem;
            border-bottom: 1px solid #e2e8f0;
        }

            .info-table tr:last-child {
                border-bottom: none;
            }

        .info-table th {
            font-weight: 600;
            color: #4a5568;
            text-align: left;
        }

        .info-table td {
            font-weight: 600;
            color: #2d3748;
            text-align: right;
        }

    .otp-display {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 16px;
        padding: 2rem;
        margin: 1.5rem 0;
        box-shadow: 0 8px 20px rgba(102, 126, 234, 0.3);
    }

        .otp-display h3 {
            color: rgba(255, 255, 255, 0.9);
            font-size: 1rem;
            font-weight: 600;
            margin-bottom: 1rem;
        }

    .otp-code-large {
        font-size: 3rem;
        font-weight: 900;
        color: white;
        letter-spacing: 12px;
        font-family: 'Courier New', monospace;
        text-shadow: 0 2px 10px rgba(0, 0, 0, 0.2);
    }

    .otp-note {
        color: rgba(255, 255, 255, 0.85);
        font-size: 0.85rem;
        margin-top: 1rem;
    }

        .otp-note i {
            margin-right: 0.35rem;
        }

    .btn-primary-gradient {
        background: var(--gradient-success);
        border: none;
        color: white;
        border-radius: 12px;
        padding: 0.85rem 2rem;
        font-weight: 600;
        font-size: 1rem;
        width: 100%;
        box-shadow: 0 4px 12px rgba(17, 153, 142, 0.3);
        transition: all 0.3s ease;
        margin-bottom: 0.75rem;
    }

        .btn-primary-gradient:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(17, 153, 142, 0.4);
        }

    .btn-secondary-gradient {
        background: white;
        border: 2px solid #e2e8f0;
        color: #4a5568;
        border-radius: 12px;
        padding: 0.85rem 2rem;
        font-weight: 600;
        width: 100%;
        transition: all 0.3s ease;
    }

        .btn-secondary-gradient:hover {
            border-color: #cbd5e0;
            background: #f7fafc;
        }

    @@media (max-width: 768px) {
        body {
            padding: 1rem;
        }

        .success-card {
            margin: 1rem;
        }

        .card-body-custom {
            padding: 1.5rem;
        }

        .otp-code-large {
            font-size: 2.25rem;
            letter-spacing: 8px;
        }

        .otp-display {
            padding: 1.5rem;
        }
    }
</style>

<div class="container">
    <div class="success-card">
        <div class="card-header-gradient">
            <h4>
                <i class="bi bi-check-circle"></i> Invite Created Successfully
            </h4>
        </div>
        <div class="card-body-custom">
            <div class="alert-success-custom">
                <i class="bi bi-check-circle-fill"></i>
                <span>@Model.Message</span>
            </div>

            <h5 class="section-title">Resident Details</h5>
            <table class="info-table">
                <tr>
                    <th>Name:</th>
                    <td>@Model.FullName</td>
                </tr>
                <tr>
                    <th>Phone:</th>
                    <td>@Model.PrimaryPhone</td>
                </tr>
                <tr>
                    <th>Type:</th>
                    <td>@Model.ResidentType</td>
                </tr>
            </table>

            <div class="otp-display">
                <h3>Generated OTP</h3>
                <div class="otp-code-large">
                    @Model.OtpCode
                </div>
                <p class="otp-note">
                    <i class="bi bi-info-circle"></i> Share this OTP with the resident securely
                </p>
            </div>

            <a asp-action="Create" class="btn btn-primary-gradient">
                <i class="bi bi-person-plus"></i> Onboard Another Resident
            </a>
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-secondary-gradient">
                Back to Dashboard
            </a>
        </div>
    </div>
</div>




