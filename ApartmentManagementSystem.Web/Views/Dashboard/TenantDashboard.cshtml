    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model ApartmentManagementSystem.Web.ViewModels.Dashboard.TenantDashboardViewModel
@{
    ViewData["Title"] = "My Dashboard";
    Layout = "_Layout";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="mb-1">Welcome, @Model.FullName! 👋</h2>
            <p class="text-muted">
                Role: <span class="badge bg-info fs-6">Tenant</span>
            </p>
        </div>
    </div>

    <!-- My Flat Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">🏠 My Flat</h5>
                </div>
                <div class="card-body">
                    @if (Model.MyFlat != null)
                    {
                        <div class="card border-info">
                            <div class="card-body">
                                <h5 class="card-title">Flat @Model.MyFlat.FlatNumber</h5>
                                <p class="card-text">
                                    <strong>Building:</strong> @Model.MyFlat.ApartmentName<br />
                                    <strong>Owner:</strong> @Model.MyFlat.OwnerName<br />
                                    <strong>Status:</strong> <span class="badge bg-success">Active</span>
                                </p>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning">
                            <strong>⚠️ No flat assigned yet.</strong><br />
                            Please contact your owner or administrator.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Stats -->
    <div class="row g-4">
        <div class="col-md-6">
            <div class="card text-white bg-warning">
                <div class="card-body text-center">
                    <div class="display-4">📝</div>
                    <h3>@Model.PendingComplaints</h3>
                    <p class="mb-0">Pending Complaints</p>
                    <hr class="bg-white" />
                    <small>Coming in Phase 5</small>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card text-white bg-danger">
                <div class="card-body text-center">
                    <div class="display-4">💰</div>
                    <h3>₹@Model.PendingRent.ToString("N2")</h3>
                    <p class="mb-0">Pending Rent</p>
                    <hr class="bg-white" />
                    <small>Coming in Phase 6</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0">⚡ Quick Actions</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-2">
                            <button class="btn btn-outline-primary w-100 btn-lg" disabled>
                                📝 Raise Complaint (Phase 5)
                            </button>
                        </div>
                        <div class="col-md-6 mb-2">
                            <button class="btn btn-outline-success w-100 btn-lg" disabled>
                                💰 Pay Rent (Phase 6)
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="alert alert-info mt-4">
        <strong>ℹ️ Limited Access:</strong> As a tenant, you have access to raise complaints and pay rent. For other services, please contact your flat owner.
    </div>
</div>