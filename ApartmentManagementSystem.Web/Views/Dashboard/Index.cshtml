                        <div>
                            <h6 class="card-title text-uppercase">Community Members</h6>
                            <h2 class="mb-0 display-5">@Model.Stats.CommunityMembers</h2>
                            <small>President, Secretary, Treasurer</small>
                        </div>
                        <i class="bi bi-award-fill" style="font-size: 3rem; opacity: 0.3;"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-white bg-danger shadow h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title text-uppercase">Pending Complaints</h6>
                            <h2 class="mb-0 display-5">@Model.Stats.PendingComplaints</h2>
                            <small>Resolved: @Model.Stats.ResolvedComplaintsThisMonth</small>
                        </div>
                        <i class="bi bi-exclamation-triangle-fill" style="font-size: 3rem; opacity: 0.3;"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-white shadow h-100" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title text-uppercase">Today's Visitors</h6>
                            <h2 class="mb-0 display-5">@Model.Stats.TodaysVisitors</h2>
                            <small>Security on duty: @Model.Stats.ActiveSecurityPersonnel</small>
                        </div>
                        <i class="bi bi-door-open-fill" style="font-size: 3rem; opacity: 0.3;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Financial Summary (Only for SuperAdmin & Treasurer) -->
    @if (User.IsInRole("SuperAdmin") || User.IsInRole("Treasurer"))
    {
        <div class="row mb-4">
            <div class="col-12">
                <div class="card border-success shadow">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0"><i class="bi bi-currency-rupee"></i> Financial Summary</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-4">
                                <h6 class="text-muted">Total Outstanding</h6>
                                <h3 class="text-danger">₹@Model.Stats.TotalOutstandingBills.ToString("N2")</h3>
                            </div>
                            <div class="col-md-4">
                                <h6 class="text-muted">Collection This Month</h6>
                                <h3 class="text-success">₹@Model.Stats.CollectionThisMonth.ToString("N2")</h3>
                            </div>
                            <div class="col-md-4">
                                <a href="#" class="btn btn-outline-success btn-lg w-100 mt-3">
                                    <i class="bi bi-graph-up"></i> View Detailed Reports
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Module Cards -->
    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card text-white bg-gradient shadow h-100" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
                <div class="card-body text-center">
                    <div class="display-3 mb-3"><i class="bi bi-clipboard-check"></i></div>
                    <h5 class="card-title">Complaints Management</h5>
                    <h3>@Model.Stats.PendingComplaints Pending</h3>
                    <p class="card-text">Track and resolve resident complaints</p>
                    <hr class="bg-white" />
                    <p class="mb-0"><small>Coming in Phase 5</small></p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card text-white bg-gradient shadow h-100" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);">
                <div class="card-body text-center">
                    <div class="display-3 mb-3"><i class="bi bi-receipt"></i></div>
                    <h5 class="card-title">Billing & Payments</h5>
                    <h3>₹@Model.Stats.TotalOutstandingBills.ToString("N0")</h3>
                    <p class="card-text">Manage maintenance & utility bills</p>
                    <hr class="bg-white" />
                    <p class="mb-0"><small>Coming in Phase 6</small></p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card text-white bg-gradient shadow h-100" style="background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);">
                <div class="card-body text-center">
                    <div class="display-3 mb-3"><i class="bi bi-calendar-event"></i></div>
                    <h5 class="card-title">Visitor Management</h5>
                    <h3>@Model.Stats.TodaysVisitors Today</h3>
                    <p class="card-text">Track visitors and deliveries</p>
                    <hr class="bg-white" />
                    <p class="mb-0"><small>Coming in Phase 7</small></p>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Activities -->
    @if (Model.RecentActivities != null && Model.RecentActivities.Any())
    {
        <div class="row">
            <div class="col-12">
                <div class="card shadow">
                    <div class="card-header bg-dark text-white">
                        <h5 class="mb-0"><i class="bi bi-clock-history"></i> Recent Activities</h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Activity</th>
                                        <th>Type</th>
                                        <th>Timestamp</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var activity in Model.RecentActivities.Take(10))
                                    {
                                        <tr>
                                            <td>@activity.Activity</td>
                                            <td>
                                                <span class="badge bg-primary">@activity.Type</span>
                                            </td>
                                            <td>@activity.Timestamp.ToString("MMM dd, yyyy hh:mm tt")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .bg-gradient {
        background-size: 200% 200%;
        animation: gradient 15s ease infinite;
    }

    @@keyframes gradient {
        0% {
            background-position: 0% 50%;
        }

        50% {
            background-position: 100% 50%;
        }

        100% {
            background-position: 0% 50%;
        }
    }

    .card {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.2) !important;
        }
</style>



*@





