@model dynamic

@{
    ViewData["Title"] = "Dashboard - Skyline";
    Layout = "_Layout";

    // Determine which type of model we have
    bool isSuperAdmin = Model is ApartmentManagementSystem.Web.ViewModels.Dashboard.EnhancedDashboardViewModel;
    bool isManager = Model is ApartmentManagementSystem.Web.ViewModels.Dashboard.ManagerDashboardViewModel;
    bool isCommunityLeader = Model is ApartmentManagementSystem.Web.ViewModels.Dashboard.CommunityLeaderDashboardViewModel;
}

<style>
    :root {
        --primary-color: #4f6d7a;
        --gradient-primary: linear-gradient(135deg, #5a6fd8 0%, #6b4299 100%);
        --gradient-blue: linear-gradient(135deg, #3d96ea 0%, #00c9e0 100%);
        --gradient-green: linear-gradient(135deg, #38c96b 0%, #2dd9b8 100%);
        --gradient-orange: linear-gradient(135deg, #e8658a 0%, #f0c130 100%);
        --gradient-purple: linear-gradient(135deg, #8fa8e8 0%, #3a2685 100%);
        --gradient-teal: linear-gradient(135deg, #0a9254 0%, #35a882 100%);
        --gradient-sunset: linear-gradient(135deg, #e85d5d 0%, #ebb749 100%);
        --bg-main: #f0f2f5;
        --bg-card: #ffffff;
        --text-dark: #1f2933;
        --text-muted: #6b7280;
        --shadow-sm: 0 2px 8px rgba(0,0,0,0.06);
        --shadow-md: 0 4px 16px rgba(0,0,0,0.10);
        --shadow-lg: 0 8px 24px rgba(0,0,0,0.12);
        --shadow-hover: 0 12px 32px rgba(0,0,0,0.15);
    }

    body {
        background: var(--bg-main);
    }

    .dashboard-header h2 {
        font-weight: 700;
        color: var(--text-dark);
        font-size: 1.8rem;
    }

    .role-badge {
        background: var(--gradient-primary);
        color: white;
        padding: 0.35rem 0.9rem;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 600;
        display: inline-block;
        margin-right: 0.4rem;
        box-shadow: 0 2px 8px rgba(90, 111, 216, 0.25);
    }

    .apartment-badge {
        background: var(--gradient-teal);
        color: white;
        padding: 0.5rem 1rem;
        border-radius: 25px;
        font-size: 0.9rem;
        font-weight: 600;
        display: inline-block;
        box-shadow: 0 2px 8px rgba(10, 146, 84, 0.25);
    }

    /* Cards */
    .card {
        border: none;
        border-radius: 16px;
        background: var(--bg-card);
        box-shadow: var(--shadow-sm);
        transition: all 0.3s ease;
    }

        .card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-hover);
        }

    .card-header {
        border: none;
        border-radius: 16px 16px 0 0 !important;
        padding: 1rem 1.25rem;
        font-weight: 600;
        background: var(--primary-color) !important;
        color: white !important;
    }

    .card-body {
        padding: 1.25rem;
    }

    /* Compact Stat Cards - 3 per row */
    .stat-card {
        border-radius: 14px;
        padding: 1.25rem;
        color: white;
        box-shadow: var(--shadow-md);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        height: 100%;
        position: relative;
        overflow: hidden;
    }

        .stat-card::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255,255,255,0.12) 0%, transparent 70%);
            transition: transform 0.6s ease;
        }

        .stat-card:hover::before {
            transform: translate(10%, 10%);
        }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: var(--shadow-hover);
        }

        .stat-card .stat-icon {
            font-size: 2rem;
            opacity: 0.20;
            position: absolute;
            right: 1rem;
            top: 50%;
            transform: translateY(-50%);
        }

        .stat-card h6 {
            text-transform: uppercase;
            font-size: 0.7rem;
            opacity: 0.85;
            font-weight: 600;
            margin-bottom: 0.4rem;
            letter-spacing: 0.5px;
        }

        .stat-card h2 {
            font-size: 1.8rem;
            font-weight: 700;
            margin-bottom: 0.2rem;
        }

        .stat-card small {
            opacity: 0.85;
            font-size: 0.8rem;
        }

        .stat-card.stat-primary {
            background: var(--gradient-primary);
        }

        .stat-card.stat-blue {
            background: var(--gradient-blue);
        }

        .stat-card.stat-green {
            background: var(--gradient-green);
        }

        .stat-card.stat-orange {
            background: var(--gradient-orange);
        }

        .stat-card.stat-purple {
            background: var(--gradient-purple);
        }

        .stat-card.stat-teal {
            background: var(--gradient-teal);
        }

        .stat-card.stat-sunset {
            background: var(--gradient-sunset);
        }

    /* Quick Action Buttons */
    .btn-action {
        padding: 0.7rem 1.25rem;
        border-radius: 10px;
        font-weight: 600;
        transition: all 0.3s ease;
        border: none;
        color: white;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }

        .btn-action:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(0,0,0,0.12);
            color: white;
        }

        .btn-action.btn-primary {
            background: var(--gradient-primary);
        }

        .btn-action.btn-success {
            background: var(--gradient-green);
        }

        .btn-action.btn-info {
            background: var(--gradient-blue);
        }

        .btn-action.btn-warning {
            background: var(--gradient-orange);
        }

        .btn-action.btn-secondary {
            background: var(--gradient-purple);
        }

    /* Portfolio Card */
    .portfolio-card {
        background: var(--gradient-primary);
        border-radius: 16px;
        color: white;
        box-shadow: var(--shadow-lg);
    }

        .portfolio-card .card-header {
            background: transparent !important;
            border-bottom: 1px solid rgba(255, 255, 255, 0.2);
        }

    .portfolio-stat-card {
        background: rgba(255, 255, 255, 0.12);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 12px;
        padding: 1.25rem;
        text-align: center;
        transition: all 0.3s ease;
    }

        .portfolio-stat-card:hover {
            background: rgba(255, 255, 255, 0.20);
            transform: translateY(-4px);
        }

        .portfolio-stat-card i {
            font-size: 2rem;
            margin-bottom: 0.75rem;
            display: block;
            opacity: 0.85;
        }

        .portfolio-stat-card h2 {
            font-size: 2rem;
            margin-bottom: 0.4rem;
            font-weight: 700;
        }

    /* Financial Card */
    .financial-card {
        background: linear-gradient(135deg, #5a6fd8 0%, #6b4299 100%);
        border-radius: 16px;
        color: white;
        padding: 1.5rem;
        box-shadow: var(--shadow-lg);
    }

    .financial-stat {
        text-align: center;
        padding: 1rem;
        background: rgba(255, 255, 255, 0.12);
        border-radius: 12px;
        backdrop-filter: blur(10px);
    }

        .financial-stat h6 {
            font-size: 0.8rem;
            opacity: 0.85;
            margin-bottom: 0.5rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .financial-stat h3 {
            font-size: 1.8rem;
            font-weight: 700;
            margin: 0;
        }

    /* Notice Card */
    .notice-card {
        border-left: 4px solid;
        margin-bottom: 0.75rem;
        transition: all 0.3s ease;
    }

        .notice-card:hover {
            transform: translateX(5px);
            box-shadow: var(--shadow-md);
        }

        .notice-card.priority-urgent {
            border-color: #e85d5d;
        }

        .notice-card.priority-high {
            border-color: #f0c130;
        }

        .notice-card.priority-medium {
            border-color: #3d96ea;
        }

        .notice-card.priority-low {
            border-color: #38c96b;
        }

    /* Module Cards */
    .module-card {
        border-radius: 16px;
        color: white;
        text-align: center;
        padding: 1.75rem 1.5rem;
        box-shadow: var(--shadow-md);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        height: 100%;
        position: relative;
        overflow: hidden;
    }

        .module-card::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255,255,255,0.12) 0%, transparent 70%);
        }

        .module-card:hover {
            transform: translateY(-6px);
            box-shadow: var(--shadow-hover);
        }

        .module-card .module-icon {
            font-size: 3rem;
            margin-bottom: 1rem;
            opacity: 0.9;
        }

        .module-card h5 {
            font-weight: 700;
            font-size: 1.1rem;
            margin-bottom: 0.5rem;
        }

        .module-card h3 {
            font-size: 2rem;
            font-weight: 700;
            margin: 0.75rem 0;
        }

        .module-card p {
            font-size: 0.9rem;
            opacity: 0.85;
            margin-bottom: 1rem;
        }

        .module-card hr {
            background: rgba(255, 255, 255, 0.25);
            opacity: 1;
            height: 1px;
            margin: 1rem 0;
        }

        .module-card.module-orange {
            background: var(--gradient-sunset);
        }

        .module-card.module-blue {
            background: var(--gradient-blue);
        }

        .module-card.module-green {
            background: var(--gradient-teal);
        }

    /* Table Styling */
    .table-hover tbody tr {
        transition: all 0.3s ease;
    }

        .table-hover tbody tr:hover {
            background-color: var(--bg-main);
            transform: scale(1.01);
        }
</style>

<div class="container-fluid mt-4">
    <!-- Welcome Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="dashboard-header">
                <h2 class="mb-2">
                    @if (isManager)
                    {
                        <i class="bi bi-person-badge"></i>
                    }
                    else if (isCommunityLeader)
                    {
                        <i class="bi bi-award"></i>
                    }
                    else
                    {
                        <i class="bi bi-speedometer2"></i>
                    }
                    Welcome, @Model.FullName! 👋
                </h2>
                <p class="text-muted mb-0">
                    @if (isSuperAdmin)
                    {
                        var adminModel = Model as ApartmentManagementSystem.Web.ViewModels.Dashboard.EnhancedDashboardViewModel;
                        if (adminModel.AllRoles.Any())
                        {
                            <span>Roles: </span>
                            foreach (var role in adminModel.AllRoles)
                            {
                                <span class="role-badge">@role</span>
                            }
                        }
                        else
                        {
                            <span>Role: <span class="role-badge">@adminModel.Role</span></span>
                        }
                    }
                    else if (isManager)
                    {
                        var mgrModel = Model as ApartmentManagementSystem.Web.ViewModels.Dashboard.ManagerDashboardViewModel;
                        <span class="role-badge">@mgrModel.Role</span>
                        <span class="apartment-badge">
                            <i class="bi bi-building"></i> @mgrModel.ApartmentName
                        </span>
                    }
                    else if (isCommunityLeader)
                    {
                        var clModel = Model as ApartmentManagementSystem.Web.ViewModels.Dashboard.CommunityLeaderDashboardViewModel;
                        <span class="role-badge">@clModel.Role</span>
                        <span class="apartment-badge">
                            <i class="bi bi-building"></i> @clModel.ApartmentName
                        </span>
                        <span class="badge bg-secondary">
                            <i class="bi bi-house-door"></i> Flat @clModel.FlatNumber
                        </span>
                    }
                </p>
            </div>
        </div>
    </div>

    <!-- Quick Actions Card -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-lightning-charge"></i> Quick Actions</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        @if (isSuperAdmin && User.IsInRole("SuperAdmin"))
                        {
                            <div class="col-lg-3 col-md-6">
                                <a asp-controller="ApartmentBuilder" asp-action="ManageApartments"
                                   class="btn btn-action btn-primary w-100">
                                    <i class="bi bi-buildings"></i> My Apartments
                                </a>
                            </div>
                            <div class="col-lg-3 col-md-6">
                                <a asp-controller="ApartmentBuilder" asp-action="Create"
                                   class="btn btn-action btn-secondary w-100">
                                    <i class="bi bi-building-add"></i> Create Apartment
                                </a>
                            </div>
                            <div class="col-lg-3 col-md-6">
                                <a asp-controller="Onboarding" asp-action="Create" class="btn btn-action btn-success w-100">
                                    <i class="bi bi-person-plus"></i> Onboard Resident
                                </a>
                            </div>
                            <div class="col-lg-3 col-md-6">
                                <button class="btn btn-action btn-info w-100" onclick="showApartmentSelector()">
                                    <i class="bi bi-award"></i> Community Members
                                </button>
                            </div>
                            <div class="col-lg-3 col-md-6">
                                <a asp-controller="StaffMembers" asp-action="Index" class="btn btn-action btn-warning w-100">
                                    <i class="bi bi-person-badge"></i> Staff Members
                                </a>
                            </div>
                            <div class="col-lg-3 col-md-6">
                                <a asp-controller="ResidentManagement" asp-action="Index" class="btn btn-action btn-primary w-100">
                                    <i class="bi bi-house-door"></i> All Residents
                                </a>
                            </div>
                        }
                        else if (isManager)
                        {
                            var mgrModel = Model as ApartmentManagementSystem.Web.ViewModels.Dashboard.ManagerDashboardViewModel;
                            <div class="col-lg-3 col-md-6">
                                <a asp-controller="Onboarding" asp-action="Create" class="btn btn-action btn-success w-100">
                                    <i class="bi bi-person-plus"></i> Onboard Resident
                                </a>
                            </div>
                            <div class="col-lg-3 col-md-6">
                                <button class="btn btn-action btn-info w-100" onclick="goToCommunityMembers('@mgrModel.ApartmentId')">
                                    <i class="bi bi-award"></i> Community Members
                                </button>
                            </div>
                            <div class="col-lg-3 col-md-6">
                                <a asp-controller="StaffMembers" asp-action="Index" class="btn btn-action btn-warning w-100">
                                    <i class="bi bi-person-badge"></i> Staff Members
                                </a>
                            </div>
                            <div class="col-lg-3 col-md-6">
                                <a asp-controller="AdminResidents" asp-action="Pending" class="btn btn-action btn-primary w-100">
                                    <i class="bi bi-hourglass-split"></i> Pending Assignments
                                </a>
                            </div>
                        }
                        else if (isCommunityLeader)
                        {
                            var clModel = Model as ApartmentManagementSystem.Web.ViewModels.Dashboard.CommunityLeaderDashboardViewModel;
                            if (clModel.Role == "President" || clModel.Role == "Secretary")
                            {
                                <div class="col-lg-3 col-md-6">
                                    <a href="/NoticeBoard/Index" class="btn btn-action btn-primary w-100">
                                        <i class="bi bi-megaphone"></i> Notice Board
                                    </a>
                                </div>
                                <div class="col-lg-3 col-md-6">
                                    <a asp-controller="ResidentManagement" asp-action="Index" class="btn btn-action btn-info w-100">
                                        <i class="bi bi-people"></i> View Residents
                                    </a>
                                </div>
                                <div class="col-lg-3 col-md-6">
                                    <a asp-controller="StaffMembers" asp-action="Index" class="btn btn-action btn-warning w-100">
                                        <i class="bi bi-person-badge"></i> Staff Members
                                    </a>
                                </div>
                            }
                            else if (clModel.Role == "Treasurer")
                            {
                                <div class="col-lg-3 col-md-6">
                                    <a href="/Finance/Reports" class="btn btn-action btn-success w-100">
                                        <i class="bi bi-graph-up"></i> Financial Reports
                                    </a>
                                </div>
                                <div class="col-lg-3 col-md-6">
                                    <a asp-controller="ResidentManagement" asp-action="Index" class="btn btn-action btn-info w-100">
                                        <i class="bi bi-people"></i> View Residents
                                    </a>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Apartment Portfolio (SuperAdmin Only) -->
    @if (isSuperAdmin)
    {
        var adminModel = Model as ApartmentManagementSystem.Web.ViewModels.Dashboard.EnhancedDashboardViewModel;
        if (User.IsInRole("SuperAdmin") && adminModel.Stats.TotalApartments.HasValue)
        {
            <div class="row mb-4">
                <div class="col-12">
                    <div class="card portfolio-card">
                        <div class="card-header">
                            <h5 class="mb-0">
                                <i class="bi bi-buildings-fill"></i> Apartment Portfolio Overview
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-lg-3 col-md-6">
                                    <div class="portfolio-stat-card">
                                        <i class="bi bi-building"></i>
                                        <h2>@adminModel.Stats.TotalApartments</h2>
                                        <p class="mb-0 small">Total Apartments</p>
                                    </div>
                                </div>
                                <div class="col-lg-3 col-md-6">
                                    <div class="portfolio-stat-card">
                                        <i class="bi bi-check-circle"></i>
                                        <h2>@adminModel.Stats.ActiveApartments</h2>
                                        <p class="mb-0 small">Active Buildings</p>
                                    </div>
                                </div>
                                <div class="col-lg-3 col-md-6">
                                    <div class="portfolio-stat-card">
                                        <i class="bi bi-layers"></i>
                                        <h2>@adminModel.Stats.TotalFloors</h2>
                                        <p class="mb-0 small">Total Floors</p>
                                    </div>
                                </div>
                                <div class="col-lg-3 col-md-6">
                                    <div class="portfolio-stat-card">
                                        <i class="bi bi-person-badge"></i>
                                        <h2>@adminModel.Stats.TotalManagers</h2>
                                        <p class="mb-0 small">Assigned Managers</p>
                                    </div>
                                </div>
                            </div>
                            <div class="text-center mt-3">
                                <a asp-controller="ApartmentBuilder" asp-action="ManageApartments"
                                   class="btn btn-light" style="border-radius: 10px; font-weight: 600; padding: 0.6rem 1.5rem;">
                                    <i class="bi bi-gear-fill"></i> Manage All Apartments
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    }

    <!-- Statistics Cards -->
    @if (isManager)
    {
        var mgrModel = Model as ApartmentManagementSystem.Web.ViewModels.Dashboard.ManagerDashboardViewModel;
        <div class="row g-3 mb-4">
            <div class="col-lg-3 col-md-6">
                <div class="stat-card stat-primary">
                    <div class="position-relative">
                        <h6>Total Residents</h6>
                        <h2>@mgrModel.Stats.TotalResidents</h2>
                        <small>Active in apartment</small>
                    </div>
                    <i class="bi bi-people-fill stat-icon"></i>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="stat-card stat-green">
                    <div class="position-relative">
                        <h6>Total Flats</h6>
                        <h2>@mgrModel.Stats.TotalFlats</h2>
                        <small>@mgrModel.Stats.OccupiedFlats Occupied</small>
                    </div>
                    <i class="bi bi-building stat-icon"></i>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="stat-card stat-blue">
                    <div class="position-relative">
                        <h6>Vacant Flats</h6>
                        <h2>@mgrModel.Stats.VacantFlats</h2>
                        <small>Available for assignment</small>
                    </div>
                    <i class="bi bi-house stat-icon"></i>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="stat-card stat-orange">
                    <div class="position-relative">
                        <h6>Pending Registrations</h6>
                        <h2>@mgrModel.Stats.PendingRegistrations</h2>
                        <a asp-controller="AdminResidents" asp-action="Pending" class="btn btn-light btn-sm mt-2" style="border-radius: 8px;">
                            <i class="bi bi-eye"></i> View Pending
                        </a>
                    </div>
                    <i class="bi bi-hourglass-split stat-icon"></i>
                </div>
            </div>
        </div>
        <div class="row g-3 mb-4">
            <div class="col-lg-3 col-md-6">
                <div class="stat-card stat-purple">
                    <div class="position-relative">
                        <h6>Staff Members</h6>
                        <h2>@mgrModel.Stats.TotalStaffMembers</h2>
                        <small>@mgrModel.Stats.ActiveStaffMembers Active</small>
                    </div>
                    <i class="bi bi-person-badge-fill stat-icon"></i>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="stat-card stat-teal">
                    <div class="position-relative">
                        <h6>Community Members</h6>
                        <h2>@mgrModel.Stats.CommunityMembers</h2>
                        <small>President, Secretary, Treasurer</small>
                    </div>
                    <i class="bi bi-award-fill stat-icon"></i>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="stat-card stat-sunset">
                    <div class="position-relative">
                        <h6>Pending Complaints</h6>
                        <h2>@mgrModel.Stats.PendingComplaints</h2>
                        <small>Resolved: @mgrModel.Stats.ResolvedComplaintsThisMonth</small>
                    </div>
                    <i class="bi bi-exclamation-triangle-fill stat-icon"></i>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="stat-card stat-blue">
                    <div class="position-relative">
                        <h6>Today's Visitors</h6>
                        <h2>@mgrModel.Stats.TodaysVisitors</h2>
                        <small>Security managed</small>
                    </div>
                    <i class="bi bi-door-open-fill stat-icon"></i>
                </div>
            </div>
        </div>
    }
    else if (isCommunityLeader)
    {
        var clModel = Model as ApartmentManagementSystem.Web.ViewModels.Dashboard.CommunityLeaderDashboardViewModel;
        <div class="row g-3 mb-4">
            <div class="col-lg-3 col-md-6">
                <div class="stat-card stat-primary">
                    <div class="position-relative">
                        <h6>Total Residents</h6>
                        <h2>@clModel.Stats.TotalResidents</h2>
                        <small>Active in apartment</small>
                    </div>
                    <i class="bi bi-people-fill stat-icon"></i>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="stat-card stat-green">
                    <div class="position-relative">
                        <h6>Total Flats</h6>
                        <h2>@clModel.Stats.TotalFlats</h2>
                        <small>@clModel.Stats.OccupiedFlats Occupied</small>
                    </div>
                    <i class="bi bi-building stat-icon"></i>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="stat-card stat-blue">
                    <div class="position-relative">
                        <h6>Vacant Flats</h6>
