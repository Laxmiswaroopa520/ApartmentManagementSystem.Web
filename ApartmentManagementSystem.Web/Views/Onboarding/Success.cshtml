@section Scripts {
    <script>
                function copyDetails() {
                    const details = `Apartment Management System - Invitation Details

        Full Name: @Model.FullName
        Phone Number: @Model.PhoneNumber
        OTP Code: @Model.OtpCode

        Instructions:
        1. Visit: http://localhost:5002/VerifyInvite
        2. Enter your phone number and OTP
        3. Complete registration form
        4. Login with your credentials

        OTP valid until: @Model.ExpiresAt.ToString("hh:mm tt")`;

                    navigator.clipboard.writeText(details).then(function() {
                        alert('✅ Details copied to clipboard!');
                    }, function(err) {
                        alert('❌ Failed to copy: ' + err);
                    });
                }

                // Auto-refresh warning after 9 minutes
                setTimeout(function() {
                    if (confirm('OTP is about to expire! Do you want to create a new invitation?')) {
                        window.location.href = '@Url.Action("Create", "Onboarding")';
                    }
                }, 540000); // 9 minutes
    </script>
}
