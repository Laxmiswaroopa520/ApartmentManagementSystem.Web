        .stats-panel {
            position: absolute;
            left: 1.5rem;
            top: 100px;
            background: rgba(26, 31, 58, 0.95);
            backdrop-filter: blur(10px);
            border-radius: 12px;
            padding: 1.25rem;
            border: 1px solid rgba(102, 126, 234, 0.3);
            min-width: 180px;
