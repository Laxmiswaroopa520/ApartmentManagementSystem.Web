@{
    ViewData["Title"] = "Home";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Skyline Communities</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">

    <style>
        :root {
            --bg-main: #f5f6f7;
            --bg-card: #ffffff;
            --text-dark: #1f2933;
            --text-muted: #6b7280;
            --accent: #4f6d7a;
        }

        body {
            font-family: 'Segoe UI', sans-serif;
            background: var(--bg-main);
            color: var(--text-dark);
        }

        /* Navbar */
        .navbar {
            background: #ffffff;
            box-shadow: 0 2px 15px rgba(0,0,0,0.05);
        }

        .navbar-brand {
            font-weight: 700;
            color: var(--accent);
        }

        /* Hero */
        .hero {
            background: url("https://images.unsplash.com/photo-1501183638710-841dd1904471?w=1600") center/cover no-repeat;
            height: 90vh;
            position: relative;
        }

            .hero::after {
                content: "";
                position: absolute;
                inset: 0;
                background: rgba(0,0,0,0.45);
            }

        .hero-content {
            position: relative;
            z-index: 2;
            color: white;
            height: 100%;
            display: flex;
            align-items: center;
        }

        .hero h1 {
            font-size: 3.2rem;
            font-weight: 700;
        }

        .hero p {
            font-size: 1.2rem;
            color: #e5e7eb;
        }

        /* Buttons */
        .btn-main {
            background: var(--accent);
            color: white;
            border-radius: 50px;
            padding: 0.7rem 2rem;
            border: none;
        }

        .btn-outline-main {
            border: 2px solid white;
            color: white;
            border-radius: 50px;
            padding: 0.7rem 2rem;
        }

        /* Section */
        .section {
            padding: 80px 0;
        }

        .section-title {
            font-weight: 600;
            margin-bottom: 40px;
        }

        /* Gallery */
        .gallery img {
            border-radius: 16px;
            width: 100%;
            height: 250px;
            object-fit: cover;
        }

        /* Card */
        .info-card {
            background: var(--bg-card);
            border-radius: 20px;
            padding: 30px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        }

        /* Footer */
        footer {
            background: #1f2933;
            color: #cbd5e1;
            padding: 40px 0;
        }
    </style>
</head>

<body>

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg fixed-top">
        <div class="container">
            <a class="navbar-brand" href="#"><i class="fas fa-building"></i> Skyline</a>
            <div class="ms-auto">
                <a href="/Login/Index" class="btn btn-main me-2">Login</a>
                <a href="/VerifyInvite/Index" class="btn btn-outline-secondary">New User</a>
            </div>
        </div>
    </nav>

    <!-- Hero -->
    <section class="hero">
        <div class="container hero-content">
            <div class="col-md-7">
                <h1>Modern Living, Connected Communities</h1>
                <p>Experience peaceful apartment living with smart community management.</p>
                <div class="mt-4">
                    <a href="/Login/Index" class="btn btn-main me-3">Resident Login</a>
                    <a href="/VerifyInvite/Index" class="btn btn-outline-main">New User</a>
                </div>
            </div>
        </div>
    </section>

    <!-- Gallery -->
    <section class="section">
        <div class="container">
            <h2 class="section-title text-center">Life at Skyline</h2>
            <div class="row g-4 gallery">
                <div class="col-md-4">
                    <img src="https://images.unsplash.com/photo-1545324418-cc1a3fa10c00?w=800">
                </div>
                <div class="col-md-4">
                    <img src="https://images.unsplash.com/photo-1560448204-e02f11c3d0e2?w=800">
                </div>
                <div class="col-md-4">
                    <img src="https://images.unsplash.com/photo-1582407947304-fd86f028f716?w=800">
                </div>
            </div>
        </div>
    </section>

    <!-- About -->
    <section class="section">
        <div class="container">
            <div class="info-card text-center">
                <h3>About Skyline</h3>
                <p class="text-muted mt-3">
                    Skyline is designed to bring residents together with clarity, comfort, and trust.
                    Our platform supports communities while keeping the experience calm and human.
                </p>
            </div>
        </div>
    </section>

    <!-- Contact -->
    <section class="section">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-md-6 info-card text-center">
                    <h4>Contact Us</h4>
                    <p class="mt-3"><i class="fas fa-envelope"></i> support@skylinecommunities.com</p>
                    <p><i class="fas fa-phone"></i> +1 555 234 6789</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer>
        <div class="container text-center">
            <p>&copy; 2026 Skyline Communities. All rights reserved.</p>
        </div>
    </footer>

</body>
</html>




