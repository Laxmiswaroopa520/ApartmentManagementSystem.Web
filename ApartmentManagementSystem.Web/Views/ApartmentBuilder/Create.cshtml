                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: .4px;
            }

            .ab-sum-table td:last-child {
                color: var(--ab-txt);
                font-weight: 600;
                text-align: right;
            }

    /* LOADING */
    .ab-loading {
        position: fixed;
        inset: 0;
        background: rgba(6,10,26,.92);
        backdrop-filter: blur(8px);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        z-index: 9999;
        gap: 1.4rem;
    }

        .ab-loading p {
            color: var(--ab-txt2);
            font-size: .95rem;
        }

    .ab-spin {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        border: 3px solid rgba(99,102,241,.15);
        border-top-color: var(--ab-acc);
        animation: abspin .8s linear infinite;
    }

    @@keyframes abspin {
        to {
            transform: rotate(360deg);
        }
    }

    /* TOAST */
    .ab-toast {
        position: fixed;
        bottom: 1.75rem;
        right: 1.75rem;
        background: var(--ab-card);
        border: 1px solid var(--ab-border);
        border-radius: var(--ab-r2);
        padding: .9rem 1.4rem;
        display: flex;
        align-items: center;
        gap: .7rem;
        box-shadow: 0 8px 28px rgba(0,0,0,.4);
        z-index: 10000;
        transform: translateY(90px);
        opacity: 0;
        transition: all .32s ease;
        max-width: 360px;
        font-size: .88rem;
        font-weight: 500;
        color: var(--ab-txt);
    }

        .ab-toast.show {
            transform: translateY(0);
            opacity: 1;
        }

        .ab-toast.ok {
            border-left: 3px solid var(--ab-green);
        }

        .ab-toast.err {
            border-left: 3px solid var(--ab-red);
        }

        .ab-toast.ok i {
            color: var(--ab-green);
        }

        .ab-toast.err i {
            color: var(--ab-red);
        }

    @@media(max-width:640px) {
        .ab-card {
            padding: 1.4rem;
        }

        .ab-stats {
            grid-template-columns: repeat(3,1fr);
            gap: .6rem;
        }

        .ab-stat-val {
            font-size: 1.35rem;
        }

        .ab-flat {
            width: 40px;
            height: 40px;
        }

        .ab-flat-num {
            font-size: .6rem;
        }
