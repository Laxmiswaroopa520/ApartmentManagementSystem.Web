                            <td><strong>Total Floors:</strong></td>
                            <td id="summaryFloors">-</td>
                        </tr>
                        <tr>
                            <td><strong>Flats per Floor:</strong></td>
                            <td id="summaryFlatsPerFloor">-</td>
                        </tr>
                        <tr>
                            <td><strong>Total Flats:</strong></td>
                            <td id="summaryTotalFlats">-</td>
                        </tr>
                    </table>
                </div>

                <div class="button-group">
                    <button type="button" class="btn btn-secondary" onclick="previousStep(2)">
                        <i class="fas fa-arrow-left"></i> Previous
                    </button>
                    <button type="button" class="btn btn-success btn-lg" onclick="submitApartment()">
                        <i class="fas fa-check-circle"></i> Create Apartment
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Loading Overlay -->
    <div id="loadingOverlay" class="loading-overlay" style="display: none;">
        <div class="spinner"></div>
        <p>Creating your apartment building...</p>
    </div>
</div>

@section Scripts {
    <script src="~/js/apartment-builder.js"></script>
    <script src="~/js/apartment-visualizer-3d.js"></script>
}

@section Styles {
    <link rel="stylesheet" href="~/css/apartment-builder.css" />
}

