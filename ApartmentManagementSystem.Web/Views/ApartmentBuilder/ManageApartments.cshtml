@* Views/ApartmentBuilder/ManageApartments.cshtml *@
@model List<ApartmentManagementSystem.Web.ViewModels.Apartment.ApartmentListViewModel>

@{
    ViewData["Title"] = "Manage Apartments";
}

<div class="apartments-dashboard">
    <div class="dashboard-header">
        <div class="header-content">
            <h1 class="dashboard-title">
                <i class="fas fa-city"></i>
                My Apartment Buildings
            </h1>
            <p class="dashboard-subtitle">Manage all your properties in one place</p>
        </div>
        <div class="header-actions">
            <a href="@Url.Action("Create", "ApartmentBuilder")" class="btn btn-create">
                <i class="fas fa-plus-circle"></i>
                Create New Apartment
            </a>
        </div>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="empty-state">
            <div class="empty-icon">
                <i class="fas fa-building"></i>
            </div>
            <h3>No Apartments Yet</h3>
            <p>Get started by creating your first apartment building</p>
            <a href="@Url.Action("Create", "ApartmentBuilder")" class="btn btn-primary btn-lg">
                <i class="fas fa-plus"></i> Create Your First Apartment
            </a>
        </div>
    }
    else
    {
        <div class="apartments-grid">
            @foreach (var apartment in Model)
            {
                <div class="apartment-card" data-apartment-id="@apartment.Id">
                    <div class="card-header">
                        <div class="apartment-status status-@apartment.Status.ToLower()">
                            @apartment.Status
                        </div>
                        <div class="card-actions">
                            <button class="btn-icon" title="More options">
                                <i class="fas fa-ellipsis-v"></i>
                            </button>
                        </div>
                    </div>

                    <div class="card-body">
                        <div class="apartment-icon">
                            <i class="fas fa-building"></i>
                        </div>

                        <h3 class="apartment-name">@apartment.Name</h3>

                        <div class="apartment-location">
                            <i class="fas fa-map-marker-alt"></i>
                            <span>@apartment.Address</span>
                        </div>

                        @if (!string.IsNullOrEmpty(apartment.City))
                        {
                            <div class="apartment-city">
                                <i class="fas fa-city"></i>
                                <span>@apartment.City</span>
                            </div>
                        }

                        <div class="apartment-stats">
                            <div class="stat-item">
                                <div class="stat-icon"><i class="fas fa-layer-group"></i></div>
                                <div class="stat-info">
                                    <div class="stat-value">@apartment.TotalFloors</div>
                                    <div class="stat-label">Floors</div>
                                </div>
                            </div>

                            <div class="stat-item">
                                <div class="stat-icon"><i class="fas fa-home"></i></div>
                                <div class="stat-info">
                                    <div class="stat-value">@apartment.TotalFlats</div>
                                    <div class="stat-label">Total Flats</div>
                                </div>
                            </div>

                            <div class="stat-item">
                                <div class="stat-icon"><i class="fas fa-users"></i></div>
                                <div class="stat-info">
                                    <div class="stat-value">@apartment.OccupiedFlats</div>
                                    <div class="stat-label">Occupied</div>
                                </div>
                            </div>
                        </div>

                        <div class="occupancy-bar">
                            @{
                                var occupancyPercent = apartment.TotalFlats > 0
                                                                ? (apartment.OccupiedFlats * 100.0 / apartment.TotalFlats)
                                : 0;
                            }
                            <div class="occupancy-progress">
                                <div class="occupancy-fill" style="width: @occupancyPercent%"></div>
                            </div>
                            <div class="occupancy-text">
                                @occupancyPercent.ToString("F1")% Occupied
                            </div>
                        </div>
                    </div>

                    <div class="card-footer">
                        <a href="@Url.Action("Details", "ApartmentBuilder", new { id = apartment.Id })"
                           class="btn btn-details">
                            <i class="fas fa-info-circle"></i>
                            View Details
                        </a>

                        <a href="@Url.Action("Visualize", "ApartmentBuilder", new { id = apartment.Id })"
                           class="btn btn-visualize">
                            <i class="fas fa-cube"></i>
                            3D View
                        </a>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Styles {
    <style>
        .apartments-dashboard {
            max-width: 1600px;
            margin: 0 auto;
            padding: 40px 20px;
        }

        .dashboard-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 50px;
            flex-wrap: wrap;
            gap: 20px;
        }

        .dashboard-title {
            font-size: 2.5rem;
            font-weight: 800;
            background: linear-gradient(135deg, #667eea, #764ba2);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 10px;
        }

        .dashboard-subtitle {
            font-size: 1.1rem;
            color: #a0aec0;
        }

        .btn-create {
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: white;
            padding: 14px 28px;
            border-radius: 12px;
            text-decoration: none;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            transition: all 0.3s ease;
            box-shadow: 0 5px 20px rgba(102, 126, 234, 0.3);
        }

            .btn-create:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 30px rgba(102, 126, 234, 0.5);
            }

        .empty-state {
            text-align: center;
            padding: 100px 20px;
            background: #1a1f3a;
            border-radius: 20px;
            border: 2px dashed #2d3748;
        }

        .empty-icon {
            font-size: 5rem;
            color: #667eea;
            margin-bottom: 30px;
            opacity: 0.5;
        }

        .empty-state h3 {
            font-size: 2rem;
            margin-bottom: 15px;
            color: white;
        }

        .empty-state p {
            font-size: 1.2rem;
            color: #a0aec0;
            margin-bottom: 30px;
        }

        .apartments-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(380px, 1fr));
            gap: 30px;
            animation: fadeIn 0.6s ease-out;
        }

        .apartment-card {
            background: #1a1f3a;
            border-radius: 20px;
            overflow: hidden;
            border: 1px solid #2d3748;
            transition: all 0.4s cubic-bezier(0.68, -0.55, 0.265, 1.55);
            position: relative;
        }

            .apartment-card::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 4px;
                background: linear-gradient(90deg, #667eea, #764ba2);
            }

            .apartment-card:hover {
                transform: translateY(-10px);
                box-shadow: 0 20px 60px rgba(102, 126, 234, 0.3);
                border-color: #667eea;
            }

        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px;
            border-bottom: 1px solid #2d3748;
        }

        .apartment-status {
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 600;
            text-transform: uppercase;
        }

        .status-active {
            background: rgba(72, 187, 120, 0.2);
            color: #48bb78;
        }

        .status-underconstruction {
            background: rgba(237, 137, 54, 0.2);
            color: #ed8936;
        }

        .status-inactive {
            background: rgba(160, 174, 192, 0.2);
            color: #a0aec0;
        }

        .btn-icon {
            width: 35px;
            height: 35px;
            border-radius: 8px;
            border: none;
            background: rgba(255, 255, 255, 0.05);
            color: #a0aec0;
            cursor: pointer;
            transition: all 0.3s ease;
        }

            .btn-icon:hover {
                background: rgba(255, 255, 255, 0.1);
                color: white;
            }

        .card-body {
            padding: 30px 20px;
            text-align: center;
        }

        .apartment-icon {
            width: 80px;
            height: 80px;
            margin: 0 auto 20px;
            background: linear-gradient(135deg, #667eea, #764ba2);
            border-radius: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.5rem;
            color: white;
            box-shadow: 0 10px 30px rgba(102, 126, 234, 0.3);
        }

        .apartment-name {
            font-size: 1.6rem;
            font-weight: 700;
            color: white;
            margin-bottom: 15px;
        }

        .apartment-location,
        .apartment-city {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            color: #a0aec0;
            margin-bottom: 10px;
        }

        .apartment-stats {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 15px;
            margin: 30px 0;
        }

        .stat-item {
            background: rgba(255, 255, 255, 0.03);
            padding: 15px;
            border-radius: 12px;
            border: 1px solid #2d3748;
        }

        .stat-icon {
            font-size: 1.5rem;
            color: #667eea;
            margin-bottom: 8px;
        }

        .stat-value {
            font-size: 1.8rem;
            font-weight: 800;
            color: white;
        }

        .stat-label {
            font-size: 0.75rem;
            color: #a0aec0;
            text-transform: uppercase;
        }

        .occupancy-bar {
            margin-top: 20px;
        }

        .occupancy-progress {
            height: 8px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 10px;
            overflow: hidden;
            margin-bottom: 8px;
        }

        .occupancy-fill {
            height: 100%;
            background: linear-gradient(90deg, #667eea, #764ba2);
            border-radius: 10px;
            transition: width 1s ease-out;
        }

        .occupancy-text {
            font-size: 0.9rem;
            color: #a0aec0;
            text-align: center;
        }

        .card-footer {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            padding: 20px;
            border-top: 1px solid #2d3748;
        }

        .btn-details,
        .btn-visualize {
            padding: 12px;
            border-radius: 10px;
            text-decoration: none;
            font-weight: 600;
            text-align: center;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .btn-details {
            background: rgba(102, 126, 234, 0.1);
            color: #667eea;
            border: 2px solid #667eea;
        }

            .btn-details:hover {
                background: #667eea;
                color: white;
            }

        .btn-visualize {
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: white;
        }

            .btn-visualize:hover {
                transform: scale(1.05);
                box-shadow: 0 5px 20px rgba(102, 126, 234, 0.4);
            }

        @@media (max-width: 768px) {
            .apartments-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
}
