        @@keyframes slideIn {
            from

        {
            opacity: 0;
            transform: translateX(-30px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }

        }

        .floor-label-fullscreen {
            min-width: 90px;
            font-size: 1.1rem;
            font-weight: 700;
            color: #667eea;
            text-align: right;
