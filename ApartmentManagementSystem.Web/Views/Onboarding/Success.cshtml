                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .otp-display {
        background-color: #f8f9fa;
        border-radius: 10px;
        padding: 20px;
    }

    .otp-code-large {
        font-size: 3rem;
        font-weight: bold;
        color: #0d6efd;
        letter-spacing: 10px;
        font-family: 'Courier New', monospace;
    }
</style>
