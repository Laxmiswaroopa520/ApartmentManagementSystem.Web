@model List<ApartmentManagementSystem.Web.ViewModels.Community.ResidentListViewModel>
@{
    ViewData["Title"] = "All Residents";
    Layout = "_Layout";
    var currentFilter = ViewBag.CurrentFilter as string;

    // Filter to only show residents with assigned flats
   // var assignedResidents = Model.Where(r => !string.IsNullOrEmpty(r.FlatNumber)).ToList();
   // var pendingResidents = Model.Where(r => string.IsNullOrEmpty(r.FlatNumber)).ToList();
    var assignedResidents = Model
     .Where(r => r.Status == "Active")
     .ToList();

    var pendingResidents = Model
        .Where(r => r.Status == "PendingFlatAllocation")
        .ToList();
}

<style>
    :root {
        --gradient-primary: linear-gradient(135deg, #5a6fd8 0%, #6b4299 100%);
        --gradient-success: linear-gradient(135deg, #0e8f7d 0%, #2fd98e 100%);
        --gradient-info: linear-gradient(135deg, #3d96ea 0%, #00c9e0 100%);
        --gradient-warning: linear-gradient(135deg, #e8658a 0%, #f0c130 100%);
        --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.06);
        --shadow-md: 0 4px 16px rgba(0, 0, 0, 0.10);
    }

    body {
        background: #f0f2f5;
    }

    .page-header {
        background: white;
        padding: 1.5rem;
        border-radius: 16px;
        box-shadow: var(--shadow-sm);
        margin-bottom: 1.5rem;
    }

        .page-header h2 {
            font-weight: 700;
            color: #1a202c;
            margin: 0 0 0.5rem 0;
            font-size: 1.75rem;
        }

            .page-header h2 i {
                margin-right: 0.5rem;
            }

        .page-header p {
            color: #718096;
            margin: 0;
        }

        .page-header .btn {
            background: var(--gradient-primary);
            border: none;
            color: white;
            border-radius: 12px;
            padding: 0.75rem 1.5rem;
            font-weight: 600;
            box-shadow: 0 4px 12px rgba(90, 111, 216, 0.25);
            transition: all 0.3s ease;
        }

            .page-header .btn:hover {
                transform: translateY(-2px);
                box-shadow: 0 6px 16px rgba(90, 111, 216, 0.35);
            }

    .filter-tabs {
        background: white;
        padding: 1rem;
        border-radius: 16px;
        box-shadow: var(--shadow-sm);
        margin-bottom: 1.5rem;
    }

        .filter-tabs .btn {
            border-radius: 10px;
            padding: 0.65rem 1.25rem;
            font-weight: 600;
            border: 2px solid transparent;
            transition: all 0.3s ease;
            margin-right: 0.5rem;
            margin-bottom: 0.5rem;
        }

        .filter-tabs .btn-primary {
            background: var(--gradient-primary);
            border: none;
            color: white;
            box-shadow: 0 2px 8px rgba(90, 111, 216, 0.25);
        }

        .filter-tabs .btn-outline-primary {
            background: white;
            border-color: #e2e8f0;
            color: #4a5568;
        }

            .filter-tabs .btn-outline-primary:hover {
                border-color: #5a6fd8;
                color: #5a6fd8;
            }

        .filter-tabs .btn-success {
            background: var(--gradient-success);
            border: none;
            color: white;
            box-shadow: 0 2px 8px rgba(14, 143, 125, 0.25);
        }

        .filter-tabs .btn-outline-success {
            background: white;
            border-color: #e2e8f0;
            color: #4a5568;
        }

            .filter-tabs .btn-outline-success:hover {
                border-color: #0e8f7d;
                color: #0e8f7d;
            }

        .filter-tabs .btn-info {
            background: var(--gradient-info);
            border: none;
            color: white;
            box-shadow: 0 2px 8px rgba(61, 150, 234, 0.25);
        }

        .filter-tabs .btn-outline-info {
            background: white;
            border-color: #e2e8f0;
            color: #4a5568;
        }

            .filter-tabs .btn-outline-info:hover {
                border-color: #3d96ea;
                color: #3d96ea;
            }

        .filter-tabs .btn-warning {
            background: var(--gradient-warning);
            border: none;
            color: white;
            box-shadow: 0 2px 8px rgba(232, 101, 138, 0.25);
        }

        .filter-tabs .btn-outline-warning {
            background: white;
            border-color: #e2e8f0;
            color: #4a5568;
        }

            .filter-tabs .btn-outline-warning:hover {
                border-color: #e8658a;
                color: #e8658a;
            }

    .data-card {
        background: white;
        border-radius: 16px;
        box-shadow: var(--shadow-sm);
        overflow: hidden;
        margin-bottom: 1.5rem;
    }

    .card-header-gradient {
        background: var(--gradient-primary);
        color: white;
        padding: 1rem 1.5rem;
        font-weight: 600;
        font-size: 1.05rem;
    }

        .card-header-gradient i {
            margin-right: 0.5rem;
        }

    .table-container {
        overflow-x: auto;
    }

    .modern-table {
        margin: 0;
    }

        .modern-table thead {
            background: #f7fafc;
        }

            .modern-table thead th {
                padding: 1rem 1.25rem;
                font-weight: 600;
                color: #4a5568;
                border: none;
                font-size: 0.9rem;
                text-transform: uppercase;
                letter-spacing: 0.5px;
            }

        .modern-table tbody tr {
            border-bottom: 1px solid #f7fafc;
            transition: all 0.2s ease;
        }

            .modern-table tbody tr:hover {
                background: #f7fafc;
            }

        .modern-table tbody td {
            padding: 1rem 1.25rem;
            color: #2d3748;
            vertical-align: middle;
        }

    .badge {
        padding: 0.35rem 0.75rem;
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.8rem;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
    }

    .badge-gradient {
        background: var(--gradient);
        color: white;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.12);
    }

        .badge-gradient.success {
            --gradient: var(--gradient-success);
        }

        .badge-gradient.info {
            --gradient: var(--gradient-info);
        }

        .badge-gradient.warning {
            --gradient: var(--gradient-warning);
        }

    .stat-card {
        background: white;
        border-radius: 16px;
        padding: 1.5rem;
        box-shadow: var(--shadow-sm);
        text-align: center;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

        .stat-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: var(--gradient);
        }

        .stat-card:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
        }

        .stat-card h3 {
            font-size: 2rem;
            font-weight: 700;
            color: #1a202c;
            margin-bottom: 0.25rem;
        }

        .stat-card p {
            color: #718096;
            font-size: 0.9rem;
            margin: 0;
        }

        .stat-card.primary {
            --gradient: var(--gradient-primary);
        }

        .stat-card.success {
            --gradient: var(--gradient-success);
        }

        .stat-card.info {
            --gradient: var(--gradient-info);
        }

        .stat-card.warning {
            --gradient: var(--gradient-warning);
        }

    .btn-group .btn {
        padding: 0.4rem 0.75rem;
        border-radius: 8px;
        margin-right: 0.25rem;
    }

    .info-alert {
        background: white;
        border-radius: 16px;
        padding: 1.5rem;
        box-shadow: var(--shadow-sm);
        border-left: 4px solid #e8658a;
        margin-bottom: 1.5rem;
    }

        .info-alert i {
            font-size: 1.25rem;
            color: #e8658a;
            margin-right: 0.75rem;
        }

    @@media (max-width: 768px) {
        .page-header

    {
        text-align: center;
    }

    .filter-tabs .btn {
        width: 100%;
        margin-right: 0;
    }

    }
</style>

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-md-8">
            <div class="page-header">
                <h2><i class="bi bi-people"></i> All Residents</h2>
                <p>View and manage residents with assigned flats</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="page-header text-end">
                <a asp-controller="Onboarding" asp-action="Create" class="btn">
                    <i class="bi bi-person-plus-fill"></i> Add New Resident
                </a>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert" style="border-radius: 12px; border-left: 4px solid #0e8f7d;">
            <i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (pendingResidents.Any())
    {
        <div class="info-alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <div>
                    <strong>@pendingResidents.Count resident(s) pending flat assignment</strong>
                    <p class="mb-0 mt-1 text-muted">
                        These residents are not displayed in the list below.
                        <a asp-controller="AdminResidents" asp-action="Pending" class="fw-bold">View pending assignments</a>
                    </p>
                </div>
            </div>
        </div>
    }

    <!-- Filter Buttons -->
    <div class="filter-tabs">
        <a asp-action="Index" class="btn @(string.IsNullOrEmpty(currentFilter) ? "btn-primary" : "btn-outline-primary")">
            <i class="bi bi-people-fill"></i> All Assigned (@assignedResidents.Count)
        </a>
        <a asp-action="Index" asp-route-residentType="Owner"
           class="btn @(currentFilter == "Owner" ? "btn-success" : "btn-outline-success")">
            <i class="bi bi-house-fill"></i> Owners (@assignedResidents.Count(r => r.ResidentType == "Owner"))
        </a>
        <a asp-action="Index" asp-route-residentType="Tenant"
           class="btn @(currentFilter == "Tenant" ? "btn-info" : "btn-outline-info")">
            <i class="bi bi-person"></i> Tenants (@assignedResidents.Count(r => r.ResidentType == "Tenant"))
        </a>
        <a asp-controller="AdminResidents" asp-action="Pending"
           class="btn @(currentFilter == "Pending" ? "btn-warning" : "btn-outline-warning")">
            <i class="bi bi-hourglass-split"></i> Pending Assignment (@pendingResidents.Count)
        </a>
    </div>

    <!-- Residents Table -->
    <div class="data-card">
        <div class="card-header-gradient">
            @if (string.IsNullOrEmpty(currentFilter))
            {
                <span>All Assigned Residents (@assignedResidents.Count)</span>
            }
            else
            {
                <span>@currentFilter Residents (@assignedResidents.Count(r => r.ResidentType == currentFilter))</span>
            }
        </div>
        <div class="card-body p-0">
            @if (assignedResidents.Any())
            {
                <div class="table-container">
                    <table class="modern-table table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Full Name</th>
                                <th>Type</th>
                                <th>Apartment</th>      <!--Added Apartment Name also -->
                                <th>Flat Number</th>
                                <th>Email</th>
                                <th>Phone</th>
                                <th>Status</th>
                                <th>Registered On</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var resident in assignedResidents.Where(r => string.IsNullOrEmpty(currentFilter) || r.ResidentType == currentFilter))
                            {
                                <tr>
                                    <td><strong>@resident.FullName</strong></td>
                                    <td>
                                        @if (resident.ResidentType == "Owner")
                                        {
                                            <span class="badge badge-gradient success">
                                                <i class="bi bi-house-fill"></i> Owner
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-gradient info">
                                                <i class="bi bi-person"></i> Tenant
                                            </span>
                                        }
                                    </td>
                                  @*  <td>
                                        <span class="badge bg-secondary" style="font-size: 0.9rem; padding: 0.4rem 0.8rem;">
                                            @resident.FlatNumber
                                        </span>
                                    </td>*@
                                    <td>
                                        @if (!string.IsNullOrEmpty(resident.ApartmentName))
                                        {
                                            <span class="badge badge-gradient success">
                                                <i class="bi bi-building"></i> @resident.ApartmentName
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">N/A</span>
                                        }
                                    </td>

                                    <td>
                                        <span class="badge bg-secondary">
                                            @resident.FlatNumber
                                        </span>
                                    </td>
                                    @*newly added line upto this*@

                                    <td>@resident.Email</td>
                                    <td>@resident.Phone</td>
                                    <td>
                                        @if (resident.Status == "Active")
                                        {
                                            <span class="badge badge-gradient success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Inactive</span>
                                        }
                                    </td>
                                    <td>@resident.RegisteredOn.ToString("MMM dd, yyyy")</td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a asp-action="Details" asp-route-userId="@resident.UserId"
                                               class="btn btn-sm btn-outline-primary"
                                               title="View Details">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            @if (User.IsInRole("SuperAdmin") || User.IsInRole("Manager"))
                                            {
                                                @if (resident.Status == "Active")
                                                {
                                                    <form asp-action="Deactivate" method="post" class="d-inline"
                                                          onsubmit="return confirm('Deactivate @resident.FullName?');">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="userId" value="@resident.UserId" />
                                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Deactivate">
                                                            <i class="bi bi-x-circle"></i>
                                                        </button>
                                                    </form>
                                                }
                                                else
                                                {
                                                    <form asp-action="Activate" method="post" class="d-inline"
                                                          onsubmit="return confirm('Activate @resident.FullName?');">
                                                        <input type="hidden" name="userId" value="@resident.UserId" />
                                                        <button type="submit" class="btn btn-sm btn-outline-success" title="Activate">
                                                            <i class="bi bi-check-circle"></i>
                                                        </button>
                                                    </form>
                                                }
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info m-3" style="border-radius: 12px;">
                    <i class="bi bi-info-circle"></i> No residents with assigned flats found.
                    @if (pendingResidents.Any())
                    {
                        <br />
                        <a asp-controller="AdminResidents" asp-action="Pending" class="alert-link fw-bold">
                            @pendingResidents.Count resident(s) pending flat assignment - Click here to assign flats
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Onboarding" asp-action="Create" class="alert-link fw-bold">
                            Click here to add a new resident.
                        </a>
                    }
                </div>
            }
        </div>
    </div>

    <!-- Statistics Row -->
    <div class="row g-3">
        <div class="col-md-3 col-sm-6">
            <div class="stat-card primary">
                <h3>@assignedResidents.Count</h3>
                <p>Assigned Residents</p>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="stat-card success">
                <h3>@assignedResidents.Count(r => r.ResidentType == "Owner")</h3>
                <p>Owners</p>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="stat-card info">
                <h3>@assignedResidents.Count(r => r.ResidentType == "Tenant")</h3>
                <p>Tenants</p>
            </div>
        </div>
       <div class="col-md-3 col-sm-6">
            <div class="stat-card warning">
                <h3>@pendingResidents.Count</h3>
                <p>Pending Assignment</p>
            </div>
           
    </div>
</div>






