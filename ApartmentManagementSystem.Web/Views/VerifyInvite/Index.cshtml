@model ApartmentManagementSystem.Web.ViewModels.Onboarding.VerifyOtpViewModel
@{
    ViewData["Title"] = "Verify OTP";
    Layout = "_Layout";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5 col-lg-4">
        <div class="card shadow-lg border-0">
            <div class="card-header bg-info text-white text-center py-3">
                <h3 class="mb-0">📱 Verify OTP</h3>
                <small>Step 1 of 2</small>
            </div>
            <div class="card-body p-4">
                <div class="alert alert-info" role="alert">
                    <strong>ℹ️ Instructions:</strong>
                    <ul class="mb-0 mt-2">
                        <li>Enter your registered phone number</li>
                        <li>Enter the 6-digit OTP sent to you</li>
                    </ul>
                </div>

                <form asp-action="Index" method="post">
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="PrimaryPhone" class="form-label fw-bold"></label>
                        <div class="input-group">
                            <span class="input-group-text">📞</span>
                            <input asp-for="PrimaryPhone"
                                   class="form-control"
                                   placeholder="9876543210"
                                   maxlength="10"
                                   autofocus />
                        </div>
                        <span asp-validation-for="PrimaryPhone" class="text-danger small"></span>
                        <small class="text-muted">Enter 10-digit mobile number</small>
                    </div>

                    <div class="mb-3">
                        <label asp-for="OtpCode" class="form-label fw-bold"></label>
                        <div class="input-group">
                            <span class="input-group-text">🔢</span>
                            <input asp-for="OtpCode"
                                   class="form-control form-control-lg text-center"
                                   placeholder="000000"
                                   maxlength="6"
                                   style="letter-spacing: 0.5em; font-weight: bold;" />
                        </div>
                        <span asp-validation-for="OtpCode" class="text-danger small"></span>
                        <small class="text-muted">Enter the 6-digit OTP</small>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-info btn-lg text-white">
                            <strong>Verify OTP</strong>
                        </button>
                    </div>
                </form>

                <hr class="my-4" />

                <div class="text-center">
                    <p class="text-muted mb-2">Already have an account?</p>
                    <a asp-controller="Login" asp-action="Index" class="btn btn-outline-secondary">
                        🔐 Back to Login
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Auto-format OTP input
        document.querySelector('input[name="OtpCode"]').addEventListener('input', function(e) {
            this.value = this.value.replace(/[^0-9]/g, '');
        });

        // Auto-format phone input
        document.querySelector('input[name="PrimaryPhone"]').addEventListener('input', function(e) {
            this.value = this.value.replace(/[^0-9]/g, '');
        });
    </script>
}