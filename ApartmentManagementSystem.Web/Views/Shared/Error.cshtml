@model ApartmentManagementSystem.Web.ViewModels.ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="alert alert-danger" role="alert">
                <h1 class="alert-heading">⚠️ An Error Occurred</h1>
                <p>We're sorry, but something went wrong while processing your request.</p>
                <hr>
                @if (Model?.ShowRequestId == true)
                {
                    <p class="mb-0">
                        <strong>Request ID:</strong> <code>@Model.RequestId</code>
                    </p>
                }
            </div>

            <div class="mt-3">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                    🏠 Go to Home
                </a>
                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-secondary">
                    📊 Go to Dashboard
                </a>
            </div>
        </div>
    </div>
</div>