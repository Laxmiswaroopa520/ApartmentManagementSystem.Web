@*
    Main authenticated layout
    Views/Shared/_Layout.cshtml
    Used for: Dashboard, Management, ApartmentBuilder, etc.
*@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Skyline Communities</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        /* ── STICKY FOOTER: html + body fill the viewport height ── */
        html {
            height: 100%;
        }

        body {
            min-height: 100vh; /* always at least full viewport */
            display: flex;
            flex-direction: column; /* stack navbar → main → footer vertically */
            background: #f5f6f7;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: #1f2933;
        }

        /* main grows to fill leftover space, pushing footer to the bottom */
        main[role="main"] {
            flex: 1 0 auto;
        }

        /* footer never shrinks */
        footer {
            flex-shrink: 0;
            background: #1a2744;
            color: #94a3b8;
        }

        /* ── NAVBAR ── */
        .navbar {
            flex-shrink: 0; /* navbar never shrinks */
            background: #1a2744 !important;
            box-shadow: 0 2px 12px rgba(0,0,0,0.18);
            padding-top: 0;
            padding-bottom: 0;
            min-height: 54px;
        }

        /* Brand */
        .skyline-brand {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-weight: 800;
            font-size: 1.22rem;
            color: #ffffff !important;
            text-decoration: none;
            letter-spacing: -0.3px;
            padding: 0.7rem 0;
            line-height: 1;
        }

            .skyline-brand i {
                font-size: 1.4rem;
                color: #7dd3fc;
            }

            .skyline-brand:hover {
                color: #ffffff !important;
                text-decoration: none;
            }

        /* Nav links */
        .navbar .nav-link {
            color: #cbd5e1 !important;
            font-weight: 500;
            font-size: 0.93rem;
            padding: 1rem 0.85rem !important;
            transition: color 0.2s, background 0.2s;
            border-radius: 6px;
        }

            .navbar .nav-link:hover {
                color: #ffffff !important;
                background: rgba(255,255,255,0.07);
            }

            .navbar .nav-link i,
            .navbar .nav-link .bi {
                margin-right: 4px;
            }

        /* Dropdown */
        .dropdown-menu {
            border-radius: 10px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.13);
            border: 1px solid rgba(0,0,0,0.08);
            padding: 0.4rem;
            min-width: 220px;
            background: #ffffff;
        }

        .dropdown-item {
            padding: 0.55rem 1rem;
            border-radius: 6px;
            transition: all 0.18s;
            font-size: 0.9rem;
            color: #374151;
        }

            .dropdown-item:hover {
                background: #eff3ff;
                color: #3b5bdb;
            }

            .dropdown-item .bi,
            .dropdown-item i {
                width: 18px;
                margin-right: 8px;
                color: #6366f1;
            }

        .dropdown-divider {
            margin: 0.3rem 0.5rem;
            border-color: #e5e7eb;
        }

        /* User pill */
        .user-pill {
            display: flex;
            align-items: center;
            gap: 0.45rem;
            background: rgba(255,255,255,0.1);
            border: 1px solid rgba(255,255,255,0.2);
            border-radius: 50px;
            padding: 0.32rem 0.95rem 0.32rem 0.55rem;
            color: #ffffff !important;
            font-size: 0.88rem;
            font-weight: 600;
            transition: background 0.2s;
        }

            .user-pill:hover {
                background: rgba(255,255,255,0.18) !important;
            }

            .user-pill .bi {
                font-size: 1.1rem;
                color: #7dd3fc;
            }

        /* Mobile toggler */
        .navbar-toggler {
            border-color: rgba(255,255,255,0.3);
        }

        .navbar-toggler-icon {
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 30 30'%3e%3cpath stroke='rgba%28255,255,255,0.8%29' stroke-linecap='round' stroke-miterlimit='10' stroke-width='2' d='M4 7h22M4 15h22M4 23h22'/%3e%3c/svg%3e");
        }

        @@media (max-width: 991px) {
            .navbar-collapse {
                background: #243258;
                margin-top: 0.5rem;
                padding: 0.75rem 1rem;
                border-radius: 10px;
                border: 1px solid rgba(255,255,255,0.08);
            }

            .navbar-nav .dropdown-menu {
                background: #1a2744;
                border: 1px solid rgba(255,255,255,0.1);
            }

            .navbar-nav .dropdown-item {
                color: #cbd5e1;
            }

                .navbar-nav .dropdown-item:hover {
                    background: rgba(255,255,255,0.1);
                    color: #ffffff;
                }

                .navbar-nav .dropdown-item .bi,
                .navbar-nav .dropdown-item i {
                    color: #a5b4fc;
                }
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container-fluid px-4">

            <a class="skyline-brand" href="/">
                <i class="bi bi-buildings"></i>
                Skyline
            </a>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <button class="navbar-toggler ms-auto me-2" type="button"
                        data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto ms-3">

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Dashboard" asp-action="Index">
                                <i class="bi bi-speedometer2"></i> Dashboard
                            </a>
                        </li>

                        @if (User.IsInRole("SuperAdmin") || User.IsInRole("Manager"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle border-0 bg-transparent shadow-none"
                                   href="#" role="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-gear"></i> Management
                                </a>
                                <ul class="dropdown-menu">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Onboarding" asp-action="Create">
                                            <i class="bi bi-person-plus"></i> Onboard Resident
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="AdminResidents" asp-action="Pending">
                                            <i class="bi bi-hourglass-split"></i> Pending Registrations
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="CommunityMembers" asp-action="Index">
                                            <i class="bi bi-award"></i> Community Members
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="StaffMembers" asp-action="Index">
                                            <i class="bi bi-person-badge"></i> Staff Members
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="ResidentManagement" asp-action="Index">
                                            <i class="bi bi-people"></i> All Residents
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="ApartmentBuilder" asp-action="ManageApartments">
                                            <i class="bi bi-buildings"></i> My Apartments
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }

                        @if (User.IsInRole("President") || User.IsInRole("Secretary") || User.IsInRole("Treasurer"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="StaffMembers" asp-action="Index">
                                    <i class="bi bi-person-badge"></i> Staff
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="ResidentManagement" asp-action="Index">
                                    <i class="bi bi-people"></i> Residents
                                </a>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav">
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle user-pill" href="#"
                               id="userDropdown" role="button" data-bs-toggle="dropdown">
                                <i class="bi bi-person-circle"></i>
                                @User.Identity.Name
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li>
                                    <form asp-controller="Login" asp-action="Logout" method="post">
                                        <button type="submit" class="dropdown-item">
                                            <i class="bi bi-box-arrow-right"></i> Logout
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    </ul>
                </div>
            }
        </div>
    </nav>

    <main role="main" class="pb-3">
        @RenderBody()
    </main>

    <footer class="border-top py-3 mt-auto">
        <div class="container text-center small">
            &copy; 2026 Skyline Communities. All rights reserved.
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>













