@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model List<ApartmentManagementSystem.Web.ViewModels.Community.StaffMemberViewModel>
@{
    ViewData["Title"] = "Staff Members";
    Layout = "_Layout";
    var currentFilter = ViewBag.CurrentFilter as string;
}

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-md-8">
            <h2><i class="bi bi-person-badge"></i> Staff Members</h2>
            <p class="text-muted">Manage security, maintenance, and support staff</p>
        </div>
        <div class="col-md-4 text-end">
            <a asp-action="Create" class="btn btn-primary btn-lg">
                <i class="bi bi-person-plus-fill"></i> Add Staff Member
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Filter Buttons -->
    <div class="row mb-3">
        <div class="col-12">
            <div class="btn-group" role="group">
                <a asp-action="Index" class="btn @(string.IsNullOrEmpty(currentFilter) ? "btn-primary" : "btn-outline-primary")">
                    <i class="bi bi-people-fill"></i> All Staff
                </a>
                <a asp-action="Index" asp-route-staffType="Security"
                   class="btn @(currentFilter == "Security" ? "btn-primary" : "btn-outline-primary")">
                    <i class="bi bi-shield-fill"></i> Security
                </a>
                <a asp-action="Index" asp-route-staffType="Plumber"
                   class="btn @(currentFilter == "Plumber" ? "btn-primary" : "btn-outline-primary")">
                    <i class="bi bi-wrench"></i> Plumber
                </a>
                <a asp-action="Index" asp-route-staffType="Electrician"
                   class="btn @(currentFilter == "Electrician" ? "btn-primary" : "btn-outline-primary")">
                    <i class="bi bi-lightning-fill"></i> Electrician
                </a>
                <a asp-action="Index" asp-route-staffType="Carpenter"
                   class="btn @(currentFilter == "Carpenter" ? "btn-primary" : "btn-outline-primary")">
                    <i class="bi bi-hammer"></i> Carpenter
                </a>
                <a asp-action="Index" asp-route-staffType="Sweeper"
                   class="btn @(currentFilter == "Sweeper" ? "btn-primary" : "btn-outline-primary")">
                    <i class="bi bi-broom"></i> Sweeper
                </a>
                <a asp-action="Index" asp-route-staffType="Gardener"
                   class="btn @(currentFilter == "Gardener" ? "btn-primary" : "btn-outline-primary")">
                    <i class="bi bi-tree-fill"></i> Gardener
                </a>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">
                        @if (string.IsNullOrEmpty(currentFilter))
                        {
                            <span>All Staff Members (@Model.Count)</span>
                        }
                        else
                        {
                            <span>@currentFilter Staff (@Model.Count)</span>
                        }
                    </h5>
                </div>
                <div class="card-body">
                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>Name</th>
                                        <th>Type</th>
                                        <th>Phone</th>
                                        <th>Email</th>
                                        <th>Specialization</th>
                                        <th>Hourly Rate</th>
                                        <th>Joined On</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var staff in Model)
                                    {
                                        <tr class="@(staff.IsActive ? "" : "table-secondary")">
                                            <td><strong>@staff.FullName</strong></td>
                                            <td>
                                                @if (staff.StaffType == "Security")
                                                {
                                                    <span class="badge bg-primary"><i class="bi bi-shield-fill"></i> Security</span>
                                                }
                                                else if (staff.StaffType == "Plumber")
                                                {
                                                    <span class="badge bg-info"><i class="bi bi-wrench"></i> Plumber</span>
                                                }
                                                else if (staff.StaffType == "Electrician")
                                                {
                                                    <span class="badge bg-warning"><i class="bi bi-lightning-fill"></i> Electrician</span>
                                                }
                                                else if (staff.StaffType == "Carpenter")
                                                {
                                                    <span class="badge bg-secondary"><i class="bi bi-hammer"></i> Carpenter</span>
                                                }
                                                else if (staff.StaffType == "Sweeper")
                                                {
                                                    <span class="badge bg-success"><i class="bi bi-broom"></i> Sweeper</span>
                                                }
                                                else if (staff.StaffType == "Gardener")
                                                {
                                                    <span class="badge bg-success"><i class="bi bi-tree-fill"></i> Gardener</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-dark">@staff.StaffType</span>
                                                }
                                            </td>
                                            <td>@staff.Phone</td>
                                            <td>@(staff.Email ?? "N/A")</td>
                                            <td>@(staff.Specialization ?? "-")</td>
                                            <td>
                                                @if (staff.HourlyRate.HasValue)
                                                {
                                                    <span class="text-success">₹@staff.HourlyRate.Value.ToString("N2")/hr</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                            <td>@staff.JoinedOn.ToString("MMM dd, yyyy")</td>
                                            <td>
                                                @if (staff.IsActive)
                                                {
                                                    <span class="badge bg-success">Active</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">Inactive</span>
                                                }
                                            </td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    <a asp-action="Edit" asp-route-staffId="@staff.StaffId"
                                                       class="btn btn-sm btn-outline-primary">
                                                        <i class="bi bi-pencil"></i>
                                                    </a>
                                                    @if (staff.IsActive)
                                                    {
                                                        <form asp-action="Deactivate" method="post" class="d-inline"
                                                              onsubmit="return confirm('Deactivate @staff.FullName?');">
                                                            <input type="hidden" name="staffId" value="@staff.StaffId" />
                                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                                <i class="bi bi-x-circle"></i>
                                                            </button>
                                                        </form>
                                                    }
                                                    else
                                                    {
                                                        <form asp-action="Activate" method="post" class="d-inline"
                                                              onsubmit="return confirm('Activate @staff.FullName?');">
                                                            <input type="hidden" name="staffId" value="@staff.StaffId" />
                                                            <button type="submit" class="btn btn-sm btn-outline-success">
                                                                <i class="bi bi-check-circle"></i>
                                                            </button>
                                                        </form>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle"></i> No staff members found.
                            <a asp-action="Create" class="alert-link">Click here to add a staff member.</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Statistics Row -->
    <div class="row mt-4">
        <div class="col-md-3">
            <div class="card text-white bg-primary">
                <div class="card-body text-center">
                    <h3>@Model.Count</h3>
                    <p class="mb-0">Total Staff</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-success">
                <div class="card-body text-center">
                    <h3>@Model.Count(s => s.IsActive)</h3>
                    <p class="mb-0">Active</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-danger">
                <div class="card-body text-center">
                    <h3>@Model.Count(s => !s.IsActive)</h3>
                    <p class="mb-0">Inactive</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-info">
                <div class="card-body text-center">
                    <h3>@Model.Count(s => s.StaffType == "Security")</h3>
                    <p class="mb-0">Security Staff</p>
                </div>
            </div>
        </div>
    </div>
</div>