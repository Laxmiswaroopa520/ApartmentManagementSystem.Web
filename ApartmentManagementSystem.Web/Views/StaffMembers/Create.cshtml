@model ApartmentManagementSystem.Web.ViewModels.Community.CreateStaffMemberViewModel
@{
    ViewData["Title"] = "Add Staff Member";
    Layout = "_Layout";
}

<style>
    :root {
        --gradient-primary: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        --gradient-success: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
        --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.08);
        --shadow-md: 0 4px 16px rgba(0, 0, 0, 0.12);
    }

    body {
        background: #f5f7fa;
    }

    .form-card {
        background: white;
        border-radius: 16px;
        box-shadow: var(--shadow-sm);
        overflow: hidden;
        margin: 2rem auto;
        max-width: 900px;
    }

    .card-header-gradient {
        background: var(--gradient-primary);
        color: white;
        padding: 1.25rem 1.5rem;
        font-weight: 600;
        font-size: 1.25rem;
    }

        .card-header-gradient i {
            margin-right: 0.5rem;
        }

    .form-section-header {
        color: #667eea;
        font-weight: 700;
        font-size: 1.1rem;
        margin-bottom: 1.25rem;
        padding-bottom: 0.5rem;
        border-bottom: 2px solid #e6e9f4;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

        .form-section-header i {
            font-size: 1.25rem;
        }

    .form-label {
        font-weight: 600;
        color: #4a5568;
        margin-bottom: 0.5rem;
        font-size: 0.9rem;
    }

        .form-label .text-danger {
            color: #fa709a !important;
        }

    .form-control, .form-select {
        border: 2px solid #e2e8f0;
        border-radius: 10px;
        padding: 0.75rem 1rem;
        transition: all 0.3s ease;
        font-size: 0.95rem;
    }

        .form-control:focus, .form-select:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
        }

    textarea.form-control {
        resize: vertical;
    }

    .form-check-input {
        width: 1.5rem;
        height: 1.5rem;
        border: 2px solid #e2e8f0;
        margin-top: 0;
    }

        .form-check-input:checked {
            background-color: #667eea;
            border-color: #667eea;
        }

    .form-check-label {
        margin-left: 0.5rem;
        font-weight: 600;
        color: #2d3748;
    }

    .alert-custom {
        border-radius: 12px;
        border: none;
        padding: 1rem 1.25rem;
        background: #fff4e6;
        border-left: 4px solid #fa709a;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

        .alert-custom i {
            font-size: 1.25rem;
            color: #fa709a;
        }

    .btn-submit {
        background: var(--gradient-primary);
        border: none;
        color: white;
        border-radius: 12px;
        padding: 0.85rem 2rem;
        font-weight: 600;
        font-size: 1rem;
        box-shadow: 0 4px 12px rgba(102, 126, 234, 0.3);
        transition: all 0.3s ease;
    }

        .btn-submit:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(102, 126, 234, 0.4);
        }

    .btn-cancel {
        background: white;
        border: 2px solid #e2e8f0;
        color: #4a5568;
        border-radius: 12px;
        padding: 0.85rem 2rem;
        font-weight: 600;
        transition: all 0.3s ease;
    }

        .btn-cancel:hover {
            border-color: #cbd5e0;
            background: #f7fafc;
        }

    .divider {
        border: 0;
        height: 2px;
        background: linear-gradient(to right, transparent, #e2e8f0, transparent);
        margin: 2rem 0;
    }

    @@media (max-width: 768px) {
        .form-card {
            margin: 1rem;
        }

        .btn-submit, .btn-cancel {
            width: 100%;
            margin-bottom: 0.75rem;
        }
    }
</style>

<div class="container mt-4">
    <div class="form-card">
        <div class="card-header-gradient">
            <i class="bi bi-person-plus-fill"></i> Add New Staff Member
        </div>
        <div class="card-body" style="padding: 2rem;">
            <form asp-action="Create" method="post">
                <!-- Basic Information -->
                <h5 class="form-section-header">
                    <i class="bi bi-info-circle"></i> Basic Information
                </h5>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="FullName" class="form-label">Full Name <span class="text-danger">*</span></label>
                        <input asp-for="FullName" class="form-control" placeholder="Enter full name" required />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Phone" class="form-label">Phone Number <span class="text-danger">*</span></label>
                        <input asp-for="Phone" class="form-control" placeholder="Enter phone number" required />
                        <span asp-validation-for="Phone" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Email" class="form-label">Email</label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="Enter email address" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="StaffType" class="form-label">Staff Type <span class="text-danger">*</span></label>
                        <select asp-for="StaffType" class="form-select" required>
                            <option value="">-- Select Type --</option>
                            <option value="Security">🛡️ Security</option>
                            <option value="Plumber">🔧 Plumber</option>
                            <option value="Electrician">⚡ Electrician</option>
                            <option value="Carpenter">🔨 Carpenter</option>
                            <option value="Sweeper">🧹 Sweeper</option>
                            <option value="Gardener">🌳 Gardener</option>
                            <option value="MaintenanceStaff">🛠️ Maintenance Staff</option>
                        </select>
                        <span asp-validation-for="StaffType" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Address" class="form-label">Address</label>
                    <textarea asp-for="Address" class="form-control" rows="2" placeholder="Enter address"></textarea>
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>

                <hr class="divider" />

                <!-- Professional Details -->
                <h5 class="form-section-header">
                    <i class="bi bi-briefcase"></i> Professional Details
                </h5>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Specialization" class="form-label">Specialization</label>
                        <input asp-for="Specialization" class="form-control" placeholder="e.g., Electrical wiring, Plumbing repairs" />
                        <span asp-validation-for="Specialization" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="HourlyRate" class="form-label">Hourly Rate (₹)</label>
                        <input asp-for="HourlyRate" type="number" step="0.01" class="form-control" placeholder="Enter hourly rate" />
                        <span asp-validation-for="HourlyRate" class="text-danger"></span>
                    </div>
                </div>

                <hr class="divider" />

                <!-- Login Access -->
                <h5 class="form-section-header">
                    <i class="bi bi-key"></i> Login Access (Optional)
                </h5>

                <div class="mb-3">
                    <div class="form-check">
                        <input asp-for="CreateLoginAccess" class="form-check-input" type="checkbox" id="createLoginToggle" />
                        <label class="form-check-label" for="createLoginToggle">
                            Create login access for this staff member
                        </label>
                    </div>
                    <small class="text-muted" style="margin-left: 2rem;">
                        Enable this if the staff member needs to access the system (for tasks, reports, etc.)
                    </small>
                </div>

                <div id="loginFields" style="display: none;">
                    <div class="alert-custom mb-3">
                        <i class="bi bi-exclamation-triangle"></i>
                        <div>
                            <strong>Note:</strong> Email is required for creating login access.
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">Password <span class="text-danger">*</span></label>
                        <input asp-for="Password" type="password" class="form-control" placeholder="Enter password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                        <small class="text-muted">Minimum 6 characters</small>
                    </div>
                </div>

                <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="border-radius: 12px;"></div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-action="Index" class="btn btn-cancel">
                        <i class="bi bi-arrow-left"></i> Cancel
                    </a>
                    <button type="submit" class="btn btn-submit">
                        <i class="bi bi-check-circle"></i> Add Staff Member
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.getElementById('createLoginToggle').addEventListener('change', function() {
            const loginFields = document.getElementById('loginFields');
            if (this.checked) {
                loginFields.style.display = 'block';
            } else {
                loginFields.style.display = 'none';
            }
        });
    </script>
}








