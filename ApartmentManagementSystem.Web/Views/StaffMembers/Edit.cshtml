@model ApartmentManagementSystem.Web.ViewModels.Community.UpdateStaffMemberViewModel
@using ApartmentManagementSystem.Web.ViewModels.Community
@{
    ViewData["Title"] = "Edit Staff Member";
    Layout = "_Layout";
}

@section Styles {
    <style>
        .form-wrap {
            max-width: 860px;
            margin: 2rem auto;
            padding: 0 1rem 3rem;
        }

        .back-link {
            display: inline-flex;
            align-items: center;
            gap: .4rem;
            font-size: .88rem;
            font-weight: 600;
            color: #6366f1;
            text-decoration: none;
            padding: .35rem .75rem .35rem .5rem;
            border-radius: 8px;
            border: 1.5px solid #e0e3ff;
            background: #f5f3ff;
            transition: all .18s;
            margin-bottom: 1.4rem;
        }

            .back-link:hover {
                background: #ede9fe;
                border-color: #6366f1;
                text-decoration: none;
            }

                .back-link:hover i {
                    transform: translateX(-3px);
                }

            .back-link i {
                transition: transform .18s;
            }

        .form-card {
            background: #fff;
            border-radius: 16px;
            border: 1.5px solid #e8ecf0;
            box-shadow: 0 4px 18px rgba(0,0,0,.07);
            overflow: hidden;
        }

        .form-card-hdr {
            background: linear-gradient(135deg,#4f46e5,#6366f1);
            color: #fff;
            padding: 1.2rem 1.6rem;
            font-size: 1.15rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: .6rem;
        }

        .form-card-body {
            padding: 2rem;
        }

        .sec-hdr {
            display: flex;
            align-items: center;
            gap: .5rem;
            font-size: 1rem;
            font-weight: 700;
            color: #4f46e5;
            margin-bottom: 1.1rem;
            padding-bottom: .5rem;
            border-bottom: 2px solid #ede9fe;
        }

            .sec-hdr i {
                font-size: 1.15rem;
            }

        .form-label {
            font-weight: 600;
            color: #374151;
            font-size: .88rem;
            margin-bottom: .45rem;
        }

            .form-label .req {
                color: #ef4444;
            }

        .form-control, .form-select {
            border: 1.5px solid #d1d5db;
            border-radius: 10px;
            padding: .7rem 1rem;
            font-size: .92rem;
            transition: all .18s;
        }

            .form-control:focus, .form-select:focus {
                border-color: #6366f1;
                box-shadow: 0 0 0 3px rgba(99,102,241,.12);
            }

        .apt-select-wrap {
            position: relative;
        }

        .apt-select-icon {
            position: absolute;
            left: .9rem;
            top: 50%;
            transform: translateY(-50%);
            color: #6366f1;
            pointer-events: none;
        }

        .apt-select-wrap .form-select {
            padding-left: 2.4rem;
        }

        .divider {
            border: 0;
            height: 1.5px;
            background: linear-gradient(to right,transparent,#e0e3ff,transparent);
            margin: 1.8rem 0;
        }

        .form-actions {
            display: flex;
            justify-content: flex-end;
            gap: .75rem;
            padding-top: 1.2rem;
            border-top: 1.5px solid #f1f5f9;
        }

        .btn-cancel-form {
            background: #fff;
            border: 1.5px solid #d1d5db;
            color: #374151;
            border-radius: 10px;
            padding: .65rem 1.4rem;
            font-weight: 600;
            font-size: .92rem;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: .4rem;
            transition: all .18s;
        }

            .btn-cancel-form:hover {
                border-color: #6366f1;
                color: #4f46e5;
                text-decoration: none;
            }

        .btn-submit-form {
            background: linear-gradient(135deg,#4f46e5,#6366f1);
            border: none;
            color: #fff;
            border-radius: 10px;
            padding: .65rem 1.6rem;
            font-weight: 700;
            font-size: .92rem;
            display: inline-flex;
            align-items: center;
            gap: .4rem;
            cursor: pointer;
            box-shadow: 0 4px 12px rgba(99,102,241,.3);
            transition: all .2s;
        }

            .btn-submit-form:hover {
                transform: translateY(-1px);
                box-shadow: 0 6px 18px rgba(99,102,241,.4);
            }
    </style>
}

<div class="form-wrap">
    <a asp-action="Index" class="back-link">
        <i class="bi bi-arrow-left"></i> Back to Staff Members
    </a>

    <div class="form-card">
        <div class="form-card-hdr">
            <i class="bi bi-pencil-square"></i> Edit Staff Member
        </div>
        <div class="form-card-body">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="StaffId" />

                @* ── Basic Info ── *@
                <div class="sec-hdr"><i class="bi bi-person-fill"></i> Basic Information</div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Full Name <span class="req">*</span></label>
                        <input asp-for="FullName" class="form-control" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Phone Number <span class="req">*</span></label>
                        <input asp-for="Phone" class="form-control" />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Email</label>
                        <input asp-for="Email" type="email" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Status</label>
                        <select asp-for="IsActive" class="form-select">
                            <option value="true">Active</option>
                            <option value="false">Inactive</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Address</label>
                        <textarea asp-for="Address" class="form-control" rows="2"></textarea>
                    </div>
                </div>

                <hr class="divider" />

                @* ── Apartment Assignment ── *@
                <div class="sec-hdr"><i class="bi bi-buildings-fill"></i> Apartment Assignment</div>
                <div class="col-12">
                    <label class="form-label">Assign to Apartment</label>
                    <div class="apt-select-wrap">
                        <i class="bi bi-building-fill apt-select-icon"></i>
                        <select asp-for="ApartmentId" class="form-select">
                            <option value="">-- No Apartment --</option>
                            @if (ViewBag.Apartments != null)
                            {
                                foreach (ApartmentDropdownItem apt in ViewBag.Apartments)
                                {
                                    if (Model.ApartmentId.HasValue && Model.ApartmentId.Value == apt.Id)
                                    {
                                        <option value="@apt.Id" selected>@apt.Name</option>
                                    }
                                    else
                                    {
                                        <option value="@apt.Id">@apt.Name</option>
                                    }
                                }
                            }
                        </select>
                    </div>
                </div>

                <hr class="divider" />

                @* ── Professional Details ── *@
                <div class="sec-hdr"><i class="bi bi-briefcase-fill"></i> Professional Details</div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Specialization</label>
                        <input asp-for="Specialization" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Hourly Rate (₹)</label>
                        <input asp-for="HourlyRate" type="number" step="0.01" class="form-control" />
                    </div>
                </div>

                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 mt-3"></div>

                <div class="form-actions">
                    <a asp-action="Index" class="btn-cancel-form"><i class="bi bi-x-circle"></i> Cancel</a>
                    <button type="submit" class="btn-submit-form"><i class="bi bi-check-circle-fill"></i> Update Staff Member</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

























