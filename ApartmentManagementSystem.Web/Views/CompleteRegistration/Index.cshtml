    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model ApartmentManagementSystem.Web.ViewModels.Onboarding.CompleteRegistrationViewModel

@{
    ViewData["Title"] = "Complete Registration";
    Layout = "_Layout";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-7 col-lg-6">
        <div class="card shadow-lg border-0">
            <div class="card-header bg-success text-white text-center py-3">
                <h3 class="mb-0">✅ Complete Registration</h3>
                <small>Step 2 of 2 - Almost Done!</small>
            </div>

            <div class="card-body p-4">
                <div class="alert alert-success" role="alert">
                    <strong>✅ OTP Verified Successfully!</strong><br />
                    Please complete your profile to finish registration.
                </div>

                <form asp-action="Index" method="post">
                    <input type="hidden" asp-for="PrimaryPhone" />
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <h5 class="mb-3 text-primary">📝 Personal Information</h5>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-bold"></label>
                        <div class="input-group">
                            <span class="input-group-text">👤</span>
                            <input asp-for="FullName" class="form-control" placeholder="Enter your full name" autofocus />
                        </div>
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-bold"></label>
                        <div class="input-group">
                            <span class="input-group-text">📧</span>
                            <input asp-for="Email" class="form-control" type="email" placeholder="your.email@example.com" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="SecondaryPhone" class="form-label fw-bold"></label>
                        <div class="input-group">
                            <span class="input-group-text">📞</span>
                            <input asp-for="SecondaryPhone" class="form-control" placeholder="9876543210" maxlength="10" />
                        </div>
                        <span asp-validation-for="SecondaryPhone" class="text-danger small"></span>
                    </div>

                    <hr class="my-4" />

                    <h5 class="mb-3 text-primary">🔐 Login Credentials</h5>

                    <div class="mb-3">
                        <label asp-for="Username" class="form-label fw-bold"></label>
                        <div class="input-group">
                            <span class="input-group-text">@@</span>
                            <input asp-for="Username"
                                   class="form-control"
                                   placeholder="Choose a username" />
                        </div>
                        <span asp-validation-for="Username" class="text-danger small"></span>
                        <small class="text-muted">
                            3-50 characters, letters, numbers, and underscores only
                        </small>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-bold"></label>
                        <div class="input-group">
                            <span class="input-group-text">🔒</span>
                            <input asp-for="Password" class="form-control" type="password" placeholder="Choose a strong password" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                        <small class="text-muted">Minimum 6 characters</small>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="form-label fw-bold"></label>
                        <div class="input-group">
                            <span class="input-group-text">🔒</span>
                            <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="Re-enter your password" />
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <div class="d-grid mt-4">
                        <button type="submit" class="btn btn-success btn-lg">
                            <strong>Complete Registration</strong>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelector('input[name="SecondaryPhone"]')
            ?.addEventListener('input', function () {
                this.value = this.value.replace(/[^0-9]/g, '');
            });
    </script>
}
