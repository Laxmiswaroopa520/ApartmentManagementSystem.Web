@{
    ViewData["Title"] = "Invitation History";
    Layout = "_Layout";
}

<style>
    :root {
        --gradient-primary: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.08);
    }

    body {
        background: #f5f7fa;
    }

    .history-card {
        background: white;
        border-radius: 16px;
        box-shadow: var(--shadow-sm);
        overflow: hidden;
        max-width: 900px;
        margin: 3rem auto;
    }

    .card-header-gradient {
        background: var(--gradient-primary);
        color: white;
        padding: 1.25rem 1.5rem;
        font-weight: 600;
        font-size: 1.25rem;
    }

        .card-header-gradient i {
            margin-right: 0.5rem;
        }

    .alert-custom {
        border-radius: 12px;
        border: none;
        padding: 1.25rem;
        background: #e6f7ff;
        border-left: 4px solid #4facfe;
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

        .alert-custom i {
            font-size: 1.5rem;
            color: #4facfe;
        }

    .btn-primary-gradient {
        background: var(--gradient-primary);
        border: none;
        color: white;
        border-radius: 12px;
        padding: 0.75rem 1.5rem;
        font-weight: 600;
        box-shadow: 0 4px 12px rgba(102, 126, 234, 0.3);
        transition: all 0.3s ease;
    }

        .btn-primary-gradient:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(102, 126, 234, 0.4);
        }

    @@media (max-width: 768px) {
        .history-card {
            margin: 1rem;
        }
    }
</style>

<div class="container mt-4">
    <div class="history-card">
        <div class="card-header-gradient">
            📜 Invitation History
        </div>
        <div class="card-body" style="padding: 2rem;">
            <div class="alert-custom">
                <i class="bi bi-info-circle-fill"></i>
                <div>
                    <strong>Coming in Phase 2:</strong> View all sent invitations and their status
                </div>
            </div>
            <a asp-action="Create" class="btn btn-primary-gradient">
                <i class="bi bi-person-plus"></i> Send New Invitation
            </a>
        </div>
    </div>
</div>


