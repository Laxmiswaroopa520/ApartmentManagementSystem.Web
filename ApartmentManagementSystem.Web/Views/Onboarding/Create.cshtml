@model ApartmentManagementSystem.Web.ViewModels.Onboarding.CreateInviteViewModel
@{
    ViewData["Title"] = "Onboard New Resident";
    Layout = "_Layout";
}

<style>
    :root {
        --gradient-primary: linear-gradient(135deg, #5a6fd8 0%, #6b4299 100%);
        --gradient-success: linear-gradient(135deg, #0e8f7d 0%, #2fd98e 100%);
        --shadow-lg: 0 8px 24px rgba(0, 0, 0, 0.12);
        --shadow-xl: 0 20px 60px rgba(0, 0, 0, 0.15);
    }

    body {
        background: #f0f2f5;
    }

    .page-container {
        min-height: calc(100vh - 120px);
        padding: 2rem 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .invite-card {
        background: white;
        border-radius: 20px;
        box-shadow: var(--shadow-xl);
        overflow: hidden;
        max-width: 550px;
        width: 100%;
        margin: 1rem auto;
        animation: slideUp 0.6s ease-out;
    }

    @@keyframes slideUp {
        from

    {
        opacity: 0;
        transform: translateY(30px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    .card-header-gradient {
        background: var(--gradient-primary);
        color: white;
        padding: 1.5rem;
        text-align: center;
        position: relative;
        overflow: hidden;
    }

        .card-header-gradient::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255,255,255,0.12) 0%, transparent 70%);
            animation: rotate 20s linear infinite;
        }

    @@keyframes rotate {
        from

    {
        transform: rotate(0deg);
    }

    to {
        transform: rotate(360deg);
    }

    }

    .card-header-gradient h3 {
        margin: 0;
        font-weight: 700;
        font-size: 1.4rem;
        position: relative;
        z-index: 1;
    }

        .card-header-gradient h3 i {
            font-size: 1.3rem;
            margin-right: 0.5rem;
        }

    .card-header-gradient .subtitle {
        margin-top: 0.5rem;
        opacity: 0.9;
        font-size: 0.85rem;
        position: relative;
        z-index: 1;
    }

    .card-body-custom {
        padding: 2rem;
    }

    .form-label {
        font-weight: 600;
        color: #2d3748;
        margin-bottom: 0.5rem;
        font-size: 0.85rem;
        display: flex;
        align-items: center;
        gap: 0.35rem;
    }

        .form-label i {
            color: #5a6fd8;
            font-size: 0.85rem;
        }

        .form-label .required {
            color: #e85d5d;
            font-size: 1rem;
        }

    .form-control, .form-select {
        border: 2px solid #e2e8f0;
        border-radius: 10px;
        padding: 0.75rem 1rem;
        transition: all 0.3s ease;
        font-size: 0.9rem;
    }

        .form-control:focus, .form-select:focus {
            border-color: #5a6fd8;
            box-shadow: 0 0 0 4px rgba(90, 111, 216, 0.1);
            outline: none;
        }

        .form-control.is-invalid, .form-select.is-invalid {
            border-color: #e85d5d;
        }

        .form-control.is-valid, .form-select.is-valid {
            border-color: #38c96b;
        }

    .text-danger {
        font-size: 0.8rem;
        margin-top: 0.35rem;
        display: flex;
        align-items: center;
        gap: 0.25rem;
        color: #e85d5d;
    }

        .text-danger i {
            font-size: 0.75rem;
        }

    .help-text {
        font-size: 0.8rem;
        color: #718096;
        margin-top: 0.35rem;
        display: flex;
        align-items: center;
        gap: 0.25rem;
    }

        .help-text i {
            font-size: 0.75rem;
        }

    .btn-submit {
        background: var(--gradient-primary);
        border: none;
        color: white;
        border-radius: 10px;
        padding: 0.85rem 1.75rem;
        font-weight: 600;
        font-size: 0.95rem;
        width: 100%;
        box-shadow: 0 4px 14px rgba(90, 111, 216, 0.3);
        transition: all 0.3s ease;
        margin-top: 1rem;
        position: relative;
        overflow: hidden;
    }

        .btn-submit::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
            transition: left 0.5s ease;
        }

        .btn-submit:hover::before {
            left: 100%;
        }

        .btn-submit:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(90, 111, 216, 0.4);
            color: white;
        }

        .btn-submit:active {
            transform: translateY(0);
        }

    .btn-cancel {
        background: white;
        border: 2px solid #e2e8f0;
        color: #4a5568;
        border-radius: 10px;
        padding: 0.85rem 1.75rem;
        font-weight: 600;
        width: 100%;
        transition: all 0.3s ease;
        margin-top: 0.75rem;
    }

        .btn-cancel:hover {
            border-color: #cbd5e0;
            background: #f7fafc;
            color: #2d3748;
        }

    @@media (max-width: 768px) {
        .page-container

    {
        padding: 1.5rem 0;
    }

    .invite-card {
        margin: 0.75rem;
    }

    .card-body-custom {
        padding: 1.5rem;
    }

    .card-header-gradient {
        padding: 1.25rem;
    }

        .card-header-gradient h3 {
            font-size: 1.25rem;
        }

        .card-header-gradient .subtitle {
            font-size: 0.8rem;
        }

    }

    @@media (max-width: 576px) {
        .page-container

    {
        padding: 1rem 0;
    }

    .invite-card {
        margin: 0.5rem;
    }

    .card-body-custom {
        padding: 1.25rem;
    }

    .btn-submit, .btn-cancel {
        padding: 0.75rem 1.5rem;
    }

    }
</style>

<div class="page-container">
    <div class="container">
        <div class="invite-card">
            <div class="card-header-gradient">
                <h3>
                    <i class="bi bi-person-plus-fill"></i> Onboard New Resident
                </h3>
                <p class="subtitle mb-0">Create an invitation and generate OTP for new residents</p>
            </div>
            <div class="card-body-custom">
                <form asp-action="Create" method="post" id="inviteForm">
                    @Html.AntiForgeryToken()

                    <!-- Full Name -->
                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label">
                            <i class="bi bi-person-fill"></i> Full Name <span class="required">*</span>
                        </label>
                        <input asp-for="FullName" class="form-control" placeholder="Enter resident's full name" required autofocus />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>

                    <!-- Phone Number -->
                    <div class="mb-3">
                        <label asp-for="PrimaryPhone" class="form-label">
                            <i class="bi bi-telephone-fill"></i> Phone Number <span class="required">*</span>
                        </label>
                        <input asp-for="PrimaryPhone" type="tel" class="form-control" placeholder="Enter 10-digit phone number"
                               pattern="[0-9]{10}" maxlength="10" required />
                        <span asp-validation-for="PrimaryPhone" class="text-danger"></span>
                        <div class="help-text">
                            <i class="bi bi-info-circle"></i> 10-digit mobile number for OTP verification
                        </div>
                    </div>

                    <!-- Resident Type -->
                    <div class="mb-4">
                        <label asp-for="ResidentType" class="form-label">
                            <i class="bi bi-tag-fill"></i> Resident Type <span class="required">*</span>
                        </label>
                        <select asp-for="ResidentType" class="form-select" required>
                            <option value="">-- Select Resident Type --</option>
                            @foreach (var type in Model.ResidentTypes)
                            {
                                <option value="@type.Id">@type.Name</option>
                            }
                        </select>
                        <span asp-validation-for="ResidentType" class="text-danger"></span>
                        <div class="help-text">
                            <i class="bi bi-info-circle"></i> Choose whether resident is Owner, Tenant, or Staff
                        </div>
                    </div>

                    <!-- Submit / Cancel buttons -->
                    <button type="submit" class="btn btn-submit">
                        <i class="bi bi-check-circle-fill"></i> Create Invite & Generate OTP
                    </button>
                    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-cancel">
                        <i class="bi bi-x-circle"></i> Cancel
                    </a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const phoneInput = document.querySelector('[name="PrimaryPhone"]');
            const form = document.getElementById('inviteForm');

            // Phone number validation
            phoneInput.addEventListener('input', function(e) {
                // Remove non-numeric characters
                this.value = this.value.replace(/[^0-9]/g, '');

                // Limit to 10 digits
                if (this.value.length > 10) {
                    this.value = this.value.slice(0, 10);
                }

                // Visual feedback
                if (this.value.length === 10) {
                    this.classList.remove('is-invalid');
                    this.classList.add('is-valid');
                } else if (this.value.length > 0) {
                    this.classList.remove('is-valid');
                    this.classList.add('is-invalid');
                } else {
                    this.classList.remove('is-valid', 'is-invalid');
                }
            });

            // Form validation
            form.addEventListener('submit', function(e) {
                let isValid = true;

                // Validate phone number
                if (phoneInput.value.length !== 10) {
                    e.preventDefault();
                    phoneInput.classList.add('is-invalid');
                    phoneInput.focus();
                    isValid = false;
                }

                return isValid;
            });
        });
    </script>
}
























