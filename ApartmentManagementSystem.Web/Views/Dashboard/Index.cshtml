        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: var(--shadow-hover);
        }

        .stat-card .stat-icon {
            font-size: 2rem;
            opacity: 0.20;
            position: absolute;
            right: 1rem;
            top: 50%;
            transform: translateY(-50%);
