@{
    ViewData["Title"] = "Home";
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
}

@section Styles {
    <style>
        /* Hero */
        .hero {
            background: url("https://images.unsplash.com/photo-1560448204-e02f11c3d0e2?w=1600") center/cover no-repeat;
            min-height: 88vh;
            position: relative;
            display: flex;
            align-items: center;
        }

            .hero::after {
                content: "";
                position: absolute;
                inset: 0;
                background: linear-gradient(135deg, rgba(26,39,68,0.75) 0%, rgba(0,0,0,0.4) 100%);
            }

        .hero-content {
            position: relative;
            z-index: 2;
            color: white;
            padding: 3rem 0;
        }

            .hero-content h1 {
                font-size: clamp(2rem, 4.5vw, 3.4rem);
                font-weight: 800;
                line-height: 1.15;
                margin-bottom: 1rem;
            }

            .hero-content p {
                font-size: 1.15rem;
                color: #d1d5db;
                max-width: 480px;
            }

        .btn-hero-primary {
            background: #1a2744;
            color: #fff;
            border: none;
            border-radius: 50px;
            padding: 0.75rem 2rem;
            font-weight: 600;
            font-size: 1rem;
            text-decoration: none;
            transition: all 0.25s;
            display: inline-block;
        }

            .btn-hero-primary:hover {
                background: #243258;
                color: #fff;
                transform: translateY(-2px);
                box-shadow: 0 6px 20px rgba(26,39,68,0.4);
            }

        .btn-hero-outline {
            background: transparent;
            color: #fff;
            border: 2px solid rgba(255,255,255,0.65);
            border-radius: 50px;
            padding: 0.73rem 2rem;
            font-weight: 600;
            font-size: 1rem;
            text-decoration: none;
            transition: all 0.25s;
            display: inline-block;
        }

            .btn-hero-outline:hover {
                background: rgba(255,255,255,0.15);
                border-color: #fff;
                color: #fff;
            }

        /* Section */
        .section {
            padding: 72px 0;
        }

        .section-title {
            font-size: 2rem;
            font-weight: 700;
            color: #1f2933;
            margin-bottom: 2.5rem;
        }

        /* Gallery */
        .gallery img {
            border-radius: 16px;
            width: 100%;
            height: 240px;
            object-fit: cover;
            transition: transform 0.35s ease, box-shadow 0.35s ease;
        }

            .gallery img:hover {
                transform: translateY(-4px);
                box-shadow: 0 12px 32px rgba(0,0,0,0.13);
            }

        /* Info card */
        .info-card {
            background: #ffffff;
            border-radius: 20px;
            padding: 2.5rem;
            box-shadow: 0 4px 24px rgba(0,0,0,0.06);
            border: 1px solid #e5e7eb;
        }

            .info-card h3 {
                font-weight: 700;
                color: #1f2933;
            }

            .info-card .bi {
                color: #7dd3fc;
                font-size: 1.2rem;
                margin-right: 0.4rem;
            }
    </style>
}

<!-- Hero — full width, no extra navbar -->
<section class="hero">
    <div class="container hero-content">
        <div class="col-md-7">
            <h1>Modern Living,<br>Connected Communities</h1>
            <p class="mb-4">Experience peaceful apartment living with smart community management.</p>
            <div class="d-flex gap-3 flex-wrap">
                <a href="/Login/Index" class="btn-hero-primary">Resident Login</a>
                <a href="/VerifyInvite/Index" class="btn-hero-outline">New User</a>
            </div>
        </div>
    </div>
</section>

<!-- Gallery -->
<section class="section">
    <div class="container">
        <h2 class="section-title text-center">Life at Skyline</h2>
        <div class="row g-4 gallery">
            <div class="col-md-4">
                <img src="https://images.unsplash.com/photo-1545324418-cc1a3fa10c00?w=800" alt="Skyline interior">
            </div>
            <div class="col-md-4">
                <img src="https://images.unsplash.com/photo-1560448204-e02f11c3d0e2?w=800" alt="Skyline living room">
            </div>
            <div class="col-md-4">
                <img src="https://images.unsplash.com/photo-1582407947304-fd86f028f716?w=800" alt="Skyline building">
            </div>
        </div>
    </div>
</section>

<!-- About -->
<section class="section" style="padding-top:0">
    <div class="container">
        <h2 class="section-title text-center">About Skyline</h2>

        <div class="about-intro text-center mb-5" style="max-width:640px;margin:0 auto">
            <p class="text-muted" style="font-size:1.05rem;line-height:1.75">
                Skyline is built for modern apartment communities — bringing residents, staff,
                and management together on one calm, powerful platform. We handle the
                complexity so your community can simply thrive.
            </p>
        </div>

        <!-- Feature cards row -->
        <div class="row g-4 mb-5">
            <div class="col-md-4">
                <div class="feat-card">
                    <div class="feat-icon">
                        <i class="bi bi-people-fill"></i>
                    </div>
                    <h5>Community First</h5>
                    <p>Connect residents, staff, and leadership in one shared space. Foster a sense of belonging across every floor.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feat-card">
                    <div class="feat-icon">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <h5>Secure & Trusted</h5>
                    <p>Role-based access, invite-only onboarding, and audit-ready records keep your community safe and accountable.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feat-card">
                    <div class="feat-icon">
                        <i class="bi bi-bar-chart-line-fill"></i>
                    </div>
                    <h5>Smart Management</h5>
                    <p>From flat occupancy to visitor logs, get a real-time dashboard that gives you clarity at a glance — every day.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feat-card">
                    <div class="feat-icon">
                        <i class="bi bi-tools"></i>
                    </div>
                    <h5>Maintenance Tracking</h5>
                    <p>Residents raise complaints, staff resolve them. Every issue is logged, tracked, and closed — nothing falls through.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feat-card">
                    <div class="feat-icon">
                        <i class="bi bi-building-check"></i>
                    </div>
                    <h5>Multi-Building Ready</h5>
                    <p>Manage multiple apartment buildings under one account. Create, visualise, and organise properties with ease.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feat-card">
                    <div class="feat-icon">
                        <i class="bi bi-person-badge"></i>
                    </div>
                    <h5>Staff & Roles</h5>
                    <p>Assign presidents, secretaries, treasurers, and security — each with the right access and nothing more.</p>
                </div>
            </div>
        </div>

        <!-- Stats strip -->
        <div class="stats-strip">
            <div class="stat-item">
                <span class="stat-num">500+</span>
                <span class="stat-desc">Flats Managed</span>
            </div>
            <div class="stat-divider"></div>
            <div class="stat-item">
                <span class="stat-num">12+</span>
                <span class="stat-desc">Communities</span>
            </div>
            <div class="stat-divider"></div>
            <div class="stat-item">
                <span class="stat-num">98%</span>
                <span class="stat-desc">Resident Satisfaction</span>
            </div>
            <div class="stat-divider"></div>
            <div class="stat-item">
                <span class="stat-num">24/7</span>
                <span class="stat-desc">Platform Uptime</span>
            </div>
        </div>
    </div>
</section>

<!-- Contact -->
<section class="section" style="padding-top: 0; padding-bottom: 80px">
    <div class="container">
        <h2 class="section-title text-center">Get in Touch</h2>
        <div class="row g-4 justify-content-center">
            <div class="col-md-4">
                <div class="contact-card">
                    <div class="contact-icon"><i class="bi bi-envelope-fill"></i></div>
                    <h6>Email Us</h6>
                    <p>support@@skylinecommunities.com</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="contact-card">
                    <div class="contact-icon"><i class="bi bi-telephone-fill"></i></div>
                    <h6>Call Us</h6>
                    <p>+1 555 234 6789</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="contact-card">
                    <div class="contact-icon"><i class="bi bi-geo-alt-fill"></i></div>
                    <h6>Head Office</h6>
                    <p>42 Skyline Avenue, Metro City</p>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    /* Feature cards */
    .feat-card {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 18px;
        padding: 2rem 1.75rem;
        height: 100%;
        transition: transform 0.28s ease, box-shadow 0.28s ease, border-color 0.28s ease;
    }

        .feat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 32px rgba(26,39,68,0.1);
            border-color: #bfdbfe;
        }

    .feat-icon {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        background: #eff6ff;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1.1rem;
    }

        .feat-icon i {
            font-size: 1.4rem;
            color: #1a2744;
        }

    .feat-card h5 {
        font-weight: 700;
        color: #1f2933;
        margin-bottom: 0.6rem;
        font-size: 1rem;
    }

    .feat-card p {
        color: #6b7280;
        font-size: 0.9rem;
        line-height: 1.65;
        margin: 0;
    }

    /* Stats strip */
    .stats-strip {
        background: #1a2744;
        border-radius: 20px;
        padding: 2.25rem 2rem;
        display: flex;
        align-items: center;
        justify-content: space-around;
        flex-wrap: wrap;
        gap: 1.5rem;
    }

    .stat-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.25rem;
    }

    .stat-num {
        font-size: 2.2rem;
        font-weight: 800;
        color: #7dd3fc;
        line-height: 1;
    }

    .stat-desc {
        font-size: 0.85rem;
        color: #94a3b8;
        font-weight: 500;
    }

    .stat-divider {
        width: 1px;
        height: 48px;
        background: rgba(255,255,255,0.12);
    }

    /* Contact cards */
    .contact-card {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 18px;
        padding: 2rem 1.5rem;
        text-align: center;
        transition: transform 0.25s, box-shadow 0.25s;
    }

        .contact-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 28px rgba(26,39,68,0.09);
        }

    .contact-icon {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        background: #eff6ff;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1rem;
    }

        .contact-icon i {
            font-size: 1.35rem;
            color: #1a2744;
        }

    .contact-card h6 {
        font-weight: 700;
        color: #1f2933;
        margin-bottom: 0.4rem;
    }

    .contact-card p {
        color: #6b7280;
        font-size: 0.9rem;
        margin: 0;
    }

    @@media (max-width: 768px) {
        .stat-divider {
            display: none;
        }

        .stats-strip {
            justify-content: center;
            gap: 2rem;
        }
    }
</style>


