@model ApartmentManagementSystem.Web.ViewModels.Auth.LoginViewModel
@{
    ViewData["Title"] = "Login";
    Layout = "_PublicLayout";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<style>
    body {
        background: #f2f3f5;
    }

    .login-wrapper {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .login-card {
        width: 100%;
        max-width: 1000px;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 30px 60px rgba(0,0,0,0.15);
        background: white;
    }

    /* LEFT IMAGE */
    .login-image {
        background: url("https://images.unsplash.com/photo-1501183638710-841dd1904471?w=1200") center/cover no-repeat;
        position: relative;
    }

        .login-image::after {
            content: "";
            position: absolute;
            inset: 0;
            background: rgba(0,0,0,0.55);
        }

    .login-image-content {
        position: relative;
        z-index: 2;
        color: #fff;
        padding: 3rem;
    }

        .login-image-content h1 {
            font-weight: 700;
            font-size: 2.4rem;
        }

        .login-image-content p {
            opacity: 0.85;
            max-width: 400px;
        }

    /* RIGHT FORM */
    .login-form {
        padding: 3rem;
    }

        .login-form h2 {
            font-weight: 600;
        }

    .form-control {
        height: 46px;
        border-radius: 10px;
    }

    .btn-login {
        background: #1f2933;
        color: white;
        border-radius: 30px;
        height: 46px;
        font-weight: 600;
    }

        .btn-login:hover {
            background: #111827;
        }

    .link-muted {
        color: #6b7280;
        text-decoration: none;
    }

        .link-muted:hover {
            text-decoration: underline;
        }

    @@media(max - width: 768px)

    {
        .login-image {
            display: none;
        }
    }
</style>

<div class="login-wrapper">
    <div class="login-card row g-0">

        <!-- LEFT IMAGE -->
        <div class="col-md-6 login-image">
            <div class="login-image-content">
                <h1>Apartment Management</h1>
                <p>
                    Manage residents, billing, maintenance and community life
                    from one peaceful, secure platform.
                </p>
            </div>
        </div>

        <!-- RIGHT FORM -->
        <div class="col-md-6">
            <div class="login-form">

             <!--   <a href="/Home/Index" class="link-muted mb-4 d-inline-block">
                    ← Back to Home
                </a>-->

                <h2 class="mb-1">Welcome back</h2>
                <p class="text-muted mb-4">Sign in to continue</p>

                <form asp-action="Index" method="post">
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Username" class="form-label">Username</label>
                        <input asp-for="Username" class="form-control" placeholder="Enter username" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">Password</label>
                        <input asp-for="Password" type="password" class="form-control" placeholder="Enter password" />
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label">
                            Remember me
                        </label>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-login">
                            Sign In
                        </button>
                    </div>
                </form>

                <div class="text-center mt-4">
                    <a asp-controller="VerifyInvite"
                       asp-action="Index"
                       class="link-muted">
                        Have an invitation?
                    </a>
                </div>

                

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}













