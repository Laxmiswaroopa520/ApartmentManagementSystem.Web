    /* Financial Card */
    .financial-card {
        background: linear-gradient(135deg, #5a6fd8 0%, #6b4299 100%);
        border-radius: 16px;
        color: white;
        padding: 1.5rem;
        box-shadow: var(--shadow-lg);
    }

    .financial-stat {
        text-align: center;
        padding: 1rem;
        background: rgba(255, 255, 255, 0.12);
        border-radius: 12px;
        backdrop-filter: blur(10px);
    }

        .financial-stat h6 {
            font-size: 0.8rem;
            opacity: 0.85;
            margin-bottom: 0.5rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .financial-stat h3 {
            font-size: 1.8rem;
            font-weight: 700;
            margin: 0;
        }

    /* Table Styling */
    .table-hover tbody tr {
        transition: all 0.3s ease;
    }

        .table-hover tbody tr:hover {
            background-color: var(--bg-main);
            transform: scale(1.01);
        }

    /* Responsive */
    @@media (max-width: 768px) {
        .stat-card h2

    {
        font-size: 1.5rem;
    }

    .stat-card .stat-icon {
        font-size: 1.6rem;
    }

    .module-card .module-icon {
        font-size: 2.5rem;
    }

    .dashboard-header h2 {
        font-size: 1.5rem;
    }

    }

    @@media (max-width: 576px) {
        .role-badge

    {
        font-size: 0.75rem;
        padding: 0.3rem 0.7rem;
    }

    .btn-action {
        padding: 0.6rem 1rem;
        font-size: 0.9rem;
    }

    .card-body {
        padding: 1rem;
    }

    .stat-card {
        padding: 1rem;
    }

    .module-card {
        padding: 1.5rem 1.25rem;
    }

    }
</style>

<div class="container-fluid mt-4">
    <!-- Welcome Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="dashboard-header">
                <h2 class="mb-2">
                    <i class="bi bi-speedometer2"></i> Welcome, @Model.FullName! 👋
                </h2>
                <p class="text-muted mb-0">
                    @if (Model.AllRoles.Any())
                    {
                        <span>Roles: </span>
                        @foreach (var role in Model.AllRoles)
                        {
                            <span class="role-badge">@role</span>
                        }
                    }
                    else
                    {
                        <span>Role: <span class="role-badge">@Model.Role</span></span>
                    }
                </p>
            </div>
        </div>
    </div>


    <!-- Quick Actions Card -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-lightning-charge"></i> Quick Actions</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        @if (User.IsInRole("SuperAdmin"))
                        {
                            <div class="col-lg-3 col-md-6">
                                <a asp-controller="ApartmentBuilder" asp-action="ManageApartments"
                                   class="btn btn-action btn-primary w-100">
                                    <i class="bi bi-buildings"></i> My Apartments
                                </a>
                            </div>
                            <div class="col-lg-3 col-md-6">
                                <a asp-controller="ApartmentBuilder" asp-action="Create"
                                   class="btn btn-action btn-secondary w-100">
                                    <i class="bi bi-building-add"></i> Create Apartment
                                </a>
                            </div>
                        }

                        <div class="col-lg-3 col-md-6">
                            <a asp-controller="Onboarding" asp-action="Create" class="btn btn-action btn-success w-100">
                                <i class="bi bi-person-plus"></i> Onboard Resident
                            </a>
                        </div>

                        <!-- ⭐ COMMUNITY MEMBERS WITH APARTMENT SELECTOR -->
                        <div class="col-lg-3 col-md-6">
                            <button class="btn btn-action btn-info w-100" onclick="showApartmentSelector()">
                                <i class="bi bi-award"></i> Community Members
                            </button>
                        </div>

                        <div class="col-lg-3 col-md-6">
                            <a asp-controller="StaffMembers" asp-action="Index" class="btn btn-action btn-warning w-100">
                                <i class="bi bi-person-badge"></i> Staff Members
                            </a>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <a asp-controller="ResidentManagement" asp-action="Index" class="btn btn-action btn-primary w-100">
                                <i class="bi bi-house-door"></i> All Residents
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <!-- Apartment Portfolio (SuperAdmin Only) -->
    @if (User.IsInRole("SuperAdmin") && Model.Stats.TotalApartments.HasValue)
    {
        <div class="row mb-4">
            <div class="col-12">
                <div class="card portfolio-card">
                    <div class="card-header">
                        <h5 class="mb-0">
                            <i class="bi bi-buildings-fill"></i> Apartment Portfolio Overview
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-lg-3 col-md-6">
                                <div class="portfolio-stat-card">
                                    <i class="bi bi-building"></i>
                                    <h2>@Model.Stats.TotalApartments</h2>
                                    <p class="mb-0 small">Total Apartments</p>
                                </div>
                            </div>
                            <div class="col-lg-3 col-md-6">
                                <div class="portfolio-stat-card">
                                    <i class="bi bi-check-circle"></i>
                                    <h2>@Model.Stats.ActiveApartments</h2>
                                    <p class="mb-0 small">Active Buildings</p>
                                </div>
                            </div>
                            <div class="col-lg-3 col-md-6">
                                <div class="portfolio-stat-card">
                                    <i class="bi bi-layers"></i>
                                    <h2>@Model.Stats.TotalFloors</h2>
                                    <p class="mb-0 small">Total Floors</p>
                                </div>
                            </div>
                            <div class="col-lg-3 col-md-6">
                                <div class="portfolio-stat-card">
                                    <i class="bi bi-person-badge"></i>
                                    <h2>@Model.Stats.TotalManagers</h2>
                                    <p class="mb-0 small">Assigned Managers</p>
                                </div>
                            </div>
                        </div>
                        <div class="text-center mt-3">
                            <a asp-controller="ApartmentBuilder" asp-action="ManageApartments"
                               class="btn btn-light" style="border-radius: 10px; font-weight: 600; padding: 0.6rem 1.5rem;">
                                <i class="bi bi-gear-fill"></i> Manage All Apartments
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Statistics Cards Row 1 - 3 per row -->
    <div class="row g-3 mb-4">
        <div class="col-lg-4 col-md-6">
            <div class="stat-card stat-primary">
                <div class="position-relative">
                    <h6>Total Residents</h6>
                    <h2>@Model.Stats.TotalResidents</h2>
                    <small>Active users in system</small>
                </div>
                <i class="bi bi-people-fill stat-icon"></i>
            </div>
        </div>

        <div class="col-lg-4 col-md-6">
            <div class="stat-card stat-orange">
                <div class="position-relative">
                    <h6>Pending Registrations</h6>
                    <h2>@Model.Stats.PendingRegistrations</h2>
                    <a asp-controller="AdminResidents" asp-action="Pending" class="btn btn-light btn-sm mt-2" style="border-radius: 8px; font-size: 0.8rem; padding: 0.4rem 0.8rem;">
                        <i class="bi bi-eye"></i> View Pending
                    </a>
                </div>
                <i class="bi bi-hourglass-split stat-icon"></i>
            </div>
        </div>

        <div class="col-lg-4 col-md-6">
            <div class="stat-card stat-green">
                <div class="position-relative">
                    <h6>Total Flats</h6>
                    <h2>@Model.Stats.TotalFlats</h2>
                    <small>@Model.Stats.OccupiedFlats Occupied</small>
                </div>
                <i class="bi bi-building stat-icon"></i>
            </div>
        </div>
    </div>

    <!-- Statistics Cards Row 2 - 3 per row -->
    <div class="row g-3 mb-4">
        <div class="col-lg-4 col-md-6">
            <div class="stat-card stat-blue">
                <div class="position-relative">
                    <h6>Vacant Flats</h6>
                    <h2>@Model.Stats.VacantFlats</h2>
                    <small>Available for assignment</small>
                </div>
                <i class="bi bi-house stat-icon"></i>
            </div>
        </div>

        <div class="col-lg-4 col-md-6">
            <div class="stat-card stat-purple">
                <div class="position-relative">
                    <h6>Staff Members</h6>
                    <h2>@Model.Stats.TotalStaffMembers</h2>
                    <small>@Model.Stats.ActiveStaffMembers Active</small>
                </div>
                <i class="bi bi-person-badge-fill stat-icon"></i>
            </div>
        </div>

        <div class="col-lg-4 col-md-6">
            <div class="stat-card stat-teal">
                <div class="position-relative">
                    <h6>Community Members</h6>
                    <h2>@Model.Stats.CommunityMembers</h2>
                    <small>President, Secretary, Treasurer</small>
                </div>
                <i class="bi bi-award-fill stat-icon"></i>
            </div>
        </div>
    </div>

    <!-- Statistics Cards Row 3 - 3 per row -->
    <div class="row g-3 mb-4">
        <div class="col-lg-4 col-md-6">
            <div class="stat-card stat-sunset">
                <div class="position-relative">
                    <h6>Pending Complaints</h6>
                    <h2>@Model.Stats.PendingComplaints</h2>
                    <small>Resolved: @Model.Stats.ResolvedComplaintsThisMonth</small>
                </div>
                <i class="bi bi-exclamation-triangle-fill stat-icon"></i>
            </div>
        </div>

        <div class="col-lg-4 col-md-6">
            <div class="stat-card stat-blue">
                <div class="position-relative">
                    <h6>Today's Visitors</h6>
                    <h2>@Model.Stats.TodaysVisitors</h2>
                    <small>Security: @Model.Stats.ActiveSecurityPersonnel</small>
                </div>
                <i class="bi bi-door-open-fill stat-icon"></i>
            </div>
        </div>
    </div>

    <!-- Financial Summary -->
    @if ((User.IsInRole("SuperAdmin") || User.IsInRole("Treasurer")) && Model.FinancialSummary != null)
    {
        <div class="row mb-4">
            <div class="col-12">
                <div class="financial-card">
                    <h5 class="mb-3"><i class="bi bi-currency-rupee"></i> Financial Summary</h5>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="financial-stat">
                                <h6>Total Outstanding</h6>
                                <h3>₹@Model.FinancialSummary.TotalOutstanding.ToString("N2")</h3>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="financial-stat">
                                <h6>Collection This Month</h6>
                                <h3>₹@Model.FinancialSummary.CollectionThisMonth.ToString("N2")</h3>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="financial-stat d-flex align-items-center justify-content-center">
                                <a href="#" class="btn btn-light" style="border-radius: 10px; font-weight: 600;">
                                    <i class="bi bi-graph-up"></i> View Reports
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Module Cards - Removed Apartment Management -->
    <div class="row g-3 mb-4">
        <div class="col-lg-4 col-md-6">
            <div class="module-card module-orange">
                <div class="module-icon"><i class="bi bi-clipboard-check"></i></div>
                <h5>Complaints Management</h5>
                <h3>@Model.Stats.PendingComplaints</h3>
                <p>Track and resolve resident complaints</p>
                <hr />
                <small>Coming in Phase 5</small>
            </div>
        </div>

        <div class="col-lg-4 col-md-6">
            <div class="module-card module-blue">
                <div class="module-icon"><i class="bi bi-receipt"></i></div>
                <h5>Billing & Payments</h5>
                <h3>₹@Model.Stats.TotalOutstandingBills.ToString("N0")</h3>
                <p>Manage maintenance & utility bills</p>
                <hr />
                <small>Coming in Phase 6</small>
            </div>
        </div>

        <div class="col-lg-4 col-md-6">
            <div class="module-card module-green">
                <div class="module-icon"><i class="bi bi-calendar-event"></i></div>
                <h5>Visitor Management</h5>
                <h3>@Model.Stats.TodaysVisitors</h3>
                <p>Track visitors and deliveries</p>
                <hr />
                <small>Coming in Phase 7</small>
            </div>
        </div>
    </div>

    <!-- Recent Activities -->
    @if (Model.RecentActivities != null && Model.RecentActivities.Any())
    {
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header" style="background: linear-gradient(135deg, #5a6fd8 0%, #6b4299 100%) !important;">
                        <h5 class="mb-0"><i class="bi bi-clock-history"></i> Recent Activities</h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Activity</th>
                                        <th>Type</th>
                                        <th>Timestamp</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var activity in Model.RecentActivities.Take(10))
                                    {
                                        <tr>
                                            <td>@activity.Activity</td>
                                            <td>
                                                <span class="role-badge" style="font-size: 0.75rem; padding: 0.25rem 0.65rem;">@activity.Type</span>
                                            </td>
                                            <td class="text-muted small">@activity.Timestamp.ToString("MMM dd, yyyy hh:mm tt")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>


@section Scripts {
    <script>
        async function showApartmentSelector() {
            try {
                const response = await fetch('/api/ApartmentManagement/all');
                const data = await response.json();

                if (data && data.success && data.data && data.data.length > 0) {
                    const apartments = data.data;

                    const modalHtml = `
                        <div class="modal fade" id="apartmentSelectorModal" tabindex="-1">
                            <div class="modal-dialog">
                                <div class="modal-content" style="background: #1a1f3a; color: white; border: 1px solid #5a6fd8;">
                                    <div class="modal-header" style="border-bottom: 1px solid #2d3748;">
                                        <h5 class="modal-title">
                                            <i class="bi bi-building"></i> Select Apartment
                                        </h5>
                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                    </div>
                                    <div class="modal-body">
                                        <label class="form-label fw-bold">Choose apartment to manage community members:</label>
                                        <select class="form-select" id="apartmentSelect" style="background: #0a0e27; color: white; border: 1px solid #2d3748; padding: 12px; border-radius: 8px;">
                                            <option value="">-- Select Apartment --</option>
                                            ${apartments.map(apt => `<option value="${apt.id}">${apt.name}</option>`).join('')}
                                        </select>
                                    </div>
                                    <div class="modal-footer" style="border-top: 1px solid #2d3748;">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                        <button type="button" class="btn btn-primary" onclick="goToCommunityMembers()">Continue</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    `;

                    const old = document.getElementById('apartmentSelectorModal');
                    if (old) old.remove();

                    document.body.insertAdjacentHTML('beforeend', modalHtml);
                    const modal = new bootstrap.Modal(document.getElementById('apartmentSelectorModal'));
                    modal.show();
                } else {
                    alert('No apartments found. Please create an apartment first.');
                }
            } catch (err) {
                console.error(err);
                alert('Failed to load apartments');
            }
        }

        function goToCommunityMembers() {
            const select = document.getElementById('apartmentSelect');
            const apartmentId = select.value;

            if (!apartmentId) {
                alert('Please select an apartment');
                return;
            }

            window.location.href = `/Community/Index?apartmentId=${apartmentId}`;
        }
    </script>
}
*@
















