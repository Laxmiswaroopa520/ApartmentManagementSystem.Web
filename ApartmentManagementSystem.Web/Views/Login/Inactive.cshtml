@{
    ViewData["Title"] = "Account Inactive - Skyline";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Account Inactive - Skyline</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">

    <style>
        :root {
            --primary-color: #4f6d7a;
            --primary-dark: #3d5561;
            --accent-orange: #c97e5d;
            --bg-main: #f5f6f7;
            --text-dark: #1f2933;
            --text-muted: #6b7280;
            --shadow-lg: 0 10px 30px rgba(0,0,0,0.15);
        }

        body {
            background: var(--bg-main);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            padding: 2rem 1rem;
        }

        .inactive-container {
            max-width: 600px;
            width: 100%;
        }

        .inactive-card {
            background: white;
            border-radius: 20px;
            box-shadow: var(--shadow-lg);
            overflow: hidden;
            animation: slideUp 0.5s ease-out;
        }

        @@keyframes slideUp {
            from

        {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

        }

        .inactive-header {
            background: var(--accent-orange);
            color: white;
            padding: 2rem;
            text-align: center;
        }

            .inactive-header .icon {
                width: 80px;
                height: 80px;
                background: rgba(255, 255, 255, 0.2);
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                margin: 0 auto 1.5rem;
                animation: pulse 2s ease-in-out infinite;
            }

        @@keyframes pulse {
            0%, 100%

        {
            transform: scale(1);
        }

        50% {
            transform: scale(1.05);
        }

        }

        .inactive-header .icon i {
            font-size: 2.5rem;
        }

        .inactive-header h2 {
            font-weight: 700;
            margin-bottom: 0.5rem;
            font-size: 2rem;
        }

        .inactive-header p {
            opacity: 0.95;
            margin: 0;
            font-size: 1.05rem;
        }

        .inactive-body {
            padding: 2.5rem 2rem;
            text-align: center;
        }

            .inactive-body h5 {
                color: var(--text-dark);
                font-weight: 700;
                margin-bottom: 1rem;
            }

            .inactive-body p {
                color: var(--text-muted);
                line-height: 1.6;
                margin-bottom: 2rem;
                font-size: 1.05rem;
            }

        .status-badge {
            background: #fff4e6;
            border: 2px solid var(--accent-orange);
            border-radius: 10px;
            padding: 1rem 1.5rem;
            margin-bottom: 2rem;
            display: inline-block;
        }

            .status-badge strong {
                color: var(--accent-orange);
                font-size: 1.1rem;
            }

        .btn-primary-custom {
            background: var(--primary-color);
            color: white;
            border: none;
            padding: 0.85rem 2.5rem;
            border-radius: 10px;
            font-weight: 600;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-block;
        }

            .btn-primary-custom:hover {
                background: var(--primary-dark);
                transform: translateY(-2px);
                box-shadow: 0 4px 12px rgba(79, 109, 122, 0.3);
                color: white;
            }

        .contact-box {
            background: var(--bg-main);
            border-radius: 12px;
            padding: 1.5rem;
            margin-top: 1.5rem;
            border-left: 4px solid var(--primary-color);
            text-align: left;
        }

            .contact-box h6 {
                color: var(--text-dark);
                font-weight: 700;
                margin-bottom: 1rem;
            }

        .contact-item {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            margin-bottom: 0.75rem;
            color: var(--text-dark);
        }

            .contact-item:last-child {
                margin-bottom: 0;
            }

            .contact-item i {
                color: var(--primary-color);
                font-size: 1.2rem;
                width: 24px;
                text-align: center;
            }

        @@media (max-width: 576px) {
            .inactive-header

        {
            padding: 1.5rem;
        }

        .inactive-header h2 {
            font-size: 1.5rem;
        }

        .inactive-header .icon {
            width: 60px;
            height: 60px;
            margin-bottom: 1rem;
        }

            .inactive-header .icon i {
                font-size: 2rem;
            }

        .inactive-body {
            padding: 2rem 1.5rem;
        }

        .btn-primary-custom {
            padding: 0.75rem 2rem;
            width: 100%;
        }

        .contact-box {
            padding: 1.25rem;
        }

        }
    </style>
</head>
<body>
    <div class="inactive-container">
        <div class="inactive-card">
            <div class="inactive-header">
                <div class="icon">
                    <i class="bi bi-lock-fill"></i>
                </div>
                <h2>Account Inactive</h2>
                <p>Your account has been temporarily deactivated</p>
            </div>

            <div class="inactive-body">
                <div class="status-badge">
                    <strong><i class="bi bi-exclamation-triangle-fill"></i> Account Status: Deactivated</strong>
                </div>

                <h5>Unable to Access Your Account</h5>
                <p>
                    Your account has been deactivated by the system administrator.
                    This may be temporary or require administrator intervention to reactivate.
                </p>

                <a asp-controller="Login" asp-action="Index" class="btn-primary-custom">
                    <i class="bi bi-box-arrow-in-left"></i> Back to Login
                </a>

                <div class="contact-box">
                    <h6><i class="bi bi-headset"></i> Need Assistance?</h6>
                    <div class="contact-item">
                        <i class="bi bi-envelope-fill"></i>
                        <span>support@skylinecommunities.com</span>
                    </div>
                    <div class="contact-item">
                        <i class="bi bi-telephone-fill"></i>
                        <span>+1 555 234 6789</span>
                    </div>
                    <div class="contact-item">
                        <i class="bi bi-clock-fill"></i>
                        <span>Monday - Friday, 9:00 AM - 6:00 PM</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>


