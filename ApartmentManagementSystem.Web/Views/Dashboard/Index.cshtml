@model ApartmentManagementSystem.Web.ViewModels.Dashboard.EnhancedDashboardViewModel
@{
    ViewData["Title"] = "Dashboard - Skyline";
    Layout = "_Layout";
}

<style>
    :root {
        --primary-color: #4f6d7a;
        --gradient-primary: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        --gradient-blue: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
        --gradient-green: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
        --gradient-orange: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
        --gradient-purple: linear-gradient(135deg, #a8c0ff 0%, #3f2b96 100%);
        --gradient-teal: linear-gradient(135deg, #0ba360 0%, #3cba92 100%);
        --gradient-sunset: linear-gradient(135deg, #ff6b6b 0%, #feca57 100%);
        --bg-main: #f5f6f7;
        --bg-card: #ffffff;
        --text-dark: #1f2933;
        --text-muted: #6b7280;
        --shadow-sm: 0 2px 8px rgba(0,0,0,0.08);
        --shadow-md: 0 4px 16px rgba(0,0,0,0.12);
        --shadow-lg: 0 8px 24px rgba(0,0,0,0.15);
        --shadow-hover: 0 12px 32px rgba(0,0,0,0.18);
    }

    body {
        background: var(--bg-main);
    }

    .dashboard-header h2 {
        font-weight: 700;
        color: var(--text-dark);
        font-size: 1.8rem;
    }

    .role-badge {
        background: var(--gradient-primary);
        color: white;
        padding: 0.35rem 0.9rem;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 600;
        display: inline-block;
        margin-right: 0.4rem;
        box-shadow: 0 2px 8px rgba(102, 126, 234, 0.3);
    }

    /* Cards */
    .card {
        border: none;
        border-radius: 16px;
        background: var(--bg-card);
        box-shadow: var(--shadow-sm);
        transition: all 0.3s ease;
    }

        .card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-hover);
        }

    .card-header {
        border: none;
        border-radius: 16px 16px 0 0 !important;
        padding: 1rem 1.25rem;
        font-weight: 600;
        background: var(--primary-color) !important;
        color: white !important;
    }

    .card-body {
        padding: 1.25rem;
    }

    /* Compact Stat Cards */
    .stat-card {
        border-radius: 14px;
        padding: 1.25rem;
        color: white;
        box-shadow: var(--shadow-md);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        height: 100%;
        position: relative;
        overflow: hidden;
    }

        .stat-card::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, transparent 70%);
            transition: transform 0.6s ease;
        }

        .stat-card:hover::before {
            transform: translate(10%, 10%);
        }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: var(--shadow-hover);
        }

        .stat-card .stat-icon {
            font-size: 2rem;
            opacity: 0.25;
            position: absolute;
            right: 1rem;
            top: 50%;
            transform: translateY(-50%);
        }

        .stat-card h6 {
            text-transform: uppercase;
            font-size: 0.7rem;
            opacity: 0.9;
            font-weight: 600;
            margin-bottom: 0.4rem;
            letter-spacing: 0.5px;
        }

        .stat-card h2 {
            font-size: 1.8rem;
            font-weight: 700;
            margin-bottom: 0.2rem;
        }

        .stat-card small {
            opacity: 0.9;
            font-size: 0.8rem;
        }

        .stat-card.stat-primary {
            background: var(--gradient-primary);
        }

        .stat-card.stat-blue {
            background: var(--gradient-blue);
        }

        .stat-card.stat-green {
            background: var(--gradient-green);
        }

        .stat-card.stat-orange {
            background: var(--gradient-orange);
        }

        .stat-card.stat-purple {
            background: var(--gradient-purple);
        }

        .stat-card.stat-teal {
            background: var(--gradient-teal);
        }

        .stat-card.stat-sunset {
            background: var(--gradient-sunset);
        }

    /* Quick Action Buttons */
    .btn-action {
        padding: 0.7rem 1.25rem;
        border-radius: 10px;
        font-weight: 600;
        transition: all 0.3s ease;
        border: none;
        color: white;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

        .btn-action:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(0,0,0,0.15);
            color: white;
        }

        .btn-action.btn-primary {
            background: var(--gradient-primary);
        }

        .btn-action.btn-success {
            background: var(--gradient-green);
        }

        .btn-action.btn-info {
            background: var(--gradient-blue);
        }

        .btn-action.btn-warning {
            background: var(--gradient-orange);
        }

        .btn-action.btn-secondary {
            background: var(--gradient-purple);
        }

    /* Portfolio Card */
    .portfolio-card {
        background: var(--gradient-primary);
        border-radius: 16px;
        color: white;
        box-shadow: var(--shadow-lg);
    }

        .portfolio-card .card-header {
            background: transparent !important;
            border-bottom: 1px solid rgba(255, 255, 255, 0.2);
        }

    .portfolio-stat-card {
        background: rgba(255, 255, 255, 0.15);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 12px;
        padding: 1.25rem;
        text-align: center;
        transition: all 0.3s ease;
    }

        .portfolio-stat-card:hover {
            background: rgba(255, 255, 255, 0.25);
            transform: translateY(-4px);
        }

        .portfolio-stat-card i {
            font-size: 2rem;
            margin-bottom: 0.75rem;
            display: block;
        }

        .portfolio-stat-card h2 {
            font-size: 2rem;
            margin-bottom: 0.4rem;
            font-weight: 700;
        }

    /* Compact Module Cards */
    .module-card {
        border-radius: 16px;
        color: white;
        text-align: center;
        padding: 1.75rem 1.5rem;
        box-shadow: var(--shadow-md);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        height: 100%;
        position: relative;
        overflow: hidden;
    }

        .module-card::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, transparent 70%);
        }

        .module-card:hover {
            transform: translateY(-6px);
            box-shadow: var(--shadow-hover);
        }

        .module-card .module-icon {
            font-size: 3rem;
            margin-bottom: 1rem;
        }

        .module-card h5 {
            font-weight: 700;
            font-size: 1.1rem;
            margin-bottom: 0.5rem;
        }

        .module-card h3 {
            font-size: 2rem;
            font-weight: 700;
            margin: 0.75rem 0;
        }

        .module-card p {
            font-size: 0.9rem;
            opacity: 0.9;
            margin-bottom: 1rem;
        }

        .module-card hr {
            background: rgba(255, 255, 255, 0.3);
            opacity: 1;
            height: 1px;
            margin: 1rem 0;
        }

        .module-card.module-orange {
            background: var(--gradient-sunset);
        }

        .module-card.module-blue {
            background: var(--gradient-blue);
        }

        .module-card.module-green {
            background: var(--gradient-teal);
        }

    /* Financial Card */
    .financial-card {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 16px;
        color: white;
        padding: 1.5rem;
        box-shadow: var(--shadow-lg);
    }

    .financial-stat {
        text-align: center;
        padding: 1rem;
        background: rgba(255, 255, 255, 0.15);
        border-radius: 12px;
        backdrop-filter: blur(10px);
    }

        .financial-stat h6 {
            font-size: 0.8rem;
            opacity: 0.9;
            margin-bottom: 0.5rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .financial-stat h3 {
            font-size: 1.8rem;
            font-weight: 700;
            margin: 0;
        }

    /* Table Styling */
    .table-hover tbody tr {
        transition: all 0.3s ease;
    }

        .table-hover tbody tr:hover {
            background-color: var(--bg-main);
            transform: scale(1.01);
        }

    /* Responsive */
    @@media (max-width: 768px) {
        .stat-card h2

    {
        font-size: 1.5rem;
    }

    .stat-card .stat-icon {
        font-size: 1.6rem;
    }

    .module-card .module-icon {
        font-size: 2.5rem;
    }

    .dashboard-header h2 {
        font-size: 1.5rem;
    }

    }

    @@media (max-width: 576px) {
        .role-badge

    {
        font-size: 0.75rem;
        padding: 0.3rem 0.7rem;
    }

    .btn-action {
        padding: 0.6rem 1rem;
        font-size: 0.9rem;
    }

    .card-body {
        padding: 1rem;
    }

    .stat-card {
        padding: 1rem;
    }

    .module-card {
        padding: 1.5rem 1.25rem;
    }

    }
</style>

<div class="container-fluid mt-4">
    <!-- Welcome Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="dashboard-header">
                <h2 class="mb-2">
                    <i class="bi bi-speedometer2"></i> Welcome, @Model.FullName! 👋
                </h2>
                <p class="text-muted mb-0">
                    @if (Model.AllRoles.Any())
                    {
                        <span>Roles: </span>
                        @foreach (var role in Model.AllRoles)
                        {
                            <span class="role-badge">@role</span>
                        }
                    }
                    else
                    {
                        <span>Role: <span class="role-badge">@Model.Role</span></span>
                    }
                </p>
            </div>
        </div>
    </div>

    <!-- Quick Actions Card -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-lightning-charge"></i> Quick Actions</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        @if (User.IsInRole("SuperAdmin"))
                        {
                            <div class="col-lg-3 col-md-6">
                                <a asp-controller="ApartmentBuilder" asp-action="ManageApartments"
                                   class="btn btn-action btn-primary w-100">
                                    <i class="bi bi-buildings"></i> My Apartments
                                </a>
                            </div>
                            <div class="col-lg-3 col-md-6">
                                <a asp-controller="ApartmentBuilder" asp-action="Create"
                                   class="btn btn-action btn-secondary w-100">
                                    <i class="bi bi-building-add"></i> Create Apartment
                                </a>
                            </div>
                        }

                        <div class="col-lg-3 col-md-6">
                            <a asp-controller="Onboarding" asp-action="Create" class="btn btn-action btn-success w-100">
                                <i class="bi bi-person-plus"></i> Onboard Resident
                            </a>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <a asp-controller="CommunityMembers" asp-action="Index" class="btn btn-action btn-info w-100">
                                <i class="bi bi-people"></i> Community Members
                            </a>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <a asp-controller="StaffMembers" asp-action="Index" class="btn btn-action btn-warning w-100">
                                <i class="bi bi-person-badge"></i> Staff Members
                            </a>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <a asp-controller="ResidentManagement" asp-action="Index" class="btn btn-action btn-primary w-100">
                                <i class="bi bi-house-door"></i> All Residents
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Apartment Portfolio (SuperAdmin Only) -->
    @if (User.IsInRole("SuperAdmin") && Model.Stats.TotalApartments.HasValue)
    {
        <div class="row mb-4">
            <div class="col-12">
                <div class="card portfolio-card">
                    <div class="card-header">
                        <h5 class="mb-0">
                            <i class="bi bi-buildings-fill"></i> Apartment Portfolio Overview
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-lg-3 col-md-6">
                                <div class="portfolio-stat-card">
                                    <i class="bi bi-building"></i>
                                    <h2>@Model.Stats.TotalApartments</h2>
                                    <p class="mb-0 small">Total Apartments</p>
                                </div>
                            </div>
                            <div class="col-lg-3 col-md-6">
                                <div class="portfolio-stat-card">
                                    <i class="bi bi-check-circle"></i>
                                    <h2>@Model.Stats.ActiveApartments</h2>
                                    <p class="mb-0 small">Active Buildings</p>
                                </div>
                            </div>
                            <div class="col-lg-3 col-md-6">
                                <div class="portfolio-stat-card">
                                    <i class="bi bi-layers"></i>
                                    <h2>@Model.Stats.TotalFloors</h2>
                                    <p class="mb-0 small">Total Floors</p>
                                </div>
                            </div>
                            <div class="col-lg-3 col-md-6">
                                <div class="portfolio-stat-card">
                                    <i class="bi bi-person-badge"></i>
                                    <h2>@Model.Stats.TotalManagers</h2>
                                    <p class="mb-0 small">Assigned Managers</p>
                                </div>
                            </div>
                        </div>
                        <div class="text-center mt-3">
                            <a asp-controller="ApartmentBuilder" asp-action="ManageApartments"
                               class="btn btn-light" style="border-radius: 10px; font-weight: 600; padding: 0.6rem 1.5rem;">
                                <i class="bi bi-gear-fill"></i> Manage All Apartments
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Statistics Cards Row 1 -->
    <div class="row g-3 mb-4">
        <div class="col-lg-3 col-md-6">
            <div class="stat-card stat-primary">
                <div class="position-relative">
                    <h6>Total Residents</h6>
                    <h2>@Model.Stats.TotalResidents</h2>
                    <small>Active users in system</small>
                </div>
                <i class="bi bi-people-fill stat-icon"></i>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="stat-card stat-orange">
                <div class="position-relative">
                    <h6>Pending Registrations</h6>
                    <h2>@Model.Stats.PendingRegistrations</h2>
                    <a asp-controller="AdminResidents" asp-action="Pending" class="btn btn-light btn-sm mt-2" style="border-radius: 8px; font-size: 0.8rem; padding: 0.4rem 0.8rem;">
                        <i class="bi bi-eye"></i> View Pending
                    </a>
                </div>
                <i class="bi bi-hourglass-split stat-icon"></i>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="stat-card stat-green">
                <div class="position-relative">
                    <h6>Total Flats</h6>
                    <h2>@Model.Stats.TotalFlats</h2>
                    <small>@Model.Stats.OccupiedFlats Occupied</small>
                </div>
                <i class="bi bi-building stat-icon"></i>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="stat-card stat-blue">
                <div class="position-relative">
                    <h6>Vacant Flats</h6>
                    <h2>@Model.Stats.VacantFlats</h2>
                    <small>Available for assignment</small>
                </div>
                <i class="bi bi-house stat-icon"></i>
            </div>
        </div>
    </div>

    <!-- Statistics Cards Row 2 -->
    <div class="row g-3 mb-4">
        <div class="col-lg-3 col-md-6">
            <div class="stat-card stat-purple">
                <div class="position-relative">
                    <h6>Staff Members</h6>
                    <h2>@Model.Stats.TotalStaffMembers</h2>
                    <small>@Model.Stats.ActiveStaffMembers Active</small>
                </div>
                <i class="bi bi-person-badge-fill stat-icon"></i>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="stat-card stat-teal">
                <div class="position-relative">
                    <h6>Community Members</h6>
                    <h2>@Model.Stats.CommunityMembers</h2>
                    <small>President, Secretary, Treasurer</small>
                </div>
                <i class="bi bi-award-fill stat-icon"></i>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="stat-card stat-sunset">
                <div class="position-relative">
                    <h6>Pending Complaints</h6>
                    <h2>@Model.Stats.PendingComplaints</h2>
                    <small>Resolved: @Model.Stats.ResolvedComplaintsThisMonth</small>
                </div>
                <i class="bi bi-exclamation-triangle-fill stat-icon"></i>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="stat-card stat-blue">
                <div class="position-relative">
                    <h6>Today's Visitors</h6>
                    <h2>@Model.Stats.TodaysVisitors</h2>
                    <small>Security: @Model.Stats.ActiveSecurityPersonnel</small>
                </div>
                <i class="bi bi-door-open-fill stat-icon"></i>
            </div>
        </div>
    </div>

    <!-- Financial Summary -->
    @if ((User.IsInRole("SuperAdmin") || User.IsInRole("Treasurer")) && Model.FinancialSummary != null)
    {
        <div class="row mb-4">
            <div class="col-12">
                <div class="financial-card">
                    <h5 class="mb-3"><i class="bi bi-currency-rupee"></i> Financial Summary</h5>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="financial-stat">
                                <h6>Total Outstanding</h6>
                                <h3>₹@Model.FinancialSummary.TotalOutstanding.ToString("N2")</h3>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="financial-stat">
                                <h6>Collection This Month</h6>
                                <h3>₹@Model.FinancialSummary.CollectionThisMonth.ToString("N2")</h3>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="financial-stat d-flex align-items-center justify-content-center">
                                <a href="#" class="btn btn-light" style="border-radius: 10px; font-weight: 600;">
                                    <i class="bi bi-graph-up"></i> View Reports
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Module Cards - Removed Apartment Management -->
    <div class="row g-3 mb-4">
        <div class="col-lg-4 col-md-6">
            <div class="module-card module-orange">
                <div class="module-icon"><i class="bi bi-clipboard-check"></i></div>
                <h5>Complaints Management</h5>
                <h3>@Model.Stats.PendingComplaints</h3>
                <p>Track and resolve resident complaints</p>
                <hr />
                <small>Coming in Phase 5</small>
            </div>
        </div>

        <div class="col-lg-4 col-md-6">
            <div class="module-card module-blue">
                <div class="module-icon"><i class="bi bi-receipt"></i></div>
                <h5>Billing & Payments</h5>
                <h3>₹@Model.Stats.TotalOutstandingBills.ToString("N0")</h3>
                <p>Manage maintenance & utility bills</p>
                <hr />
                <small>Coming in Phase 6</small>
            </div>
        </div>

        <div class="col-lg-4 col-md-6">
            <div class="module-card module-green">
                <div class="module-icon"><i class="bi bi-calendar-event"></i></div>
                <h5>Visitor Management</h5>
                <h3>@Model.Stats.TodaysVisitors</h3>
                <p>Track visitors and deliveries</p>
                <hr />
                <small>Coming in Phase 7</small>
            </div>
        </div>
    </div>

    <!-- Recent Activities -->
    @if (Model.RecentActivities != null && Model.RecentActivities.Any())
    {
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;">
                        <h5 class="mb-0"><i class="bi bi-clock-history"></i> Recent Activities</h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Activity</th>
                                        <th>Type</th>
                                        <th>Timestamp</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var activity in Model.RecentActivities.Take(10))
                                    {
                                        <tr>
                                            <td>@activity.Activity</td>
                                            <td>
                                                <span class="role-badge" style="font-size: 0.75rem; padding: 0.25rem 0.65rem;">@activity.Type</span>
                                            </td>
                                            <td class="text-muted small">@activity.Timestamp.ToString("MMM dd, yyyy hh:mm tt")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>


















@*
