            .flat-box.occupied {
                border-color: #ffeb3b;
                background: rgba(255, 235, 59, 0.1);
            }

            .flat-box:hover {
                transform: scale(1.05);
                box-shadow: 0 4px 16px rgba(102, 126, 234, 0.4);
            }

        .flat-number-display {
            font-size: 1.2rem;
            font-weight: 800;
            margin-bottom: 0.5rem;
        }

        .flat-status-display {
