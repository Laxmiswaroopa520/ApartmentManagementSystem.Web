
@model ApartmentManagementSystem.Web.ViewModels.Onboarding.CreateInviteViewModel

@{
    ViewData["Title"] = "Onboard New Resident";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-person-plus"></i> Onboard New Resident
                    </h4>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()

                        <!-- Full Name -->
                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label">Full Name</label>
                            <input asp-for="FullName" class="form-control" placeholder="Enter full name" />
                            <span asp-validation-for="FullName" class="text-danger"></span>
                        </div>

                        <!-- Phone Number -->
                        <div class="mb-3">
                            <label asp-for="PrimaryPhone" class="form-label">Phone Number</label>
                            <input asp-for="PrimaryPhone" class="form-control" placeholder="Enter phone number" />
                            <span asp-validation-for="PrimaryPhone" class="text-danger"></span>
                        </div>

                        <!-- Resident Type -->
                        <div class="mb-3">
                            <label asp-for="ResidentType" class="form-label">Resident Type</label>
                            <select asp-for="ResidentType" class="form-select">
                                <option value="">-- Select Resident Type --</option>
                                @foreach (var type in Model.ResidentTypes)
                                {
                                    <option value="@type.Id">@type.Name</option>
                                }
                            </select>

                          <!--  <select asp-for="ResidentType" class="form-select" required>
                                <option value="0">-- Select Resident Type --</option>
                                @foreach (var type in Model.ResidentTypes)
                                {
                                    if (Model.ResidentType == type.Id)
                                    {
                                        <option value="@type.Id" selected>@type.Name</option>
                                    }
                                    else
                                    {
                                        <option value="@type.Id">@type.Name</option>
                                    }
                                }
                            </select>-->

                            <span asp-validation-for="ResidentType" class="text-danger"></span>
                        </div>

                        <!-- Submit / Cancel buttons -->
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-check-circle"></i> Create Invite & Generate OTP
                            </button>
                            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}



