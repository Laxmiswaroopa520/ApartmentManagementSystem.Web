@model List<ApartmentManagementSystem.Web.ViewModels.Community.CommunityMemberViewModel>
@{
    ViewData["Title"] = "Community Members";
    Layout = "_Layout";
}

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-md-8">
            <h2><i class="bi bi-award"></i> Community Members</h2>
            <p class="text-muted">Manage President, Secretary, and Treasurer roles</p>
        </div>
        <div class="col-md-4 text-end">
            @*Pass apartmentId so AssignRole knows which apartment we're in *@
            <a asp-action="AssignRole"
               asp-route-apartmentId="@ViewBag.ApartmentId"
               class="btn btn-primary btn-lg">
                <i class="bi bi-person-plus-fill"></i> Assign Community Role
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Current Community Members</h5>
                </div>
                <div class="card-body">
                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>Full Name</th>
                                        <th>Role</th>
                                        <th>Flat Number</th>
                                        <th>Email</th>
                                        <th>Phone</th>
                                        <th>Assigned On</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var member in Model)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@member.FullName</strong>
                                            </td>
                                            <td>
                                                @if (member.Role == "President")
                                                {
                                                    <span class="badge bg-danger fs-6">
                                                        <i class="bi bi-star-fill"></i> President
                                                    </span>
                                                }
                                                else if (member.Role == "Secretary")
                                                {
                                                    <span class="badge bg-primary fs-6">
                                                        <i class="bi bi-file-earmark-text"></i> Secretary
                                                    </span>
                                                }
                                                else if (member.Role == "Treasurer")
                                                {
                                                    <span class="badge bg-success fs-6">
                                                        <i class="bi bi-cash-coin"></i> Treasurer
                                                    </span>
                                                }
                                            </td>
                                            <td><span class="badge bg-secondary">@member.FlatNumber</span></td>
                                            <td>@member.Email</td>
                                            <td>@member.Phone</td>
                                            <td>@member.AssignedOn.ToString("MMM dd, yyyy")</td>
                                            <td>
                                                @if (member.IsActive)
                                                {
                                                    <span class="badge bg-success">Active</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">Inactive</span>
                                                }
                                            </td>
                                            <td>
                                                @*  Pass apartmentId as hidden field so the controller
                                                   can redirect back to the correct apartment's Index *@
                                                <form asp-action="RemoveRole" method="post" class="d-inline"
                                                      onsubmit="return confirm('Are you sure you want to remove @member.Role role from @member.FullName?');">
                                                    <input type="hidden" name="userId" value="@member.UserId" />
                                                    <input type="hidden" name="apartmentId" value="@ViewBag.ApartmentId" />
                                                    <button type="submit" class="btn btn-sm btn-danger">
                                                        <i class="bi bi-trash"></i> Remove Role
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle"></i> No community members assigned yet.
                            <a asp-action="AssignRole" asp-route-apartmentId="@ViewBag.ApartmentId" class="alert-link">Click here to assign roles.</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    @* Role Information Card *@
    <div class="row mt-4">
        <div class="col-12">
            <div class="card border-info">
                <div class="card-header bg-info text-white">
                    <h6 class="mb-0"><i class="bi bi-info-circle"></i> Community Role Information</h6>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4">
                            <h6 class="text-danger"><i class="bi bi-star-fill"></i> President</h6>
                            <p class="small">Overall leadership and decision-making authority for the community.</p>
                        </div>
                        <div class="col-md-4">
                            <h6 class="text-primary"><i class="bi bi-file-earmark-text"></i> Secretary</h6>
                            <p class="small">Maintains records, communications, and administrative tasks.</p>
                        </div>
                        <div class="col-md-4">
                            <h6 class="text-success"><i class="bi bi-cash-coin"></i> Treasurer</h6>
                            <p class="small">Manages finances, billing, and financial reporting.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



