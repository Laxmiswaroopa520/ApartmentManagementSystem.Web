
@* Views/ApartmentBuilder/ManageApartments.cshtml *@

@model List<ApartmentManagementSystem.Web.ViewModels.Apartment.ApartmentListViewModel>

@{
    ViewData["Title"] = "Manage Apartments - Skyline";
}

<style>
    :root {
        --gradient-primary: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        --gradient-blue: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
        --gradient-green: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
        --gradient-orange: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
        --bg-main: #f5f6f7;
        --bg-card: #ffffff;
        --text-dark: #1f2933;
        --text-muted: #6b7280;
        --shadow-sm: 0 2px 8px rgba(0,0,0,0.08);
        --shadow-md: 0 4px 16px rgba(0,0,0,0.12);
        --shadow-hover: 0 8px 24px rgba(0,0,0,0.15);
    }

    .apartments-dashboard {
        max-width: 1400px;
        margin: 0 auto;
        padding: 2rem 1rem;
    }

    .dashboard-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .header-content h1 {
        font-size: 1.8rem;
        font-weight: 700;
        color: var(--text-dark);
        margin-bottom: 0.5rem;
    }

    .dashboard-subtitle {
        font-size: 1rem;
        color: var(--text-muted);
    }

    .btn-create {
        background: var(--gradient-primary);
        color: white;
        padding: 0.75rem 1.5rem;
        border-radius: 10px;
        text-decoration: none;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.3s ease;
        box-shadow: 0 2px 8px rgba(102, 126, 234, 0.3);
        border: none;
    }

        .btn-create:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 16px rgba(102, 126, 234, 0.4);
            color: white;
        }

    .empty-state {
        text-align: center;
        padding: 4rem 2rem;
        background: var(--bg-card);
        border-radius: 16px;
        border: 2px dashed #d1d5db;
    }

    .empty-icon {
        font-size: 4rem;
        color: #9ca3af;
        margin-bottom: 1.5rem;
        opacity: 0.5;
    }

    .empty-state h3 {
        font-size: 1.5rem;
        margin-bottom: 0.75rem;
        color: var(--text-dark);
    }

    .empty-state p {
        font-size: 1rem;
        color: var(--text-muted);
        margin-bottom: 1.5rem;
    }

    /* Compact Apartment Cards */
    .apartments-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 1.25rem;
    }

    .apartment-card {
        background: var(--bg-card);
        border-radius: 14px;
        overflow: hidden;
        border: 1px solid #e5e7eb;
        transition: all 0.3s ease;
        position: relative;
    }

        .apartment-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 3px;
            background: var(--gradient-primary);
        }

        .apartment-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-hover);
            border-color: #667eea;
        }

    .card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.875rem 1rem;
        border-bottom: 1px solid #e5e7eb;
    }

    .apartment-status {
        padding: 0.35rem 0.75rem;
        border-radius: 12px;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.3px;
    }

    .status-active {
        background: rgba(67, 233, 123, 0.15);
        color: #10b981;
    }

    .status-underconstruction {
        background: rgba(251, 146, 60, 0.15);
        color: #f59e0b;
    }

    .status-inactive {
        background: rgba(156, 163, 175, 0.15);
        color: #6b7280;
    }

    .btn-icon {
        width: 30px;
        height: 30px;
        border-radius: 6px;
        border: none;
        background: transparent;
        color: var(--text-muted);
        cursor: pointer;
        transition: all 0.3s ease;
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .btn-icon:hover {
            background: #f3f4f6;
            color: var(--text-dark);
        }

    .card-body {
        padding: 1.25rem 1rem;
        text-align: center;
    }

    .apartment-icon {
        width: 60px;
        height: 60px;
        margin: 0 auto 1rem;
        background: var(--gradient-primary);
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
        color: white;
        box-shadow: 0 4px 12px rgba(102, 126, 234, 0.3);
    }

    .apartment-name {
        font-size: 1.2rem;
        font-weight: 700;
        color: var(--text-dark);
        margin-bottom: 0.5rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .apartment-location {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
        color: var(--text-muted);
        font-size: 0.85rem;
        margin-bottom: 0.75rem;
    }

    .apartment-stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0.75rem;
        margin: 1rem 0;
    }

    .stat-item {
        background: #f9fafb;
        padding: 0.75rem 0.5rem;
        border-radius: 8px;
        border: 1px solid #e5e7eb;
    }

    .stat-icon {
        font-size: 1.1rem;
        color: #667eea;
        margin-bottom: 0.4rem;
    }

    .stat-value {
        font-size: 1.3rem;
        font-weight: 700;
        color: var(--text-dark);
        line-height: 1;
    }

    .stat-label {
        font-size: 0.7rem;
        color: var(--text-muted);
        text-transform: uppercase;
        margin-top: 0.25rem;
    }

    .occupancy-bar {
        margin-top: 1rem;
    }

    .occupancy-progress {
        height: 6px;
        background: #e5e7eb;
        border-radius: 10px;
        overflow: hidden;
        margin-bottom: 0.4rem;
    }

    .occupancy-fill {
        height: 100%;
        background: var(--gradient-primary);
        border-radius: 10px;
        transition: width 1s ease-out;
    }

    .occupancy-text {
        font-size: 0.8rem;
        color: var(--text-muted);
        text-align: center;
    }

    .card-footer {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.5rem;
        padding: 0.875rem 1rem;
        border-top: 1px solid #e5e7eb;
    }

    .btn-details,
    .btn-visualize {
        padding: 0.6rem 0.75rem;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
        text-align: center;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
        font-size: 0.85rem;
    }

    .btn-details {
        background: white;
        color: #667eea;
        border: 1.5px solid #667eea;
    }

        .btn-details:hover {
            background: #667eea;
            color: white;
        }

    .btn-visualize {
        background: var(--gradient-primary);
        color: white;
        border: none;
    }

        .btn-visualize:hover {
            transform: scale(1.03);
            box-shadow: 0 4px 12px rgba(102, 126, 234, 0.4);
            color: white;
        }

    @@media (max-width: 768px) {
        .apartments-grid

    {
        grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    }

    .dashboard-header {
        flex-direction: column;
        align-items: flex-start;
    }

    }

    @@media (max-width: 576px) {
        .apartments-grid

    {
        grid-template-columns: 1fr;
    }

    .card-footer {
        grid-template-columns: 1fr;
    }

    }
</style>

<div class="apartments-dashboard">
    <div class="dashboard-header">
        <div class="header-content">
            <h1>
                <i class="fas fa-city"></i>
                My Apartment Buildings
            </h1>
            <p class="dashboard-subtitle">Manage all your properties in one place</p>
        </div>
        <div class="header-actions">
            <a href="@Url.Action("Create", "ApartmentBuilder")" class="btn btn-create">
                <i class="fas fa-plus-circle"></i>
                Create New Apartment
            </a>
        </div>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="empty-state">
            <div class="empty-icon">
                <i class="fas fa-building"></i>
            </div>
            <h3>No Apartments Yet</h3>
            <p>Get started by creating your first apartment building</p>
            <a href="@Url.Action("Create", "ApartmentBuilder")" class="btn btn-create">
                <i class="fas fa-plus"></i> Create Your First Apartment
            </a>
        </div>
    }
    else
    {
        <div class="apartments-grid">
            @foreach (var apartment in Model)
            {
                <div class="apartment-card" data-apartment-id="@apartment.Id">
                    <div class="card-header">
                        <div class="apartment-status status-@apartment.Status.ToLower()">
                            @apartment.Status
                        </div>
                        <button class="btn-icon" title="More options">
                            <i class="fas fa-ellipsis-v"></i>
                        </button>
                    </div>

                    <div class="card-body">
                        <div class="apartment-icon">
                            <i class="fas fa-building"></i>
                        </div>

                        <h3 class="apartment-name" title="@apartment.Name">@apartment.Name</h3>

                        <div class="apartment-location">
                            <i class="fas fa-map-marker-alt"></i>
                            <span>@apartment.Address</span>
                        </div>

                        <div class="apartment-stats">
                            <div class="stat-item">
                                <div class="stat-icon"><i class="fas fa-layer-group"></i></div>
                                <div class="stat-value">@apartment.TotalFloors</div>
                                <div class="stat-label">Floors</div>
                            </div>

                            <div class="stat-item">
                                <div class="stat-icon"><i class="fas fa-home"></i></div>
                                <div class="stat-value">@apartment.TotalFlats</div>
                                <div class="stat-label">Flats</div>
                            </div>

                            <div class="stat-item">
                                <div class="stat-icon"><i class="fas fa-users"></i></div>
                                <div class="stat-value">@apartment.OccupiedFlats</div>
                                <div class="stat-label">Occupied</div>
                            </div>
                        </div>

                        <div class="occupancy-bar">
                            @{
                                var occupancyPercent = apartment.TotalFlats > 0
                                ? (apartment.OccupiedFlats * 100.0 / apartment.TotalFlats)
                                : 0;
                            }
                            <div class="occupancy-progress">
                                <div class="occupancy-fill" style="width: @occupancyPercent%"></div>
                            </div>
                            <div class="occupancy-text">
                                @occupancyPercent.ToString("F0")% Occupied
                            </div>
                        </div>
                    </div>

                    <div class="card-footer">
                        <a href="@Url.Action("Details", "ApartmentBuilder", new { id = apartment.Id })"
                          @* class="btn btn-details">       making that both details and visualiz should use the btn-visualize color only..*@
                           class="btn btn-visualize">
                            <i class="fas fa-info-circle"></i>
                            Details
                        </a>

                        <a href="@Url.Action("Visualize", "ApartmentBuilder", new { id = apartment.Id })"
                           class="btn btn-visualize">
                            <i class="fas fa-cube"></i>
                            3D View
                        </a>
                    </div>
                </div>
            }
        </div>
    }
</div>

