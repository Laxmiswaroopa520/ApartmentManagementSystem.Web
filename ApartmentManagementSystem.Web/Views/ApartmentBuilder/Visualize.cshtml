@*
    Final Fixed Version - Visualize.cshtml
    This version properly handles the data structure from your API
*@
@model ApartmentManagementSystem.Web.ViewModels.Apartment.ApartmentDiagramViewModel

@{
    ViewData["Title"] = Model?.Name + " - 3D Visualization";
}

@* Serialize the full diagram data for JS consumption *@
@{
    var diagramJson = System.Text.Json.JsonSerializer.Serialize(Model, new System.Text.Json.JsonSerializerOptions
    {
        PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase
    });
}

<style>
    :root {
        --bg: #0a0e27;
        --surface: #141830;
        --border: #2d3748;
        --accent: #667eea;
        --accent2: #00d4ff;
        --text: #e2e8f0;
        --muted: #718096;
    }

    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    body {
        background: var(--bg);
        color: var(--text);
        font-family: 'Segoe UI', sans-serif;
    }

    .viz-wrap {
        max-width: 1300px;
        margin: 0 auto;
        padding: 2rem 1rem;
    }

    /* ── HEADER ── */
    .viz-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 2rem;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .viz-title {
        font-size: 1.8rem;
        font-weight: 800;
        background: linear-gradient(90deg, var(--accent), var(--accent2));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        display: flex;
        align-items: center;
        gap: .6rem;
    }

        .viz-title i {
            -webkit-text-fill-color: var(--accent);
        }

    .viz-meta {
        font-size: .85rem;
        color: var(--muted);
        margin-top: .25rem;
    }

    .btn-back {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        padding: .6rem 1.2rem;
        border-radius: 8px;
        border: 1.5px solid var(--border);
        background: var(--surface);
        color: var(--text);
        text-decoration: none;
        font-weight: 600;
        font-size: .85rem;
        transition: all .2s;
    }

        .btn-back:hover {
            border-color: var(--accent);
            color: var(--accent);
        }

    /* ── STATS STRIP ── */
    .viz-stats {
        display: flex;
        gap: 1rem;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
    }

    .viz-stat {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: .75rem 1.25rem;
        display: flex;
        align-items: center;
        gap: .6rem;
        flex: 1;
        min-width: 140px;
    }

        .viz-stat i {
            font-size: 1.3rem;
            color: var(--accent);
        }

    .viz-stat-val {
        font-size: 1.4rem;
        font-weight: 800;
        color: var(--accent2);
        line-height: 1;
    }

    .viz-stat-lbl {
        font-size: .72rem;
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: .5px;
    }

    /* ── TOGGLE ── */
    .view-toggle {
        display: flex;
        gap: .5rem;
        margin-bottom: 1.25rem;
    }

    .toggle-btn {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        padding: .55rem 1.2rem;
        border-radius: 8px;
        border: 1.5px solid var(--border);
        background: var(--surface);
        color: var(--muted);
        cursor: pointer;
        font-weight: 600;
        font-size: .88rem;
        transition: all .2s;
    }

        .toggle-btn.active {
            border-color: var(--accent);
            background: rgba(102,126,234,.15);
            color: var(--accent);
        }

    /* ── CANVAS AREA ── */
    .viz-canvas {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 16px;
        overflow: hidden;
        min-height: 600px;
        position: relative;
    }

    /* ── 2D GRID ── */
    #view2d {
        padding: 1.5rem;
        overflow-y: auto;
        max-height: 700px;
    }

    .floor-row {
        display: flex;
        align-items: center;
        gap: .75rem;
        margin-bottom: .5rem;
    }

    .floor-label {
        width: 48px;
        font-size: .75rem;
        font-weight: 700;
        color: var(--accent2);
        text-align: center;
        flex-shrink: 0;
    }

    .flats-row {
        display: flex;
        gap: .5rem;
        flex-wrap: wrap;
    }

    .flat-box {
        width: 64px;
        height: 56px;
        border-radius: 8px;
        border: 1.5px solid var(--border);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        cursor: default;
        transition: transform .15s;
        font-size: .7rem;
        font-weight: 700;
        position: relative;
    }

        .flat-box:hover {
            transform: scale(1.08);
        }

        .flat-box.vacant {
            background: rgba(45,53,97,.6);
            color: var(--muted);
        }

        .flat-box.occupied {
            background: rgba(255,215,0,.12);
            border-color: #ffd700;
            color: #ffd700;
        }

        .flat-box i {
            font-size: .9rem;
            margin-bottom: .15rem;
        }

    .flat-num {
        font-size: .65rem;
    }

    /* ── 3D CONTAINER ── */
    #view3d {
        width: 100%;
        height: 600px;
        position: relative;
    }

    #three-canvas-mount {
        width: 100%;
        height: 100%;
    }

    .three-hint {
        position: absolute;
        bottom: 1rem;
        left: 50%;
        transform: translateX(-50%);
        background: rgba(0,0,0,.5);
        color: var(--muted);
        font-size: .75rem;
        padding: .4rem .85rem;
        border-radius: 20px;
        pointer-events: none;
    }

    /* ── LEGEND ── */
    .viz-legend {
        display: flex;
        gap: 1.25rem;
        margin-top: 1rem;
        flex-wrap: wrap;
    }

    .legend-item {
        display: flex;
        align-items: center;
        gap: .4rem;
        font-size: .78rem;
        color: var(--muted);
    }

    .legend-dot {
        width: 12px;
        height: 12px;
        border-radius: 3px;
    }

        .legend-dot.vacant {
            background: rgba(45,53,97,.9);
            border: 1px solid #2d3748;
        }

        .legend-dot.occupied {
            background: rgba(255,215,0,.4);
            border: 1px solid #ffd700;
        }

    /* ── ERROR STATE ── */
    .error-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 400px;
        color: var(--muted);
        text-align: center;
        gap: 1rem;
    }

        .error-state i {
            font-size: 3rem;
            color: #ef4444;
        }

    @@media (max-width: 600px) {
        .viz-title

    {
        font-size: 1.3rem;
    }

    .flat-box {
        width: 52px;
        height: 46px;
    }

    }
</style>

<div class="viz-wrap">

    <!-- Header -->
    <div class="viz-header">
        <div>
            <div class="viz-title">
                <i class="fas fa-building"></i>
                @Model?.Name
            </div>
            <div class="viz-meta">
                <i class="fas fa-map-marker-alt"></i> @Model?.Address &nbsp;|&nbsp;
                @Model?.TotalFloors Floors &nbsp;|&nbsp; @(Model?.Floors?.Sum(f => f.Flats?.Count ?? 0)) Total Flats
            </div>
        </div>
        <a href="@Url.Action("Details", "ApartmentBuilder", new { id = Model?.ApartmentId })" class="btn-back">
            <i class="fas fa-arrow-left"></i> Back to Details
        </a>
    </div>

    <!-- Stats -->
    @if (Model != null)
    {
        var totalFlats = Model.Floors?.Sum(f => f.Flats?.Count ?? 0) ?? 0;
        var occupiedFlats = Model.Floors?.Sum(f => f.Flats?.Count(fl => fl.IsOccupied) ?? 0) ?? 0;
        var vacantFlats = totalFlats - occupiedFlats;

        <div class="viz-stats">
            <div class="viz-stat">
                <i class="fas fa-layer-group"></i>
                <div>
                    <div class="viz-stat-val">@Model.TotalFloors</div>
                    <div class="viz-stat-lbl">Floors</div>
                </div>
            </div>
            <div class="viz-stat">
                <i class="fas fa-home"></i>
                <div>
                    <div class="viz-stat-val">@totalFlats</div>
                    <div class="viz-stat-lbl">Total Flats</div>
                </div>
            </div>
            <div class="viz-stat">
                <i class="fas fa-users"></i>
                <div>
                    <div class="viz-stat-val">@occupiedFlats</div>
                    <div class="viz-stat-lbl">Occupied</div>
                </div>
            </div>
            <div class="viz-stat">
                <i class="fas fa-door-open"></i>
                <div>
                    <div class="viz-stat-val">@vacantFlats</div>
                    <div class="viz-stat-lbl">Vacant</div>
                </div>
            </div>
        </div>
    }

    <!-- Toggle -->
    <div class="view-toggle">
        <button class="toggle-btn active" id="btn2d" onclick="switchView('2d')">
            <i class="fas fa-th"></i> 2D Floor Plan
        </button>
        <button class="toggle-btn" id="btn3d" onclick="switchView('3d')">
            <i class="fas fa-cube"></i> 3D View
        </button>
    </div>

    <!-- Canvas -->
    <div class="viz-canvas">

        <!-- 2D VIEW -->
        <div id="view2d"></div>

        <!-- 3D VIEW -->
        <div id="view3d" style="display:none;">
            <div id="three-canvas-mount"></div>
            <div class="three-hint">
                <i class="fas fa-mouse"></i> Drag to rotate &nbsp;|&nbsp; Scroll to zoom
            </div>
        </div>
    </div>

    <!-- Legend -->
    <div class="viz-legend">
        <div class="legend-item">
            <div class="legend-dot vacant"></div> Vacant
        </div>
        <div class="legend-item">
            <div class="legend-dot occupied"></div> Occupied
        </div>
    </div>

</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script>
        // ── DATA injected from server ──────────────────────────────────────────
        const APARTMENT_DATA = @Html.Raw(diagramJson);

        // ── STATE ─────────────────────────────────────────────────────────────
        let currentView = '2d';
        let scene, camera, renderer, buildingGroup, animId;

        // ── SWITCH VIEW ───────────────────────────────────────────────────────
        function switchView(v) {
            currentView = v;
            document.getElementById('view2d').style.display = v === '2d' ? 'block' : 'none';
            document.getElementById('view3d').style.display = v === '3d' ? 'block' : 'none';
            document.getElementById('btn2d').classList.toggle('active', v === '2d');
            document.getElementById('btn3d').classList.toggle('active', v === '3d');

            if (v === '3d') {
                // Use requestAnimationFrame to wait for the container to be
                // visible and have a non-zero clientWidth before init
                requestAnimationFrame(() => {
                    if (!renderer) {
                        init3D();
                    } else {
                        // Already initialised — just resize and resume
                        onResize();
                        if (!animId) animate3D();
                    }
                });
            } else {
                stop3D();
            }
        }

        //2D RENDER
        function render2D() {
            const wrap = document.getElementById('view2d');
            if (!APARTMENT_DATA || !APARTMENT_DATA.floors || !APARTMENT_DATA.floors.length) {
                wrap.innerHTML = `<div class="error-state"><i class="fas fa-exclamation-triangle"></i><p>No floor data available</p></div>`;
                return;
            }

            // Render top floor first (descending)
            const sorted = [...APARTMENT_DATA.floors].sort((a, b) => b.floorNumber - a.floorNumber);

            wrap.innerHTML = '';
            sorted.forEach(floor => {
                const row = document.createElement('div');
                row.className = 'floor-row';

                const lbl = document.createElement('div');
                lbl.className = 'floor-label';
                lbl.textContent = 'F' + floor.floorNumber;
                row.appendChild(lbl);

                const frow = document.createElement('div');
                frow.className = 'flats-row';

                (floor.flats || []).forEach(flat => {
                    const box = document.createElement('div');
                    box.className = 'flat-box ' + (flat.isOccupied ? 'occupied' : 'vacant');
                    box.title = `Flat ${flat.flatNumber} — ${flat.isOccupied ? (flat.occupantName || 'Occupied') : 'Vacant'}`;
                    box.innerHTML = `
                        <i class="fas ${flat.isOccupied ? 'fa-user' : 'fa-key'}"></i>
                        <span class="flat-num">${flat.flatNumber}</span>`;
                    frow.appendChild(box);
                });

                row.appendChild(frow);
                wrap.appendChild(row);
            });
        }

        //3D RENDER
        function init3D() {
            const container = document.getElementById('three-canvas-mount');
            container.innerHTML = '';

            const floors = (APARTMENT_DATA?.floors || []).length;
            const flatsPerFloor = (APARTMENT_DATA?.floors?.[0]?.flats || []).length;

            if (floors === 0 || flatsPerFloor === 0) {
                container.innerHTML = `<div class="error-state"><i class="fas fa-exclamation-triangle"></i><p>No data to render</p></div>`;
                return;
            }

            // Scene
            scene = new THREE.Scene();
            scene.background = new THREE.Color(0x0a0e27);
            scene.fog = new THREE.Fog(0x0a0e27, 80, 250);

            // Camera - use parent width as fallback since container may be 0 if freshly shown
            const w = container.clientWidth
                   || container.parentElement?.clientWidth
                   || document.querySelector('.viz-canvas')?.clientWidth
                   || 860;
            const h = 600;
            camera = new THREE.PerspectiveCamera(45, w / h, 0.1, 1000);
            camera.position.set(flatsPerFloor * 3 + 20, floors * 2 + 15, flatsPerFloor * 3 + 20);
            camera.lookAt(0, floors * 1.5, 0);

            // Renderer
            renderer = new THREE.WebGLRenderer({ antialias: true });
            renderer.setPixelRatio(window.devicePixelRatio || 1);
            renderer.setSize(w, h);
            renderer.shadowMap.enabled = true;
            renderer.shadowMap.type = THREE.PCFSoftShadowMap;
            container.appendChild(renderer.domElement);

            // Lights
            scene.add(new THREE.AmbientLight(0xffffff, 0.6));

            const sun = new THREE.DirectionalLight(0xffffff, 0.9);
            sun.position.set(60, 120, 60);
            sun.castShadow = true;
            sun.shadow.mapSize.set(2048, 2048);
            scene.add(sun);

            const pl1 = new THREE.PointLight(0x00d4ff, 1, 150);
            pl1.position.set(-25, 20, 25);
            scene.add(pl1);
            const pl2 = new THREE.PointLight(0x667eea, 0.6, 150);
            pl2.position.set(25, 10, -25);
            scene.add(pl2);

            // Ground
            const ground = new THREE.Mesh(
                new THREE.PlaneGeometry(120, 120),
                new THREE.MeshStandardMaterial({ color: 0x1a1f3a, roughness: 0.9 })
            );
            ground.rotation.x = -Math.PI / 2;
            ground.receiveShadow = true;
            scene.add(ground);

            const grid = new THREE.GridHelper(120, 60, 0x00d4ff, 0x1a1f3a);
            grid.material.opacity = 0.25;
            grid.material.transparent = true;
            scene.add(grid);

            // Building
            buildingGroup = new THREE.Group();
            buildBuilding();
            buildingGroup.position.y = 0.15;
            scene.add(buildingGroup);

            setupMouseControls(container);
            animate3D();

            // Force resize after first paint to fix zero-width canvas issue
            requestAnimationFrame(() => onResize());
            window.addEventListener('resize', onResize);
        }

        function buildBuilding() {
            const floorH = 3;
            const flatW = 4;
            const flatD = 4;
            const sortedFloors = [...APARTMENT_DATA.floors].sort((a, b) => a.floorNumber - b.floorNumber);
            const fpf = sortedFloors[0].flats.length;
            const bldW = fpf * flatW;
            const bldH = sortedFloors.length * floorH;

            sortedFloors.forEach((floor, fi) => {
                const yBase = fi * floorH;

                // Slab
                const slab = new THREE.Mesh(
                    new THREE.BoxGeometry(bldW, 0.25, flatD),
                    new THREE.MeshStandardMaterial({ color: 0x2d3561, roughness: 0.7, metalness: 0.3 })
                );
                slab.position.y = yBase;
                slab.castShadow = true;
                slab.receiveShadow = true;
                buildingGroup.add(slab);

                // Flats
                floor.flats.forEach((flat, ki) => {
                    const isOcc = flat.isOccupied;
                    const xPos = (ki - fpf / 2) * flatW + flatW / 2;

                    // Back wall
                    const wall = new THREE.Mesh(
                        new THREE.BoxGeometry(flatW - 0.3, floorH - 0.5, 0.1),
                        new THREE.MeshStandardMaterial({
                            color: isOcc ? 0xffd700 : 0x3d4575,
                            roughness: 0.6,
                            emissive: isOcc ? 0x443300 : 0x000000,
                            emissiveIntensity: isOcc ? 0.35 : 0
                        })
                    );
                    wall.position.set(xPos, yBase + floorH / 2 - 0.1, -flatD / 2 + 0.05);
                    buildingGroup.add(wall);

                    // Window glow for occupied
                    if (isOcc) {
                        const win = new THREE.Mesh(
                            new THREE.BoxGeometry(flatW * 0.55, floorH * 0.38, 0.06),
                            new THREE.MeshStandardMaterial({
                                color: 0xffffaa,
                                emissive: 0xffffaa,
                                emissiveIntensity: 0.9,
                                transparent: true,
                                opacity: 0.9
                            })
                        );
                        win.position.set(xPos, yBase + floorH / 2, -flatD / 2 + 0.12);
                        buildingGroup.add(win);
                    }
                });
            });

            // Glass facade
            const glassMat = new THREE.MeshPhysicalMaterial({
                color: 0x88ccff, transparent: true, opacity: 0.15,
                roughness: 0.05, metalness: 0.95, reflectivity: 1
            });

            [
                [new THREE.PlaneGeometry(bldW, bldH), [0, bldH / 2, flatD / 2], [0, 0, 0]],
                [new THREE.PlaneGeometry(flatD, bldH), [-bldW / 2, bldH / 2, 0], [0, Math.PI / 2, 0]],
                [new THREE.PlaneGeometry(flatD, bldH), [bldW / 2, bldH / 2, 0], [0, -Math.PI / 2, 0]]
            ].forEach(([geo, pos, rot]) => {
                const m = new THREE.Mesh(geo, glassMat);
                m.position.set(...pos);
                m.rotation.set(...rot);
                buildingGroup.add(m);
            });

            // Roof
            const roof = new THREE.Mesh(
                new THREE.BoxGeometry(bldW + 0.6, 0.35, flatD + 0.6),
                new THREE.MeshStandardMaterial({ color: 0x1a1f3a, roughness: 0.8, metalness: 0.4 })
            );
            roof.position.y = bldH;
            roof.castShadow = true;
            buildingGroup.add(roof);

            // Helipad
            const heli = new THREE.Mesh(
                new THREE.CylinderGeometry(2, 2, 0.12, 32),
                new THREE.MeshStandardMaterial({ color: 0xff6600, emissive: 0xff3300, emissiveIntensity: 0.4 })
            );
            heli.position.y = bldH + 0.2;
            buildingGroup.add(heli);

            buildingGroup.rotation.y = Math.PI / 6;
        }

        function animate3D() {
            animId = requestAnimationFrame(animate3D);
            if (buildingGroup) buildingGroup.rotation.y += 0.003;
            renderer.render(scene, camera);
        }

        function stop3D() {
            if (animId) { cancelAnimationFrame(animId); animId = null; }
        }

        function setupMouseControls(container) {
            let dragging = false, lastX = 0;

            container.addEventListener('mousedown', e => { dragging = true; lastX = e.clientX; });
            window.addEventListener('mouseup', () => { dragging = false; });
            container.addEventListener('mousemove', e => {
                if (!dragging || !buildingGroup) return;
                buildingGroup.rotation.y += (e.clientX - lastX) * 0.012;
                lastX = e.clientX;
            });
            container.addEventListener('wheel', e => {
                e.preventDefault();
                camera.position.z = Math.max(15, Math.min(100, camera.position.z + e.deltaY * 0.05));
            }, { passive: false });

            // Touch support
            let lastTouchX = 0;
            container.addEventListener('touchstart', e => { lastTouchX = e.touches[0].clientX; });
            container.addEventListener('touchmove', e => {
                if (!buildingGroup) return;
                buildingGroup.rotation.y += (e.touches[0].clientX - lastTouchX) * 0.012;
                lastTouchX = e.touches[0].clientX;
            });
        }

        function onResize() {
            if (!renderer || !camera) return;
            const c = document.getElementById('three-canvas-mount');
            if (!c) return;
            const w = c.clientWidth
                   || c.parentElement?.clientWidth
                   || document.querySelector('.viz-canvas')?.clientWidth
                   || 860;
            const h = 600;
            camera.aspect = w / h;
            camera.updateProjectionMatrix();
            renderer.setSize(w, h);
        }

        //INIT
        document.addEventListener('DOMContentLoaded', () => {
            render2D();
        });
    </script>
}









