    /* Compact Module Cards */
    .module-card {
        border-radius: 16px;
        color: white;
        text-align: center;
        padding: 1.75rem 1.5rem;
        box-shadow: var(--shadow-md);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
