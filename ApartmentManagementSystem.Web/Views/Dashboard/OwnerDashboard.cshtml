@model ApartmentManagementSystem.Web.ViewModels.Dashboard.OwnerDashboardViewModel
@{
    ViewData["Title"] = "My Dashboard - Skyline";
    Layout = "_Layout";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap');

    :root {
        --page: #eef0f6;
        --card: #ffffff;
        --card-2: #f8f9fc;
        --border: #e2e6f0;
        --border-md: #c8cfe0;
        --ink-1: #0a0e1a;
        --ink-2: #1c2235;
        --ink-3: #3d4460;
        --ink-4: #6b7499;
        --ink-5: #9ba3be;
        --indigo-m: #4338ca;
        --indigo-lt: #eef0ff;
        --indigo-pale: #f5f3ff;
        --teal: #0d9488;
        --teal-lt: #f0fdfb;
        --amber: #b45309;
        --amber-lt: #fef3c7;
        --rose: #be123c;
        --rose-lt: #fff1f2;
        --sky: #0369a1;
        --sky-lt: #e0f2fe;
        --violet: #6d28d9;
        --violet-lt: #ede9fe;
        --lime: #15803d;
        --lime-lt: #dcfce7;
        --g-brand: linear-gradient(135deg, #3730a3 0%, #4f46e5 45%, #0d9488 100%);
        --g-navy: linear-gradient(135deg, #0f172a 0%, #1e2a4a 55%, #0f2027 100%);
        --g-indigo: linear-gradient(135deg, #3730a3 0%, #4338ca 100%);
        --g-teal: linear-gradient(135deg, #0d9488 0%, #0891b2 100%);
        --g-amber: linear-gradient(135deg, #d97706 0%, #b45309 100%);
        --g-rose: linear-gradient(135deg, #be123c 0%, #e11d48 100%);
        --g-sky: linear-gradient(135deg, #0369a1 0%, #0284c7 100%);
        --g-violet: linear-gradient(135deg, #6d28d9 0%, #7c3aed 100%);
        --g-lime: linear-gradient(135deg, #15803d 0%, #16a34a 100%);
        --s1: 0 2px 8px rgba(10,14,26,.06), 0 1px 3px rgba(10,14,26,.04);
        --s2: 0 8px 24px rgba(10,14,26,.09), 0 3px 10px rgba(10,14,26,.05);
        --r4: 8px;
        --r6: 12px;
        --r8: 16px;
        --r10: 20px;
        --r12: 24px;
        font-family: 'Sora', sans-serif;
    }

    *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    body {
        background: var(--page);
        color: var(--ink-1);
        font-family: 'Sora', sans-serif;
        -webkit-font-smoothing: antialiased;
    }

    @@keyframes riseIn {
        from {
            opacity: 0;
            transform: translateY(22px) scale(.97);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    .ri {
        animation: riseIn .55s cubic-bezier(.22,1,.36,1) both;
    }

    .ri-1 {
        animation-delay: .07s;
    }

    .ri-2 {
        animation-delay: .14s;
    }

    .ri-3 {
        animation-delay: .21s;
    }

    .ri-4 {
        animation-delay: .28s;
    }

    .dash-wrap {
        max-width: 1280px;
        margin: 0 auto;
        padding: 1.8rem 2.2rem 5rem;
    }

    /* ── HERO ── */
    .hero {
        background: var(--g-navy);
        border-radius: var(--r12);
        padding: 2rem 2.8rem;
        margin-bottom: 2.2rem;
        position: relative;
        overflow: hidden;
        box-shadow: var(--s2);
        border: 1px solid rgba(255,255,255,.06);
    }

        .hero::before {
            content: '';
            position: absolute;
            width: 380px;
            height: 380px;
            top: -150px;
            right: 60px;
            background: radial-gradient(ellipse, rgba(67,56,202,.22) 0%, transparent 65%);
            pointer-events: none;
        }

        .hero::after {
            content: '';
            position: absolute;
            width: 240px;
            height: 240px;
            bottom: -90px;
            left: 4%;
            background: radial-gradient(ellipse, rgba(13,148,136,.15) 0%, transparent 65%);
            pointer-events: none;
        }

    .hero-grid {
        position: absolute;
        inset: 0;
        background-image: linear-gradient(rgba(255,255,255,.02) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.02) 1px, transparent 1px);
        background-size: 40px 40px;
        pointer-events: none;
    }

    .hero-content {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
    }

    .hero-left {
        display: flex;
        align-items: center;
        gap: 1.4rem;
    }

    .hero-avatar {
        width: 62px;
        height: 62px;
        border-radius: 16px;
        background: linear-gradient(135deg, rgba(67,56,202,.55), rgba(13,148,136,.45));
        border: 1.5px solid rgba(255,255,255,.14);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.6rem;
        flex-shrink: 0;
    }

    .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        background: rgba(67,56,202,.22);
        border: 1px solid rgba(99,102,241,.35);
        color: #a5b4fc;
        font-size: .78rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1.4px;
        padding: .32rem .95rem;
        border-radius: 30px;
        margin-bottom: .65rem;
    }

    .hero-title {
        font-size: 1.9rem;
        font-weight: 800;
        color: #fff;
        line-height: 1.2;
        letter-spacing: -.5px;
        margin-bottom: .55rem;
    }

        .hero-title .accent {
            background: linear-gradient(90deg, #818cf8 0%, #67e8f9 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

    .hero-role-pill {
        background: rgba(255,255,255,.07);
        border: 1px solid rgba(255,255,255,.12);
        color: rgba(255,255,255,.7);
        font-size: .82rem;
        font-weight: 600;
        padding: .32rem .95rem;
        border-radius: 30px;
        display: inline-block;
    }

    /* ── SECTION LABEL ── */
    .sec-row {
        display: flex;
        align-items: center;
        gap: .75rem;
        margin-bottom: 1.3rem;
    }

    .sec-bar {
        width: 4px;
        height: 24px;
        border-radius: 3px;
        background: var(--g-brand);
        flex-shrink: 0;
    }

    .sec-text {
        font-size: .82rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1.8px;
        color: var(--ink-3);
    }

    .section {
        margin-bottom: 2.8rem;
    }

    /* ── FLAT ITEMS — horizontal card layout ── */
    .flats-list {
        display: flex;
        flex-direction: column;
        gap: .9rem;
    }

    .flat-item {
        background: var(--card);
        border: 1.5px solid var(--border);
        border-radius: var(--r8);
        padding: 1.2rem 1.6rem;
        display: flex;
        align-items: center;
        gap: 1.4rem;
        box-shadow: var(--s1);
        transition: all .22s ease;
    }

        .flat-item:hover {
            border-color: var(--border-md);
            box-shadow: var(--s2);
            transform: translateY(-2px);
        }

    .flat-num-badge {
        background: var(--indigo-lt);
        border: 1.5px solid rgba(67,56,202,.15);
        border-radius: var(--r6);
        padding: .7rem 1.1rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        min-width: 72px;
    }

        .flat-num-badge i {
            color: var(--indigo-m);
            font-size: 1.2rem;
            margin-bottom: .3rem;
        }

        .flat-num-badge span {
            font-family: 'JetBrains Mono', monospace;
            font-size: .85rem;
            font-weight: 800;
            color: var(--indigo-m);
            letter-spacing: -.3px;
        }

    .flat-divider {
        width: 1px;
        height: 40px;
        background: var(--border);
        flex-shrink: 0;
    }

    .flat-fields {
        display: flex;
        align-items: center;
        gap: 2.5rem;
        flex: 1;
        flex-wrap: wrap;
    }

    .fi-row {
    }

    .fi-label {
        font-size: .7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: var(--ink-5);
        margin-bottom: .18rem;
    }

    .fi-value {
        font-size: .9rem;
        font-weight: 600;
        color: var(--ink-2);
    }

    .pill {
        display: inline-flex;
        align-items: center;
        gap: .3rem;
        padding: .28rem .75rem;
        border-radius: 20px;
        font-size: .76rem;
        font-weight: 700;
    }

    .pill-teal {
        background: var(--teal-lt);
        color: var(--teal);
        border: 1.5px solid rgba(13,148,136,.2);
    }

    .pill-amber {
        background: var(--amber-lt);
        color: var(--amber);
        border: 1.5px solid rgba(180,83,9,.2);
    }

    .empty-info {
        display: flex;
        align-items: flex-start;
        gap: .85rem;
        background: var(--sky-lt);
        border: 1.5px solid rgba(3,105,161,.18);
        border-left: 4px solid var(--sky);
        border-radius: var(--r6);
        padding: 1.1rem 1.3rem;
    }

        .empty-info i {
            color: var(--sky);
            font-size: 1.1rem;
            margin-top: .1rem;
            flex-shrink: 0;
        }

        .empty-info strong {
            color: var(--sky);
            display: block;
            margin-bottom: .2rem;
            font-size: .88rem;
        }

        .empty-info p {
            margin: 0;
            font-size: .82rem;
            color: var(--ink-4);
        }

    /* ── METRICS (identical to admin) ── */
    .metrics-grid {
        display: grid;
        grid-template-columns: repeat(3,1fr);
        gap: 1.2rem;
    }

    .metric-card {
        background: var(--card);
        border: 1.5px solid var(--border);
        border-radius: var(--r10);
        overflow: hidden;
        box-shadow: var(--s1);
        transition: all .26s ease;
    }

        .metric-card:hover {
            box-shadow: var(--s2);
            transform: translateY(-4px);
            border-color: transparent;
        }

    .mc-accent-bar {
        height: 4px;
    }

    .mc-amber .mc-accent-bar {
        background: var(--g-amber);
    }

    .mc-indigo .mc-accent-bar {
        background: var(--g-indigo);
    }

    .mc-teal .mc-accent-bar {
        background: var(--g-teal);
    }

    .mc-body {
        padding: 2.1rem 2.1rem 2rem;
    }

    .mc-row-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.4rem;
    }

    .mc-label {
        font-size: .82rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1.2px;
        color: var(--ink-4);
    }

    .mc-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
    }

    .mc-amber .mc-icon {
        background: var(--amber-lt);
        color: var(--amber);
    }

    .mc-indigo .mc-icon {
        background: var(--indigo-lt);
        color: var(--indigo-m);
    }

    .mc-teal .mc-icon {
        background: var(--teal-lt);
        color: var(--teal);
    }

    .mc-value {
        font-family: 'JetBrains Mono', monospace;
        font-size: 3.8rem;
        font-weight: 700;
        color: var(--ink-1);
        line-height: 1;
        letter-spacing: -2px;
        margin-bottom: .65rem;
    }

    .mc-sub {
        font-size: .86rem;
        color: var(--ink-5);
        display: flex;
        align-items: center;
        gap: .3rem;
    }

        .mc-sub i {
            font-size: .5rem;
        }

    /* ── QUICK ACTIONS (same tile pattern as admin) ── */
    .qa-grid {
        display: grid;
        grid-template-columns: repeat(3,1fr);
        gap: 1rem;
    }

    .qa-tile {
        background: var(--card);
        border: 1.5px solid var(--border);
        border-radius: var(--r8);
        padding: 2.2rem 1rem 2rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
        font-weight: 700;
        font-size: 1.05rem;
        color: var(--ink-3);
        box-shadow: var(--s1);
        text-align: center;
        font-family: 'Sora', sans-serif;
        position: relative;
        overflow: hidden;
        opacity: .5;
        cursor: not-allowed;
    }

        .qa-tile::before {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            height: 3px;
            border-radius: 0 0 var(--r8) var(--r8);
        }

        .qa-tile.qt-amber::before {
            background: var(--g-amber);
        }

        .qa-tile.qt-indigo::before {
            background: var(--g-indigo);
        }

        .qa-tile.qt-violet::before {
            background: var(--g-violet);
        }

    .qa-icon {
        width: 70px;
        height: 70px;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.75rem;
    }

    .ico-amber {
        background: var(--amber-lt);
        color: var(--amber);
    }

    .ico-indigo {
        background: var(--indigo-lt);
        color: var(--indigo-m);
    }

    .ico-violet {
        background: var(--violet-lt);
        color: var(--violet);
    }

    .phase-tag {
        font-size: .72rem;
        font-weight: 700;
        font-family: 'JetBrains Mono', monospace;
        background: var(--card-2);
        color: var(--ink-5);
        border: 1px solid var(--border);
        padding: .18rem .55rem;
        border-radius: 20px;
    }

    /* ── RESPONSIVE ── */
    @@media (max-width: 1024px) {
        .metrics-grid {
            grid-template-columns: repeat(2,1fr);
        }
    }

    @@media (max-width: 768px) {
        .dash-wrap {
            padding: 1rem 1rem 4rem;
        }

        .hero {
            padding: 1.2rem 1.3rem;
        }

        .hero-content {
            flex-direction: column;
            align-items: flex-start;
        }

        .hero-title {
            font-size: 1.4rem;
        }

        .metrics-grid {
            grid-template-columns: 1fr 1fr;
        }

        .qa-grid {
            grid-template-columns: repeat(2,1fr);
        }
    }

    @@media (max-width: 520px) {
        .metrics-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="dash-wrap">

    <!-- ── HERO ── -->
    <div class="hero ri">
        <div class="hero-grid"></div>
        <div class="hero-content">
            <div class="hero-left">
                <div class="hero-avatar">🏠</div>
                <div>
                    <div class="hero-badge">
                        <i class="bi bi-house-fill"></i> Skyline Resident Portal
                    </div>
                    <h1 class="hero-title">
                        Welcome back, <span class="accent">@Model.FullName</span> 👋
                    </h1>
                    <span class="hero-role-pill">Resident Owner</span>
                </div>
            </div>
        </div>
    </div>

    <!-- ── MY FLATS ── -->
    <div class="section ri ri-1">
        <div class="sec-row">
            <div class="sec-bar"></div>
            <span class="sec-text">My Flats</span>
        </div>

        <div class="flats-list">
            @if (Model.MyFlats.Any())
            {
                @foreach (var flat in Model.MyFlats)
                {
                    <div class="flat-item">
                        <div class="flat-num-badge">
                            <i class="bi bi-building"></i>
                            <span>@flat.FlatNumber</span>
                        </div>
                        <div class="flat-divider"></div>
                        <div class="flat-fields">
                            <div class="fi-row">
                                <div class="fi-label">Building</div>
                                <div class="fi-value">@flat.ApartmentName</div>
                            </div>
                            <div class="fi-row">
                                <div class="fi-label">Owner</div>
                                <div class="fi-value">@flat.OwnerName</div>
                            </div>
                            <div class="fi-row">
                                <div class="fi-label">Status</div>
                                @if (!string.IsNullOrEmpty(flat.TenantName))
                                {
                                    <span class="pill pill-teal">
                                        <i class="bi bi-person-check-fill"></i> @flat.TenantName
                                    </span>
                                }
                                else
                                {
                                    <span class="pill pill-amber">
                                        <i class="bi bi-house"></i> Vacant
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="empty-info">
                    <i class="bi bi-info-circle-fill"></i>
                    <div>
                        <strong>No flats assigned yet</strong>
                        <p>Please contact the administrator to assign your flat ownership.</p>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- ── KEY METRICS ── -->
    <div class="section ri ri-2">
        <div class="sec-row">
            <div class="sec-bar"></div>
            <span class="sec-text">Key Metrics</span>
        </div>
        <div class="metrics-grid">

            <div class="metric-card mc-amber">
                <div class="mc-accent-bar"></div>
                <div class="mc-body">
                    <div class="mc-row-top">
                        <span class="mc-label">Pending Complaints</span>
                        <div class="mc-icon"><i class="bi bi-clipboard-x-fill"></i></div>
                    </div>
                    <div class="mc-value">@Model.PendingComplaints</div>
                    <div class="mc-sub"><i class="bi bi-circle-fill"></i> Coming in Phase 5</div>
                </div>
            </div>

            <div class="metric-card mc-indigo">
                <div class="mc-accent-bar"></div>
                <div class="mc-body">
                    <div class="mc-row-top">
                        <span class="mc-label">Pending Bills</span>
                        <div class="mc-icon"><i class="bi bi-receipt-cutoff"></i></div>
                    </div>
                    <div class="mc-value">@Model.PendingBills</div>
                    <div class="mc-sub"><i class="bi bi-circle-fill"></i> Coming in Phase 6</div>
                </div>
            </div>

            <div class="metric-card mc-teal">
                <div class="mc-accent-bar"></div>
                <div class="mc-body">
                    <div class="mc-row-top">
                        <span class="mc-label">Total Outstanding</span>
                        <div class="mc-icon"><i class="bi bi-currency-rupee"></i></div>
                    </div>
                    <div class="mc-value" style="font-size:2.6rem; letter-spacing:-1px;">₹@Model.TotalOutstanding.ToString("N0")</div>
                    <div class="mc-sub"><i class="bi bi-circle-fill"></i> Coming in Phase 6</div>
                </div>
            </div>

        </div>
    </div>

    <!-- ── QUICK ACTIONS ── -->
    <div class="section ri ri-3">
        <div class="sec-row">
            <div class="sec-bar"></div>
            <span class="sec-text">Quick Actions</span>
        </div>
        <div class="qa-grid">
            <div class="qa-tile qt-amber">
                <div class="qa-icon ico-amber"><i class="bi bi-file-text-fill"></i></div>
                Raise Complaint
                <span class="phase-tag">Phase 5</span>
            </div>
            <div class="qa-tile qt-indigo">
                <div class="qa-icon ico-indigo"><i class="bi bi-credit-card-fill"></i></div>
                Pay Bills
                <span class="phase-tag">Phase 6</span>
            </div>
            <div class="qa-tile qt-violet">
                <div class="qa-icon ico-violet"><i class="bi bi-door-open-fill"></i></div>
                Manage Visitors
                <span class="phase-tag">Phase 7</span>
            </div>
        </div>
    </div>

</div>













@*
@model ApartmentManagementSystem.Web.ViewModels.Dashboard.OwnerDashboardViewModel
@{
    ViewData["Title"] = "My Dashboard - Skyline";
    Layout = "_Layout";
}

<style>
    :root {
        --gradient-primary: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        --gradient-success: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        --gradient-info: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
        --gradient-warning: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
        --gradient-dark: linear-gradient(135deg, #434343 0%, #000000 100%);
        --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.08);
        --shadow-md: 0 4px 16px rgba(0, 0, 0, 0.12);
        --shadow-lg: 0 8px 24px rgba(0, 0, 0, 0.15);
    }

    body {
        background: #f5f7fa;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .dashboard-header {
        background: white;
        padding: 1.5rem;
        border-radius: 16px;
        box-shadow: var(--shadow-sm);
        margin-bottom: 1.5rem;
    }

        .dashboard-header h2 {
            font-weight: 700;
            color: #1a202c;
            margin-bottom: 0.5rem;
            font-size: 1.75rem;
        }

    .role-badge {
        background: var(--gradient-success);
        color: white;
        padding: 0.4rem 1rem;
        border-radius: 50px;
        font-size: 0.85rem;
        font-weight: 600;
        display: inline-block;
        box-shadow: 0 4px 12px rgba(245, 87, 108, 0.3);
    }

    .stat-card {
        background: white;
        border-radius: 16px;
        padding: 1.5rem;
        box-shadow: var(--shadow-sm);
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
        height: 100%;
    }

        .stat-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: var(--gradient);
        }

        .stat-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-md);
        }

        .stat-card.gradient-primary {
            --gradient: var(--gradient-primary);
        }

        .stat-card.gradient-warning {
            --gradient: var(--gradient-warning);
        }

        .stat-card.gradient-info {
            --gradient: var(--gradient-info);
        }

        .stat-card .icon {
            font-size: 2.5rem;
            margin-bottom: 0.75rem;
        }

        .stat-card h3 {
            font-size: 2rem;
            font-weight: 700;
            color: #1a202c;
            margin-bottom: 0.25rem;
        }

        .stat-card p {
            color: #718096;
            font-size: 0.95rem;
            margin-bottom: 0.75rem;
        }

        .stat-card .status-text {
            font-size: 0.8rem;
            color: #a0aec0;
            font-weight: 500;
        }

    .section-card {
        background: white;
        border-radius: 16px;
        box-shadow: var(--shadow-sm);
        overflow: hidden;
        margin-bottom: 1.5rem;
    }

    .section-header {
        background: var(--gradient-primary);
        color: white;
        padding: 1rem 1.5rem;
        font-weight: 600;
        font-size: 1.1rem;
    }

        .section-header i {
            margin-right: 0.5rem;
        }

    .flat-card {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 1.25rem;
        transition: all 0.3s ease;
        height: 100%;
    }

        .flat-card:hover {
            border-color: #667eea;
            box-shadow: var(--shadow-sm);
            transform: translateY(-2px);
        }

        .flat-card h5 {
            color: #1a202c;
            font-weight: 700;
            margin-bottom: 1rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 1.1rem;
        }

        .flat-card .info-row {
            margin-bottom: 0.75rem;
        }

            .flat-card .info-row:last-child {
                margin-bottom: 0;
            }

        .flat-card .label {
            font-size: 0.8rem;
            color: #718096;
            margin-bottom: 0.25rem;
            font-weight: 500;
        }

        .flat-card .value {
            font-size: 0.95rem;
            color: #2d3748;
            font-weight: 600;
        }

    .flat-badge {
        padding: 0.35rem 0.85rem;
        border-radius: 8px;
        font-size: 0.85rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
    }

        .flat-badge.badge-tenant {
            background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
            color: white;
            box-shadow: 0 2px 8px rgba(79, 172, 254, 0.3);
        }

        .flat-badge.badge-vacant {
            background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
            color: white;
            box-shadow: 0 2px 8px rgba(250, 112, 154, 0.3);
        }

    .btn-action {
        padding: 0.75rem 1.25rem;
        border-radius: 10px;
        font-weight: 600;
        border: 2px solid transparent;
        background: white;
        color: #4a5568;
        border-color: #e2e8f0;
        opacity: 0.6;
        cursor: not-allowed;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.9rem;
    }

    .alert-custom {
        border-radius: 12px;
        border: none;
        padding: 1rem 1.25rem;
        background: #e6f7ff;
        border-left: 4px solid #4facfe;
        display: flex;
        align-items: start;
        gap: 1rem;
    }

        .alert-custom i {
            font-size: 1.5rem;
            color: #4facfe;
        }

        .alert-custom strong {
            display: block;
            margin-bottom: 0.25rem;
            color: #1a202c;
        }

        .alert-custom p {
            margin: 0;
            color: #4a5568;
            font-size: 0.9rem;
        }

    @@media (max-width: 768px) {
        .dashboard-header h2 {
            font-size: 1.5rem;
        }

        .stat-card h3 {
            font-size: 1.75rem;
        }

        .stat-card .icon {
            font-size: 2rem;
        }
    }

    @@media (max-width: 576px) {
        .stat-card {
            padding: 1.25rem;
        }

        .flat-card {
            padding: 1rem;
        }

        .btn-action {
            padding: 0.65rem 1rem;
            font-size: 0.85rem;
        }
    }
</style>

<div class="container mt-4">
    <!-- Header -->
    <div class="dashboard-header">
        <h2>Welcome, @Model.FullName! 👋</h2>
        <p class="text-muted mb-0" style="margin-top: 0.5rem;">
            Role: <span class="role-badge">Resident Owner</span>
        </p>
    </div>

    <!-- My Flats Section -->
    <div class="section-card">
        <div class="section-header">
            <i class="bi bi-buildings"></i> My Flats
        </div>
        <div class="card-body" style="padding: 1.5rem;">
            @if (Model.MyFlats.Any())
            {
                <div class="row g-3">
                    @foreach (var flat in Model.MyFlats)
                    {
                        <div class="col-lg-6">
                            <div class="flat-card">
                                <h5>
                                    <i class="bi bi-building"></i>
                                    Flat @flat.FlatNumber
                                </h5>
                                <div class="info-row">
                                    <div class="label">Building</div>
                                    <div class="value">@flat.ApartmentName</div>
                                </div>
                                <div class="info-row">
                                    <div class="label">Owner</div>
                                    <div class="value">@flat.OwnerName</div>
                                </div>
                                <div class="info-row">
                                    <div class="label">Status</div>
                                    @if (!string.IsNullOrEmpty(flat.TenantName))
                                    {
                                        <span class="flat-badge badge-tenant">
                                            <i class="bi bi-person-check"></i> @flat.TenantName
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="flat-badge badge-vacant">
                                            <i class="bi bi-house"></i> Vacant
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="alert-custom">
                    <i class="bi bi-info-circle-fill"></i>
                    <div>
                        <strong>No flats assigned yet</strong>
                        <p>Please contact the administrator to assign your flat ownership.</p>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Quick Stats -->
    <div class="row g-3 mb-4">
        <div class="col-lg-4 col-md-6">
            <div class="stat-card gradient-warning">
                <div class="icon">📝</div>
                <h3>@Model.PendingComplaints</h3>
                <p>Pending Complaints</p>
                <div class="status-text">Coming in Phase 5</div>
            </div>
        </div>
        <div class="col-lg-4 col-md-6">
            <div class="stat-card gradient-primary">
                <div class="icon">💳</div>
                <h3>@Model.PendingBills</h3>
                <p>Pending Bills</p>
                <div class="status-text">Coming in Phase 6</div>
            </div>
        </div>
        <div class="col-lg-4 col-md-12">
            <div class="stat-card gradient-info">
                <div class="icon">₹</div>
                <h3>₹@Model.TotalOutstanding.ToString("N2")</h3>
                <p>Total Outstanding</p>
                <div class="status-text">Coming in Phase 6</div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="section-card">
        <div class="section-header" style="background: var(--gradient-success);">
            <i class="bi bi-lightning-charge"></i> Quick Actions
        </div>
        <div class="card-body" style="padding: 1.5rem;">
            <div class="row g-3">
                <div class="col-lg-4 col-md-6">
                    <button class="btn btn-action w-100" disabled>
                        <i class="bi bi-file-text"></i> Raise Complaint (Phase 5)
                    </button>
                </div>
                <div class="col-lg-4 col-md-6">
                    <button class="btn btn-action w-100" disabled>
                        <i class="bi bi-credit-card"></i> Pay Bills (Phase 6)
                    </button>
                </div>
                <div class="col-lg-4 col-md-6">
                    <button class="btn btn-action w-100" disabled>
                        <i class="bi bi-door-open"></i> Manage Visitors (Phase 7)
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

*@









