@model ApartmentManagementSystem.Web.ViewModels.Dashboard.EnhancedDashboardViewModel
@{
    ViewData["Title"] = "Dashboard – Skyline";
    Layout = "_Layout";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap');

    :root {
        --page: #eef0f6;
        --card: #ffffff;
        --card-2: #f8f9fc;
        --border: #e2e6f0;
        --border-md: #c8cfe0;
        --ink-1: #0a0e1a;
        --ink-2: #1c2235;
        --ink-3: #3d4460;
        --ink-4: #6b7499;
        --ink-5: #9ba3be;
        --navy: #1e2a4a;
        --navy-deep: #111827;
        --indigo: #3730a3;
        --indigo-m: #4338ca;
        --indigo-lt: #eef0ff;
        --indigo-pale: #f5f3ff;
        --teal: #0d9488;
        --teal-lt: #f0fdfb;
        --teal-m: #14b8a6;
        --amber: #b45309;
        --amber-lt: #fef3c7;
        --rose: #be123c;
        --rose-lt: #fff1f2;
        --sky: #0369a1;
        --sky-lt: #e0f2fe;
        --violet: #6d28d9;
        --violet-lt: #ede9fe;
        --lime: #15803d;
        --lime-lt: #dcfce7;
        --emerald: #059669;
        --emerald-lt: #ecfdf5;
        --g-brand: linear-gradient(135deg, #3730a3 0%, #4f46e5 45%, #0d9488 100%);
        --g-navy: linear-gradient(135deg, #0f172a 0%, #1e2a4a 55%, #0f2027 100%);
        --g-indigo: linear-gradient(135deg, #3730a3 0%, #4338ca 100%);
        --g-teal: linear-gradient(135deg, #0d9488 0%, #0891b2 100%);
        --g-amber: linear-gradient(135deg, #d97706 0%, #b45309 100%);
        --g-rose: linear-gradient(135deg, #be123c 0%, #e11d48 100%);
        --g-sky: linear-gradient(135deg, #0369a1 0%, #0284c7 100%);
        --g-violet: linear-gradient(135deg, #6d28d9 0%, #7c3aed 100%);
        --g-lime: linear-gradient(135deg, #15803d 0%, #16a34a 100%);
        --s1: 0 2px 8px rgba(10,14,26,.06), 0 1px 3px rgba(10,14,26,.04);
        --s2: 0 8px 24px rgba(10,14,26,.09), 0 3px 10px rgba(10,14,26,.05);
        --s3: 0 20px 60px rgba(10,14,26,.15), 0 8px 24px rgba(10,14,26,.08);
        --s-hero: 0 24px 80px rgba(10,14,26,.22), 0 10px 30px rgba(10,14,26,.12);
        --r4: 8px;
        --r6: 12px;
        --r8: 16px;
        --r10: 20px;
        --r12: 24px;
        --r16: 32px;
        font-family: 'Sora', sans-serif;
    }

    *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    body {
        background: var(--page);
        color: var(--ink-1);
        font-family: 'Sora', sans-serif;
        font-size: 16px;
        -webkit-font-smoothing: antialiased;
    }

    /* ANIMATIONS*/
    @@keyframes riseIn {
        from {
            opacity: 0;
            transform: translateY(22px) scale(.97);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    @@keyframes pulseDot {
        0%, 100% {
            transform: scale(1);
            opacity: 1;
        }

        50% {
            transform: scale(1.6);
            opacity: .4;
        }
    }

    @@keyframes shimmer {
        0% {
            transform: translateX(-100%);
        }

        100% {
            transform: translateX(200%);
        }
    }

    @@keyframes slideModal {
        from {
            opacity: 0;
            transform: translateY(28px) scale(.95);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    .ri {
        animation: riseIn .55s cubic-bezier(.22,1,.36,1) both;
    }

    .ri-1 {
        animation-delay: .07s;
    }

    .ri-2 {
        animation-delay: .14s;
    }

    .ri-3 {
        animation-delay: .21s;
    }

    .ri-4 {
        animation-delay: .28s;
    }

    .ri-5 {
        animation-delay: .35s;
    }

     /*PAGE SHELL*/
    .dash-wrap {
        max-width: 1440px;
        margin: 0 auto;
        padding: 1.8rem 2.5rem 5rem;
    }

    /*HERO BANNER — compact */
    .hero {
        background: var(--g-navy);
        border-radius: var(--r12);
        padding: 2rem 2.8rem;
        margin-bottom: 2.2rem;
        position: relative;
        overflow: hidden;
        box-shadow: var(--s2);
        border: 1px solid rgba(255,255,255,.06);
    }

        .hero::before {
            content: '';
            position: absolute;
            width: 400px;
            height: 400px;
            top: -160px;
            right: 80px;
            background: radial-gradient(ellipse, rgba(67,56,202,.22) 0%, transparent 65%);
            pointer-events: none;
        }

        .hero::after {
            content: '';
            position: absolute;
            width: 260px;
            height: 260px;
            bottom: -100px;
            left: 3%;
            background: radial-gradient(ellipse, rgba(13,148,136,.15) 0%, transparent 65%);
            pointer-events: none;
        }

    .hero-grid {
        position: absolute;
        inset: 0;
        background-image: linear-gradient(rgba(255,255,255,.02) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.02) 1px, transparent 1px);
        background-size: 40px 40px;
        pointer-events: none;
    }

    .hero-content {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
    }

    /* Left */
    .hero-left {
        display: flex;
        align-items: center;
        gap: 1.4rem;
    }

    .hero-avatar {
        width: 62px;
        height: 62px;
        border-radius: 16px;
        background: linear-gradient(135deg, rgba(67,56,202,.55), rgba(13,148,136,.45));
        border: 1.5px solid rgba(255,255,255,.14);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.6rem;
        flex-shrink: 0;
    }

    .hero-text {
    }

    .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        background: rgba(67,56,202,.22);
        border: 1px solid rgba(99,102,241,.35);
        color: #a5b4fc;
        font-size: .78rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1.4px;
        padding: .32rem .95rem;
        border-radius: 30px;
        margin-bottom: .65rem;
    }

    .hero-title {
        font-size: 2rem;
        font-weight: 800;
        color: #fff;
        line-height: 1.2;
        letter-spacing: -.5px;
        margin-bottom: .6rem;
    }

        .hero-title .accent {
            background: linear-gradient(90deg, #818cf8 0%, #67e8f9 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

    .hero-meta-row {
        display: flex;
        align-items: center;
        gap: 1.2rem;
        flex-wrap: wrap;
    }

    .hero-meta-item {
        display: flex;
        align-items: center;
        gap: .35rem;
        font-size: .87rem;
        color: rgba(255,255,255,.45);
        font-weight: 500;
    }

        .hero-meta-item i {
            color: rgba(103,232,249,.55);
            font-size: .68rem;
        }

    .hero-role-pill {
        background: rgba(255,255,255,.07);
        border: 1px solid rgba(255,255,255,.12);
        color: rgba(255,255,255,.7);
        font-size: .82rem;
        font-weight: 600;
        padding: .32rem .95rem;
        border-radius: 30px;
    }

    /* Right */
    .hero-right {
        display: flex;
        align-items: center;
        gap: 1.8rem;
        position: relative;
        z-index: 2;
        flex-shrink: 0;
    }

    .clock-block {
        text-align: right;
    }

    .clock-time {
        font-family: 'JetBrains Mono', monospace;
        font-size: 1.85rem;
        font-weight: 600;
        color: #fff;
        letter-spacing: 2px;
        line-height: 1;
    }

    .clock-date-str {
        font-family: 'JetBrains Mono', monospace;
        font-size: .74rem;
        color: rgba(255,255,255,.3);
        letter-spacing: .5px;
        margin-top: .38rem;
    }

    .status-chips {
        display: flex;
        flex-direction: column;
        gap: .35rem;
    }

    .status-chip {
        display: flex;
        align-items: center;
        gap: .55rem;
        background: rgba(255,255,255,.06);
        border: 1px solid rgba(255,255,255,.08);
        border-radius: var(--r4);
        padding: .35rem .75rem;
    }

    .sc-label {
        font-size: .72rem;
        color: rgba(255,255,255,.35);
        font-weight: 500;
    }

    .sc-val {
        display: flex;
        align-items: center;
        gap: .3rem;
        font-family: 'JetBrains Mono', monospace;
        font-size: .7rem;
        font-weight: 600;
        color: #4ade80;
    }

    .sc-dot {
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: #4ade80;
        animation: pulseDot 2s ease-in-out infinite;
    }

    /*SECTION LABEL */
    .sec-row {
        display: flex;
        align-items: center;
        gap: .75rem;
        margin-bottom: 1.3rem;
    }

    .sec-bar {
        width: 4px;
        height: 24px;
        border-radius: 3px;
        background: var(--g-brand);
        flex-shrink: 0;
    }

    .sec-text {
        font-size: .82rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1.8px;
        color: var(--ink-3);
    }

    /*SECTION WRAPPER*/
    .section {
        margin-bottom: 2.8rem;
    }

    /* QUICK ACTIONS — larger tiles */
    .qa-grid {
        display: grid;
        grid-template-columns: repeat(6, 1fr);
        gap: 1rem;
    }

    .qa-tile {
        background: var(--card);
        border: 1.5px solid var(--border);
        border-radius: var(--r8);
        padding: 2.2rem 1rem 2rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
        text-decoration: none;
        color: var(--ink-2);
        font-weight: 700;
        font-size: 1.05rem;
        cursor: pointer;
        transition: all .25s cubic-bezier(.34,1.56,.64,1);
        box-shadow: var(--s1);
        position: relative;
        overflow: hidden;
        text-align: center;
        font-family: 'Sora', sans-serif;
    }

        .qa-tile::before {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            height: 3px;
            border-radius: 0 0 var(--r8) var(--r8);
            transform: scaleX(0);
            transform-origin: left;
            transition: transform .28s ease;
        }

        .qa-tile:hover {
            border-color: transparent;
            box-shadow: var(--s2);
            transform: translateY(-6px);
        }

            .qa-tile:hover::before {
                transform: scaleX(1);
            }

        .qa-tile.qt-indigo::before {
            background: var(--g-indigo);
        }

        .qa-tile.qt-teal::before {
            background: var(--g-teal);
        }

        .qa-tile.qt-sky::before {
            background: var(--g-sky);
        }

        .qa-tile.qt-amber::before {
            background: var(--g-amber);
        }

        .qa-tile.qt-violet::before {
            background: var(--g-violet);
        }

        .qa-tile.qt-rose::before {
            background: var(--g-rose);
        }

    .qa-icon {
        width: 70px;
        height: 70px;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.75rem;
        transition: transform .25s cubic-bezier(.34,1.56,.64,1);
    }

    .qa-tile:hover .qa-icon {
        transform: scale(1.15) rotate(-6deg);
    }

    .ico-indigo {
        background: var(--indigo-lt);
        color: var(--indigo-m);
    }

    .ico-teal {
        background: var(--teal-lt);
        color: var(--teal);
    }

    .ico-sky {
        background: var(--sky-lt);
        color: var(--sky);
    }

    .ico-amber {
        background: var(--amber-lt);
        color: var(--amber);
    }

    .ico-violet {
        background: var(--violet-lt);
        color: var(--violet);
    }

    .ico-rose {
        background: var(--rose-lt);
        color: var(--rose);
    }

    /* PORTFOLIO STRIP — SuperAdmin*/
    .portfolio {
        background: var(--g-navy);
        border-radius: var(--r10);
        overflow: hidden;
        box-shadow: var(--s2);
        position: relative;
    }

        .portfolio::before {
            content: '';
            position: absolute;
            top: -100px;
            right: 20px;
            width: 320px;
            height: 320px;
            background: radial-gradient(ellipse, rgba(67,56,202,.25) 0%, transparent 65%);
            pointer-events: none;
        }

    .pf-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1.5rem 2rem;
        border-bottom: 1px solid rgba(255,255,255,.08);
        position: relative;
        z-index: 1;
    }

    .pf-title {
        font-size: 1.05rem;
        font-weight: 700;
        color: rgba(255,255,255,.9);
        display: flex;
        align-items: center;
        gap: .5rem;
    }

        .pf-title i {
            color: #67e8f9;
        }

    .pf-btn {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        background: rgba(103,232,249,.13);
        border: 1px solid rgba(103,232,249,.28);
        color: #67e8f9;
        font-size: .77rem;
        font-weight: 600;
        padding: .5rem 1.2rem;
        border-radius: var(--r4);
        text-decoration: none;
        font-family: 'Sora', sans-serif;
        transition: all .2s;
    }

        .pf-btn:hover {
            background: rgba(103,232,249,.22);
            color: #a5f3fc;
        }

    .pf-stats {
        display: grid;
        grid-template-columns: repeat(4,1fr);
        position: relative;
        z-index: 1;
    }

    .pf-stat {
        padding: 2.2rem 2.2rem;
        border-right: 1px solid rgba(255,255,255,.07);
        transition: background .18s;
        cursor: default;
    }

        .pf-stat:last-child {
            border-right: none;
        }

        .pf-stat:hover {
            background: rgba(255,255,255,.04);
        }

    .pf-stat-icon {
        font-size: 1.1rem;
        color: rgba(255,255,255,.2);
        margin-bottom: .7rem;
        display: block;
    }

    .pf-stat-num {
        font-family: 'JetBrains Mono', monospace;
        font-size: 2.8rem;
        font-weight: 700;
        color: #fff;
        line-height: 1;
        margin-bottom: .4rem;
        letter-spacing: -1.5px;
    }

    .pf-stat-label {
        font-size: .78rem;
        font-weight: 600;
        color: rgba(255,255,255,.35);
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    /* METRICS GRID — 3 col, big cards*/
    .metrics-grid {
        display: grid;
        grid-template-columns: repeat(3,1fr);
        gap: 1.2rem;
    }

    .metric-card {
        background: var(--card);
        border: 1.5px solid var(--border);
        border-radius: var(--r10);
        overflow: hidden;
        box-shadow: var(--s1);
        transition: all .26s ease;
    }

        .metric-card:hover {
            box-shadow: var(--s2);
            transform: translateY(-4px);
            border-color: transparent;
        }

    .mc-accent-bar {
        height: 4px;
    }

    .metric-card.mc-indigo .mc-accent-bar {
        background: var(--g-indigo);
    }

    .metric-card.mc-amber .mc-accent-bar {
        background: var(--g-amber);
    }

    .metric-card.mc-teal .mc-accent-bar {
        background: var(--g-teal);
    }

    .metric-card.mc-sky .mc-accent-bar {
        background: var(--g-sky);
    }

    .metric-card.mc-violet .mc-accent-bar {
        background: var(--g-violet);
    }

    .metric-card.mc-lime .mc-accent-bar {
        background: var(--g-lime);
    }

    .mc-body {
        padding: 2.1rem 2.1rem 2rem;
    }

    .mc-row-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.4rem;
    }

    .mc-label {
        font-size: .82rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1.2px;
        color: var(--ink-4);
    }

    .mc-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
    }

    .metric-card.mc-indigo .mc-icon {
        background: var(--indigo-lt);
        color: var(--indigo-m);
    }

    .metric-card.mc-amber .mc-icon {
        background: var(--amber-lt);
        color: var(--amber);
    }

    .metric-card.mc-teal .mc-icon {
        background: var(--teal-lt);
        color: var(--teal);
    }

    .metric-card.mc-sky .mc-icon {
        background: var(--sky-lt);
        color: var(--sky);
    }

    .metric-card.mc-violet .mc-icon {
        background: var(--violet-lt);
        color: var(--violet);
    }

    .metric-card.mc-lime .mc-icon {
        background: var(--lime-lt);
        color: var(--lime);
    }

    .mc-value {
        font-family: 'JetBrains Mono', monospace;
        font-size: 3.8rem;
        font-weight: 700;
        color: var(--ink-1);
        line-height: 1;
        letter-spacing: -2px;
        margin-bottom: .65rem;
    }

    .mc-sub {
        font-size: .86rem;
        color: var(--ink-5);
        display: flex;
        align-items: center;
        gap: .3rem;
        margin-bottom: .2rem;
    }

        .mc-sub i {
            font-size: .5rem;
        }

    .mc-link {
        display: inline-flex;
        align-items: center;
        gap: .3rem;
        margin-top: 1rem;
        font-size: .84rem;
        font-weight: 700;
        text-decoration: none;
        transition: gap .2s ease;
        letter-spacing: .2px;
    }

        .mc-link:hover {
            gap: .55rem;
        }

    .metric-card.mc-indigo .mc-link {
        color: var(--indigo-m);
    }

    .metric-card.mc-amber .mc-link {
        color: var(--amber);
    }

    .metric-card.mc-teal .mc-link {
        color: var(--teal);
    }

    .metric-card.mc-sky .mc-link {
        color: var(--sky);
    }

    .metric-card.mc-violet .mc-link {
        color: var(--violet);
    }

    .metric-card.mc-lime .mc-link {
        color: var(--lime);
    }   
       /*BOTTOM ROW: Financial + Module Status*/
    .bottom-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.2rem;
        align-items: stretch;
    }

    .col-stretch {
        display: flex;
        flex-direction: column;
    }

        .col-stretch .fin-card,
        .col-stretch .mod-card {
            flex: 1;
        }

    /* Financial card */
    .fin-card {
        background: var(--card);
        border: 1.5px solid var(--border);
        border-radius: var(--r10);
        overflow: hidden;
        box-shadow: var(--s1);
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .fin-header {
        background: var(--g-navy);
        padding: 1.3rem 1.8rem;
        display: flex;
        align-items: center;
        gap: .5rem;
    }

    .fin-header-title {
        font-size: 1rem;
        font-weight: 700;
        color: rgba(255,255,255,.9);
        display: flex;
        align-items: center;
        gap: .45rem;
    }

        .fin-header-title i {
            color: #67e8f9;
        }

    .fin-body {
        padding: 1.6rem;
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .fin-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1.2rem 1.4rem;
        border-radius: var(--r6);
        border: 1.5px solid var(--border);
        margin-bottom: .9rem;
        transition: border-color .18s, box-shadow .18s;
    }

        .fin-row:last-of-type {
            margin-bottom: 0;
        }

        .fin-row:hover {
            border-color: var(--border-md);
            box-shadow: var(--s1);
        }

    .fin-row-label {
        font-size: .82rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .9px;
        color: var(--ink-4);
        margin-bottom: .4rem;
    }

    .fin-row-val {
        font-family: 'JetBrains Mono', monospace;
        font-size: 1.9rem;
        font-weight: 700;
        letter-spacing: -0.5px;
    }

        .fin-row-val.outstanding {
            color: var(--rose);
        }

        .fin-row-val.collected {
            color: var(--teal);
        }

    .fin-icon {
        width: 50px;
        height: 50px;
        border-radius: var(--r4);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
    }

    .fin-cta {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: .45rem;
        margin-top: auto;
        padding-top: 1rem;
        padding: .8rem;
        background: var(--indigo-pale);
        border-radius: var(--r6);
        font-size: .8rem;
        font-weight: 700;
        color: var(--indigo-m);
        text-decoration: none;
        transition: all .2s;
        border: 1.5px solid transparent;
        letter-spacing: .2px;
    }

        .fin-cta:hover {
            background: var(--indigo-m);
            color: #fff;
        }

    /* Module list */
    .mod-card {
        background: var(--card);
        border: 1.5px solid var(--border);
        border-radius: var(--r10);
        overflow: hidden;
        box-shadow: var(--s1);
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .mod-header {
        padding: 1.2rem 1.8rem;
        border-bottom: 1px solid var(--border);
        display: flex;
        align-items: center;
        gap: .5rem;
        font-size: .95rem;
        font-weight: 700;
        color: var(--ink-2);
    }

        .mod-header i {
            color: var(--indigo-m);
        }

    .mod-item {
        display: flex;
        align-items: center;
        gap: 1.1rem;
        padding: 1.5rem 1.8rem;
        border-bottom: 1px solid var(--border);
        transition: background .15s;
        flex: 1;
    }

        .mod-item:last-child {
            border-bottom: none;
        }

        .mod-item:hover {
            background: var(--card-2);
        }

    .mod-item-icon {
        width: 52px;
        height: 52px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        flex-shrink: 0;
    }

    .mod-item-info {
        flex: 1;
        min-width: 0;
    }

    .mod-item-name {
        font-size: .98rem;
        font-weight: 700;
        color: var(--ink-2);
        margin-bottom: .28rem;
    }

    .mod-item-desc {
        font-size: .83rem;
        color: var(--ink-5);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .mod-item-right {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: .25rem;
    }

    .mod-item-num {
        font-family: 'JetBrains Mono', monospace;
        font-size: 1.2rem;
        font-weight: 700;
        color: var(--ink-1);
    }

    .mod-item-badge {
        font-size: .68rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .7px;
        padding: .22rem .6rem;
        border-radius: 20px;
        background: var(--card-2);
        color: var(--ink-5);
        border: 1px solid var(--border);
    }

    /* ═══════════════════════════════════════════════
       ACTIVITY TABLE
    ═══════════════════════════════════════════════ */
    .act-card {
        background: var(--card);
        border: 1.5px solid var(--border);
        border-radius: var(--r10);
        overflow: hidden;
        box-shadow: var(--s1);
    }

    .act-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1.2rem 1.8rem;
        border-bottom: 1px solid var(--border);
    }

    .act-header-title {
        font-size: 1.05rem;
        font-weight: 700;
        color: var(--ink-2);
        display: flex;
        align-items: center;
        gap: .45rem;
    }

        .act-header-title i {
            color: var(--indigo-m);
        }

    .act-count-badge {
        font-family: 'JetBrains Mono', monospace;
        background: var(--indigo-lt);
        color: var(--indigo-m);
        font-size: .67rem;
        font-weight: 700;
        padding: .25rem .65rem;
        border-radius: 20px;
    }

    .act-table {
        width: 100%;
        border-collapse: collapse;
    }

        .act-table thead th {
            font-size: .72rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1.1px;
            color: var(--ink-5);
            padding: .85rem 1.8rem;
            background: var(--card-2);
            border-bottom: 1px solid var(--border);
            text-align: left;
        }

        .act-table tbody td {
            padding: 1.15rem 1.8rem;
            font-size: .92rem;
            color: var(--ink-3);
            border-bottom: 1px solid var(--border);
            transition: background .12s;
        }

        .act-table tbody tr:last-child td {
            border-bottom: none;
        }

        .act-table tbody tr:hover td {
            background: var(--card-2);
        }

    .type-badge {
        display: inline-block;
        padding: .28rem .75rem;
        border-radius: 20px;
        font-size: .76rem;
        font-weight: 700;
        background: var(--indigo-lt);
        color: var(--indigo-m);
        letter-spacing: .2px;
    }

    .mono-time {
        font-family: 'JetBrains Mono', monospace;
        font-size: .71rem;
        color: var(--ink-5);
    }

    /* ═══════════════════════════════════════════════
       MODAL
    ═══════════════════════════════════════════════ */
    .modal-veil {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(10,14,26,.7);
        backdrop-filter: blur(10px);
        z-index: 9999;
        align-items: center;
        justify-content: center;
    }

        .modal-veil.active {
            display: flex;
        }

    .modal-box {
        background: var(--card);
        border-radius: var(--r12);
        box-shadow: var(--s3);
        width: 92%;
        max-width: 440px;
        overflow: hidden;
        animation: slideModal .32s cubic-bezier(.22,1,.36,1) both;
    }

    .modal-hd {
        background: var(--g-navy);
        padding: 1.5rem 1.8rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .modal-hd-title {
        font-size: .95rem;
        font-weight: 700;
        color: #fff;
        display: flex;
        align-items: center;
        gap: .45rem;
    }

        .modal-hd-title i {
            color: #67e8f9;
        }

    .modal-close {
        width: 30px;
        height: 30px;
        background: rgba(255,255,255,.09);
        border: 1px solid rgba(255,255,255,.13);
        border-radius: var(--r4);
        color: rgba(255,255,255,.55);
        font-size: .88rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all .15s;
    }

        .modal-close:hover {
            background: rgba(255,255,255,.2);
            color: #fff;
        }

    .modal-bd {
        padding: 1.8rem;
    }

        .modal-bd label {
            display: block;
            font-size: .68rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1.1px;
            color: var(--ink-4);
            margin-bottom: .6rem;
        }

    .modal-sel {
        width: 100%;
        padding: .85rem 1.1rem;
        border: 1.5px solid var(--border-md);
        border-radius: var(--r6);
        font-size: .9rem;
        font-family: 'Sora', sans-serif;
        color: var(--ink-2);
        background: var(--card-2);
        appearance: none;
        outline: none;
        transition: border-color .18s, box-shadow .18s;
    }

        .modal-sel:focus {
            border-color: var(--indigo-m);
            box-shadow: 0 0 0 3px rgba(67,56,202,.1);
        }

    .modal-ft {
        padding: 1.1rem 1.8rem;
        border-top: 1px solid var(--border);
        display: flex;
        justify-content: flex-end;
        gap: .6rem;
    }

    .btn-cancel {
        background: var(--card-2);
        border: 1.5px solid var(--border-md);
        color: var(--ink-4);
        padding: .65rem 1.3rem;
        border-radius: var(--r4);
        font-size: .82rem;
        font-weight: 600;
        cursor: pointer;
        font-family: 'Sora', sans-serif;
        transition: all .15s;
    }

        .btn-cancel:hover {
            border-color: var(--ink-4);
            color: var(--ink-2);
        }

    .btn-confirm {
        background: var(--g-indigo);
        border: none;
        color: #fff;
        padding: .65rem 1.4rem;
        border-radius: var(--r4);
        font-size: .82rem;
        font-weight: 700;
        cursor: pointer;
        font-family: 'Sora', sans-serif;
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        transition: opacity .15s, transform .15s;
    }

        .btn-confirm:hover {
            opacity: .88;
            transform: translateY(-1px);
        }

    /* ═══════════════════════════════════════════════
       RESPONSIVE
    ═══════════════════════════════════════════════ */
    @@media (max-width: 1100px) {
        .metrics-grid {
            grid-template-columns: repeat(2,1fr);
        }

        .pf-stats {
            grid-template-columns: repeat(2,1fr);
        }

        .bottom-row {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 768px) {
        .dash-wrap {
            padding: 0 1rem 4rem;
        }

        .hero {
            padding: 1.2rem 1.3rem;
        }

        .hero-content {
            flex-direction: column;
            align-items: flex-start;
            gap: 1rem;
        }

        .hero-right {
            display: none;
        }

        .hero-title {
            font-size: 1.3rem;
        }

        .metrics-grid {
            grid-template-columns: 1fr 1fr;
        }

        .qa-grid {
            grid-template-columns: repeat(3,1fr);
        }

        .pf-stats {
            grid-template-columns: repeat(2,1fr);
        }
    }

    @@media (max-width: 520px) {
        .metrics-grid {
            grid-template-columns: 1fr;
        }

        .qa-grid {
            grid-template-columns: repeat(2,1fr);
        }
    }
</style>

<!-- ═══════════════════════════════════════════════
     PAGE
═══════════════════════════════════════════════ -->
<div class="dash-wrap">

    <!-- ── HERO ── -->
    <div class="hero ri">
        <div class="hero-grid"></div>
        <div class="hero-content">

            <!-- Left: avatar + text -->
            <div class="hero-left">
                <div class="hero-avatar">🏢</div>
                <div class="hero-text">
                    <div class="hero-badge">
                        <i class="bi bi-shield-fill-check"></i> Skyline Admin Console
                    </div>
                    <h1 class="hero-title">
                        Welcome back, <span class="accent">@Model.FullName</span> 👋
                    </h1>
                    <div class="hero-meta-row">
                        @if (Model.AllRoles.Any())
                        {
                            @foreach (var role in Model.AllRoles)
                            {
                                <span class="hero-role-pill">@role</span>
                            }
                        }
                        else
                        {
                            <span class="hero-role-pill">@Model.Role</span>
                        }
                        <div class="hero-meta-item">
                            <i class="bi bi-calendar3"></i>
                            <span id="heroDate">—</span>
                        </div>
                        <div class="hero-meta-item">
                            <i class="bi bi-geo-alt-fill"></i>
                            <span>Skyline HQ</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right: clock + status -->
            <div class="hero-right">
                <div class="clock-block">
                    <div class="clock-time" id="clockTime">—</div>
                    <div class="clock-date-str" id="clockDate">—</div>
                </div>
                <div class="status-chips">
                    <div class="status-chip">
                        <span class="sc-label">System</span>
                        <span class="sc-val"><span class="sc-dot"></span>Online</span>
                    </div>
                    <div class="status-chip">
                        <span class="sc-label">DB</span>
                        <span class="sc-val">Connected</span>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <!-- ── QUICK ACTIONS ── -->
    <div class="section ri ri-1">
        <div class="sec-row">
            <div class="sec-bar"></div>
            <span class="sec-text">Quick Actions</span>
        </div>
        <div class="qa-grid">
            @if (User.IsInRole("SuperAdmin"))
            {
                <a href="@Url.Action("ManageApartments", "ApartmentBuilder")" class="qa-tile qt-indigo">
                    <div class="qa-icon ico-indigo"><i class="bi bi-buildings-fill"></i></div>
                    My Apartments
                </a>
                <a href="@Url.Action("Create", "ApartmentBuilder")" class="qa-tile qt-teal">
                    <div class="qa-icon ico-teal"><i class="bi bi-building-add"></i></div>
                    New Apartment
                </a>
            }
            <a href="@Url.Action("Create", "Onboarding")" class="qa-tile qt-sky">
                <div class="qa-icon ico-sky"><i class="bi bi-person-plus-fill"></i></div>
                Onboard Resident
            </a>
            <button class="qa-tile qt-amber" onclick="openModal()">
                <div class="qa-icon ico-amber"><i class="bi bi-award-fill"></i></div>
                Community
            </button>
            <a href="@Url.Action("Index", "StaffMembers")" class="qa-tile qt-violet">
                <div class="qa-icon ico-violet"><i class="bi bi-person-badge-fill"></i></div>
                Staff Members
            </a>
            <a href="@Url.Action("Index", "ResidentManagement")" class="qa-tile qt-rose">
                <div class="qa-icon ico-rose"><i class="bi bi-house-door-fill"></i></div>
                All Residents
            </a>
        </div>
    </div>

    <!-- ── PORTFOLIO (SuperAdmin) ── -->
    @if (User.IsInRole("SuperAdmin") && Model.Stats.TotalApartments.HasValue)
    {
        <div class="section ri ri-2">
            <div class="sec-row">
                <div class="sec-bar"></div>
                <span class="sec-text">Apartment Portfolio</span>
            </div>
            <div class="portfolio">
                <div class="pf-header">
                    <div class="pf-title">
                        <i class="bi bi-buildings-fill"></i> Portfolio Overview
                    </div>
                    <a href="@Url.Action("ManageApartments", "ApartmentBuilder")" class="pf-btn">
                        <i class="bi bi-gear-fill"></i> Manage All
                    </a>
                </div>
                <div class="pf-stats">
                    <div class="pf-stat">
                        <i class="bi bi-building pf-stat-icon"></i>
                        <div class="pf-stat-num">@Model.Stats.TotalApartments</div>
                        <div class="pf-stat-label">Total Buildings</div>
                    </div>
                    <div class="pf-stat">
                        <i class="bi bi-check-circle-fill pf-stat-icon"></i>
                        <div class="pf-stat-num">@Model.Stats.ActiveApartments</div>
                        <div class="pf-stat-label">Active</div>
                    </div>
                    <div class="pf-stat">
                        <i class="bi bi-layers-fill pf-stat-icon"></i>
                        <div class="pf-stat-num">@Model.Stats.TotalFloors</div>
                        <div class="pf-stat-label">Total Floors</div>
                    </div>
                    <div class="pf-stat">
                        <i class="bi bi-person-badge-fill pf-stat-icon"></i>
                        <div class="pf-stat-num">@Model.Stats.TotalManagers</div>
                        <div class="pf-stat-label">Managers</div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- ── KEY METRICS ── -->
    <div class="section ri ri-3">
        <div class="sec-row">
            <div class="sec-bar"></div>
            <span class="sec-text">Key Metrics</span>
        </div>
        <div class="metrics-grid">

            <div class="metric-card mc-indigo">
                <div class="mc-accent-bar"></div>
                <div class="mc-body">
                    <div class="mc-row-top">
                        <span class="mc-label">Total Residents</span>
                        <div class="mc-icon"><i class="bi bi-people-fill"></i></div>
                    </div>
                    <div class="mc-value">@Model.Stats.TotalResidents</div>
                    <div class="mc-sub"><i class="bi bi-circle-fill"></i> Active users in system</div>
                </div>
            </div>

            <div class="metric-card mc-amber">
                <div class="mc-accent-bar"></div>
                <div class="mc-body">
                    <div class="mc-row-top">
                        <span class="mc-label">Pending Registrations</span>
                        <div class="mc-icon"><i class="bi bi-hourglass-split"></i></div>
                    </div>
                    <div class="mc-value">@Model.Stats.PendingRegistrations</div>
                    <div class="mc-sub"><i class="bi bi-circle-fill"></i> Awaiting approval</div>
                    <a href="@Url.Action("Pending", "AdminResidents")" class="mc-link">
                        Review now <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>

            <div class="metric-card mc-teal">
                <div class="mc-accent-bar"></div>
                <div class="mc-body">
                    <div class="mc-row-top">
                        <span class="mc-label">Total Flats</span>
                        <div class="mc-icon"><i class="bi bi-building"></i></div>
                    </div>
                    <div class="mc-value">@Model.Stats.TotalFlats</div>
                    <div class="mc-sub"><i class="bi bi-circle-fill"></i> @Model.Stats.OccupiedFlats occupied</div>
                </div>
            </div>

            <div class="metric-card mc-sky">
                <div class="mc-accent-bar"></div>
                <div class="mc-body">
                    <div class="mc-row-top">
                        <span class="mc-label">Vacant Flats</span>
                        <div class="mc-icon"><i class="bi bi-house"></i></div>
                    </div>
                    <div class="mc-value">@Model.Stats.VacantFlats</div>
                    <div class="mc-sub"><i class="bi bi-circle-fill"></i> Available for assignment</div>
                </div>
            </div>

            <div class="metric-card mc-violet">
                <div class="mc-accent-bar"></div>
                <div class="mc-body">
                    <div class="mc-row-top">
                        <span class="mc-label">Staff Members</span>
                        <div class="mc-icon"><i class="bi bi-person-badge-fill"></i></div>
                    </div>
                    <div class="mc-value">@Model.Stats.TotalStaffMembers</div>
                    <div class="mc-sub"><i class="bi bi-circle-fill"></i> @Model.Stats.ActiveStaffMembers active</div>
                </div>
            </div>

            <div class="metric-card mc-lime">
                <div class="mc-accent-bar"></div>
                <div class="mc-body">
                    <div class="mc-row-top">
                        <span class="mc-label">Community Members</span>
                        <div class="mc-icon"><i class="bi bi-award-fill"></i></div>
                    </div>
                    <div class="mc-value">@Model.Stats.CommunityMembers</div>
                    <div class="mc-sub"><i class="bi bi-circle-fill"></i> President · Secretary · Treasurer</div>
                </div>
            </div>

        </div>
    </div>

    <!-- ── FINANCIAL + MODULE STATUS ── -->
    <div class="section ri ri-4">
        @if ((User.IsInRole("SuperAdmin") || User.IsInRole("Treasurer")) && Model.FinancialSummary != null)
        {
            <div class="bottom-row">
                <!-- Financial -->
                <div class="col-stretch">
                    <div class="sec-row">
                        <div class="sec-bar"></div>
                        <span class="sec-text">Financial Summary</span>
                    </div>
                    <div class="fin-card">
                        <div class="fin-header">
                            <div class="fin-header-title">
                                <i class="bi bi-currency-rupee"></i> Financial Overview
                            </div>
                        </div>
                        <div class="fin-body">
                            <div class="fin-row">
                                <div>
                                    <div class="fin-row-label">Total Outstanding</div>
                                    <div class="fin-row-val outstanding">₹@Model.FinancialSummary.TotalOutstanding.ToString("N2")</div>
                                </div>
                                <div class="fin-icon" style="background:var(--rose-lt);color:var(--rose);">
                                    <i class="bi bi-exclamation-circle-fill" style="font-size:1.2rem;"></i>
                                </div>
                            </div>
                            <div class="fin-row">
                                <div>
                                    <div class="fin-row-label">Collected This Month</div>
                                    <div class="fin-row-val collected">₹@Model.FinancialSummary.CollectedThisMonth.ToString("N2")</div>
                                </div>
                                <div class="fin-icon" style="background:var(--teal-lt);color:var(--teal);">
                                    <i class="bi bi-check-circle-fill" style="font-size:1.2rem;"></i>
                                </div>
                            </div>
                            <a href="#" class="fin-cta">
                                <i class="bi bi-graph-up-arrow"></i> View Full Reports
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Modules -->
                <div class="col-stretch">
                    <div class="sec-row">
                        <div class="sec-bar"></div>
                        <span class="sec-text">Module Status</span>
                    </div>
                    <div class="mod-card">
                        <div class="mod-header">
                            <i class="bi bi-grid-fill"></i> Coming Phases
                        </div>
                        <div class="mod-item">
                            <div class="mod-item-icon" style="background:var(--amber-lt);color:var(--amber);"><i class="bi bi-clipboard-check-fill"></i></div>
                            <div class="mod-item-info">
                                <div class="mod-item-name">Complaints Management</div>
                                <div class="mod-item-desc">Track &amp; resolve resident complaints</div>
                            </div>
                            <div class="mod-item-right">
                                <div class="mod-item-num">@Model.Stats.PendingComplaints</div>
                                <div class="mod-item-badge">Phase 5</div>
                            </div>
                        </div>
                        <div class="mod-item">
                            <div class="mod-item-icon" style="background:var(--sky-lt);color:var(--sky);"><i class="bi bi-receipt-cutoff"></i></div>
                            <div class="mod-item-info">
                                <div class="mod-item-name">Billing &amp; Payments</div>
                                <div class="mod-item-desc">Manage maintenance &amp; utility bills</div>
                            </div>
                            <div class="mod-item-right">
                                <div class="mod-item-num" style="font-size:.85rem;">₹@Model.Stats.TotalOutstandingBills.ToString("N0")</div>
                                <div class="mod-item-badge">Phase 6</div>
                            </div>
                        </div>
                        <div class="mod-item">
                            <div class="mod-item-icon" style="background:var(--lime-lt);color:var(--lime);"><i class="bi bi-calendar-event-fill"></i></div>
                            <div class="mod-item-info">
                                <div class="mod-item-name">Visitor Management</div>
                                <div class="mod-item-desc">Security: @Model.Stats.ActiveSecurityPersonnel on duty</div>
                            </div>
                            <div class="mod-item-right">
                                <div class="mod-item-num">@Model.Stats.TodaysVisitors</div>
                                <div class="mod-item-badge">Phase 7</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="sec-row">
                <div class="sec-bar"></div>
                <span class="sec-text">Module Status</span>
            </div>
            <div class="mod-card">
                <div class="mod-header"><i class="bi bi-grid-fill"></i> Coming Phases</div>
                <div class="mod-item">
                    <div class="mod-item-icon" style="background:var(--amber-lt);color:var(--amber);"><i class="bi bi-clipboard-check-fill"></i></div>
                    <div class="mod-item-info"><div class="mod-item-name">Complaints Management</div><div class="mod-item-desc">Track &amp; resolve resident complaints</div></div>
                    <div class="mod-item-right"><div class="mod-item-num">@Model.Stats.PendingComplaints</div><div class="mod-item-badge">Phase 5</div></div>
                </div>
                <div class="mod-item">
                    <div class="mod-item-icon" style="background:var(--sky-lt);color:var(--sky);"><i class="bi bi-receipt-cutoff"></i></div>
                    <div class="mod-item-info"><div class="mod-item-name">Billing &amp; Payments</div><div class="mod-item-desc">Manage maintenance &amp; utility bills</div></div>
                    <div class="mod-item-right"><div class="mod-item-num" style="font-size:.85rem;">₹@Model.Stats.TotalOutstandingBills.ToString("N0")</div><div class="mod-item-badge">Phase 6</div></div>
                </div>
                <div class="mod-item">
                    <div class="mod-item-icon" style="background:var(--lime-lt);color:var(--lime);"><i class="bi bi-calendar-event-fill"></i></div>
                    <div class="mod-item-info"><div class="mod-item-name">Visitor Management</div><div class="mod-item-desc">Security: @Model.Stats.ActiveSecurityPersonnel on duty</div></div>
                    <div class="mod-item-right"><div class="mod-item-num">@Model.Stats.TodaysVisitors</div><div class="mod-item-badge">Phase 7</div></div>
                </div>
            </div>
        }
    </div>

    <!-- ── RECENT ACTIVITY ── -->
    @if (Model.RecentActivities != null && Model.RecentActivities.Any())
    {
        <div class="section ri ri-5">
            <div class="sec-row">
                <div class="sec-bar"></div>
                <span class="sec-text">Recent Activity</span>
            </div>
            <div class="act-card">
                <div class="act-header">
                    <div class="act-header-title">
                        <i class="bi bi-clock-history"></i> Activity Log
                    </div>
                    <span class="act-count-badge">LAST @Math.Min(Model.RecentActivities.Count(), 10)</span>
                </div>
                <table class="act-table">
                    <thead>
                        <tr>
                            <th>Activity</th>
                            <th>Type</th>
                            <th>Timestamp</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in Model.RecentActivities.Take(10))
                        {
                            <tr>
                                <td>@a.Activity</td>
                                <td><span class="type-badge">@a.Type</span></td>
                                <td class="mono-time">@a.Timestamp.ToString("dd MMM yyyy · hh:mm tt")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

</div><!-- /dash-wrap -->
<!-- ── MODAL ── -->
<div class="modal-veil" id="aptModal" onclick="handleVeil(event)">
    <div class="modal-box">
        <div class="modal-hd">
            <div class="modal-hd-title">
                <i class="bi bi-building"></i> Select Apartment
            </div>
            <button class="modal-close" onclick="closeModal()"><i class="bi bi-x-lg"></i></button>
        </div>
        <div class="modal-bd">
            <label>Apartment for community members</label>
            <select class="modal-sel" id="aptSelect">
                <option value="">— Choose an apartment —</option>
            </select>
        </div>
        <div class="modal-ft">
            <button class="btn-cancel" onclick="closeModal()">Cancel</button>
            <button class="btn-confirm" onclick="goCommunity()">
                Continue <i class="bi bi-arrow-right"></i>
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        /* ── Clock ── */
        function tick() {
          const n   = new Date();
          const pad = v => String(v).padStart(2,'0');
          const h = n.getHours(), m = n.getMinutes(), s = n.getSeconds();
          const ampm = h >= 12 ? 'PM' : 'AM';
          const hr12 = h % 12 || 12;
          const time = `${pad(hr12)}:${pad(m)}:${pad(s)} ${ampm}`;
          const days   = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
          const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
          const date   = `${days[n.getDay()]}, ${pad(n.getDate())} ${months[n.getMonth()]} ${n.getFullYear()}`;

          const el = id => document.getElementById(id);
          if (el('clockTime')) el('clockTime').textContent = time;
          if (el('clockDate')) el('clockDate').textContent = date;
          if (el('heroDate'))  el('heroDate').textContent  = date;
        }
        tick(); setInterval(tick, 1000);

        /* ── Modal ── */
        async function openModal() {
          try {
            const res  = await fetch('/api/ApartmentManagement/all');
            const data = await res.json();
            const sel  = document.getElementById('aptSelect');
            sel.innerHTML = '<option value="">— Choose an apartment —</option>';
            if (data?.success && data.data?.length > 0) {
              data.data.forEach(a => {
                const o = document.createElement('option');
                o.value = a.id; o.textContent = a.name;
                sel.appendChild(o);
              });
              document.getElementById('aptModal').classList.add('active');
            } else {
              alert('No apartments found. Please create one first.');
            }
          } catch (e) {
            console.error(e);
            alert('Failed to load apartments.');
          }
        }

        function closeModal() { document.getElementById('aptModal').classList.remove('active'); }
        function handleVeil(e) { if (e.target === document.getElementById('aptModal')) closeModal(); }

        function goCommunity() {
          const id = document.getElementById('aptSelect').value;
          if (!id) { alert('Please select an apartment.'); return; }
          window.location.href = `/Community/Index?apartmentId=${id}`;
        }
    </script>
}


