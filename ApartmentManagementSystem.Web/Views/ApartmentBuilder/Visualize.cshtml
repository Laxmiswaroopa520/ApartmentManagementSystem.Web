        .flats-row {
            flex: 1;
            display: flex;
            gap: 1rem;
            flex-wrap: wrap;
        }

        .flat-box {
            flex: 1;
            min-width: 90px;
            aspect-ratio: 1;
            background: #1a1f3a;
            border: 2px solid #3d4575;
