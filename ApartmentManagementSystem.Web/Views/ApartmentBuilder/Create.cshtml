@{
    ViewData["Title"] = "Create New Apartment";
}

@section Styles {
    <link rel="stylesheet" href="~/css/apartment-builder.css" asp-append-version="true" />
}

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>

<div class="ab-wrap">

    <div class="ab-header">
        <h1 class="ab-title"><i class="fas fa-building"></i> Create New Apartment Building</h1>
        <p class="ab-subtitle">Design your apartment complex with custom floors and flats</p>
    </div>

    <!-- Step Indicator -->
    <div class="ab-steps">
        <div class="ab-step is-active" data-step="1">
            <div class="ab-step-num">1</div>
            <div class="ab-step-lbl">Basic Info</div>
        </div>
        <div class="ab-step" data-step="2">
            <div class="ab-step-num">2</div>
            <div class="ab-step-lbl">Building Layout</div>
        </div>
        <div class="ab-step" data-step="3">
            <div class="ab-step-num">3</div>
            <div class="ab-step-lbl">Preview & Confirm</div>
        </div>
    </div>

    <!-- STEP 1: Basic Info -->
    <div id="ab-s1">
        <div class="ab-card">
            <h3 class="ab-card-title"><i class="fas fa-info-circle"></i> Apartment Details</h3>
            <div class="ab-grid">
                <div class="ab-field">
                    <label for="apartmentName">Building / Block Name *</label>
                    <input type="text" id="apartmentName" placeholder="e.g. Green Valley Tower A">
                    <small class="ab-hint">Enter a unique name for this building</small>
                </div>
                <div class="ab-field">
                    <label for="address">Address *</label>
                    <input type="text" id="address" placeholder="Street address">
                </div>
                <div class="ab-field">
                    <label for="city">City</label>
                    <input type="text" id="city" placeholder="City name">
                </div>
                <div class="ab-field">
                    <label for="state">State</label>
                    <input type="text" id="state" placeholder="State name">
                </div>
                <div class="ab-field">
                    <label for="pinCode">PIN Code</label>
                    <input type="text" id="pinCode" placeholder="6-digit PIN" maxlength="6">
                </div>
            </div>
            <button class="ab-btn ab-btn-primary ab-btn-full" onclick="abNext(2)">
                Next: Building Layout <i class="fas fa-arrow-right"></i>
            </button>
        </div>
    </div>

    <!-- STEP 2: Building Layout -->
    <div id="ab-s2" style="display:none;">
        <div class="ab-card">
            <h3 class="ab-card-title"><i class="fas fa-layer-group"></i> Building Configuration</h3>
            <div class="ab-layout-grid">
                <div class="ab-ctrl">
                    <label>Number of Floors *</label>
                    <div class="ab-counter">
                        <button class="ab-dec" onclick="abChFloors(-1)" title="Remove floor"></button>
                        <input type="number" id="totalFloors" class="ab-num-in" value="5" min="1" max="50" oninput="abStats()">
                        <button class="ab-inc" onclick="abChFloors(1)" title="Add floor"></button>
                    </div>
                    <small class="ab-hint" style="display:block;text-align:center;margin-top:.55rem;">1 – 50 floors</small>
                </div>
                <div class="ab-ctrl">
                    <label>Flats per Floor *</label>
                    <div class="ab-counter">
                        <button class="ab-dec" onclick="abChFlats(-1)" title="Remove flat"></button>
                        <input type="number" id="flatsPerFloor" class="ab-num-in" value="4" min="1" max="20" oninput="abStats()">
                        <button class="ab-inc" onclick="abChFlats(1)" title="Add flat"></button>
                    </div>
                    <small class="ab-hint" style="display:block;text-align:center;margin-top:.55rem;">1 – 20 flats per floor</small>
                </div>
            </div>
            <div class="ab-stats">
                <div class="ab-stat">
                    <div class="ab-stat-ico"><i class="fas fa-layer-group"></i></div>
                    <div>
                        <div class="ab-stat-val" id="ab-df">5</div>
                        <div class="ab-stat-lbl">Total Floors</div>
                    </div>
                </div>
                <div class="ab-stat">
                    <div class="ab-stat-ico"><i class="fas fa-door-open"></i></div>
                    <div>
                        <div class="ab-stat-val" id="ab-dp">4</div>
                        <div class="ab-stat-lbl">Flats / Floor</div>
                    </div>
                </div>
                <div class="ab-stat ab-stat-hl">
                    <div class="ab-stat-ico"><i class="fas fa-home"></i></div>
                    <div>
                        <div class="ab-stat-val" id="ab-dt">20</div>
                        <div class="ab-stat-lbl">Total Flats</div>
                    </div>
                </div>
            </div>
            <div class="ab-btn-row">
                <button class="ab-btn ab-btn-secondary" onclick="abPrev(1)">
                    <i class="fas fa-arrow-left"></i> Previous
                </button>
                <button class="ab-btn ab-btn-primary" onclick="abNext(3)">
                    Preview Building <i class="fas fa-arrow-right"></i>
                </button>
            </div>
        </div>
    </div>

    <!-- STEP 3: Preview & Confirm -->
    <div id="ab-s3" style="display:none;">
        <div class="ab-card">
            <h3 class="ab-card-title"><i class="fas fa-eye"></i> Building Preview</h3>
            <div style="margin-bottom:1.5rem;">
                <div class="ab-preview-hdr">
                    <h4>2D Floor Plan</h4>
                    <div class="ab-toggle">
                        <button class="ab-tbtn on" id="ab-t2d" onclick="abView('2d')">
                            <i class="fas fa-th"></i> 2D
                        </button>
                        <button class="ab-tbtn" id="ab-t3d" onclick="abView('3d')">
                            <i class="fas fa-cube"></i> 3D
                        </button>
                    </div>
                </div>
                <div class="ab-canvas" id="ab-p2d"></div>
                <div class="ab-canvas" id="ab-p3d" style="display:none;"></div>
            </div>
            <div class="ab-summary">
                <h4>Summary</h4>
                <table class="ab-sum-table">
                    <tr><td>Building Name</td><td id="ab-ss-name">-</td></tr>
                    <tr><td>Address</td>      <td id="ab-ss-addr">-</td></tr>
                    <tr><td>Total Floors</td> <td id="ab-ss-fl">-</td></tr>
                    <tr><td>Flats / Floor</td><td id="ab-ss-fp">-</td></tr>
                    <tr><td>Total Flats</td>  <td id="ab-ss-tot">-</td></tr>
                </table>
            </div>
            <div class="ab-btn-row">
                <button class="ab-btn ab-btn-secondary" onclick="abPrev(2)">
                    <i class="fas fa-arrow-left"></i> Previous
                </button>
                <button class="ab-btn ab-btn-success" onclick="abSubmit()">
                    <i class="fas fa-check-circle"></i> Create Apartment
                </button>
            </div>
        </div>
    </div>

    <!-- Loading Overlay -->
    <div id="ab-ov" class="ab-loading" style="display:none;">
        <div class="ab-spin"></div>
        <p>Creating your apartment building…</p>
    </div>

</div>

@section Scripts {
    <script src="~/js/apartment-visualizer-3d.js" asp-append-version="true"></script>
    <script src="~/js/apartment-builder.js" asp-append-version="true"></script>
}

















@*
@{
    ViewData["Title"] = "Create New Apartment";
}

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>

<style>
    .ab-wrap * {
        box-sizing: border-box;
    }

    .ab-wrap {
        --ab-bg: #060a1a;
        --ab-card: #0f1629;
        --ab-border: rgba(99,102,241,0.22);
        --ab-bdr-h: rgba(99,102,241,0.55);
        --ab-acc: #6366f1;
        --ab-acc2: #8b5cf6;
        --ab-green: #10b981;
        --ab-red: #ef4444;
        --ab-txt: #f1f5f9;
        --ab-txt2: #94a3b8;
        --ab-muted: #64748b;
        --ab-grad: linear-gradient(135deg,#6366f1,#8b5cf6);
        --ab-r1: 8px;
        --ab-r2: 14px;
        --ab-r3: 22px;
        background: var(--ab-bg);
        min-height: 100vh;
        padding: 2.5rem 1.25rem 4rem;
        font-family: 'Segoe UI', system-ui, sans-serif;
        color: var(--ab-txt);
    }

    /* HEADER */
    .ab-header {
        text-align: center;
        margin-bottom: 2.5rem;
    }

    .ab-title {
        font-size: clamp(1.7rem,4vw,2.4rem);
        font-weight: 800;
        background: linear-gradient(135deg,#c7d2fe,#a78bfa,#818cf8);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: .5rem;
    }

    .ab-subtitle {
        color: var(--ab-txt2);
        font-size: .95rem;
    }

    /* STEPS */
    .ab-steps {
        display: flex;
        justify-content: center;
        align-items: flex-start;
        margin-bottom: 2rem;
        position: relative;
    }

        .ab-steps::before {
            content: '';
            position: absolute;
            top: 21px;
            left: 50%;
            transform: translateX(-50%);
            width: 52%;
            height: 2px;
            background: var(--ab-border);
            z-index: 0;
        }

    .ab-step {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: .4rem;
        flex: 1;
        max-width: 160px;
        position: relative;
        z-index: 1;
    }

    .ab-step-num {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: .95rem;
        background: var(--ab-card);
        border: 2px solid var(--ab-border);
        color: var(--ab-muted);
        transition: all .35s ease;
    }

    .ab-step-lbl {
        font-size: .75rem;
        color: var(--ab-muted);
        font-weight: 500;
        white-space: nowrap;
    }

    .ab-step.is-active .ab-step-num {
        background: var(--ab-grad);
        border-color: transparent;
        color: #fff;
        box-shadow: 0 0 20px rgba(99,102,241,.5);
    }

    .ab-step.is-active .ab-step-lbl {
        color: var(--ab-acc);
        font-weight: 700;
    }

    .ab-step.is-done .ab-step-num {
        background: var(--ab-green);
        border-color: transparent;
        color: #fff;
    }

    .ab-step.is-done .ab-step-lbl {
        color: var(--ab-green);
    }

    /* CARD */
    .ab-card {
        background: var(--ab-card);
        border: 1px solid var(--ab-border);
        border-radius: var(--ab-r3);
        padding: 2.25rem;
        box-shadow: 0 0 32px rgba(99,102,241,.1);
        max-width: 820px;
        margin: 0 auto;
        transition: border-color .3s;
    }

        .ab-card:hover {
            border-color: var(--ab-bdr-h);
        }

    .ab-card-title {
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--ab-txt);
        margin-bottom: 1.75rem;
        display: flex;
        align-items: center;
        gap: .6rem;
    }

        .ab-card-title i {
            color: var(--ab-acc);
        }

    /* FORM */
    .ab-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit,minmax(190px,1fr));
        gap: 1.1rem;
        margin-bottom: 1.75rem;
    }

    .ab-field {
        display: flex;
        flex-direction: column;
        gap: .4rem;
    }

        .ab-field label {
            font-size: .82rem;
            font-weight: 600;
            color: var(--ab-txt2);
            letter-spacing: .3px;
        }

    /* ✅ WHITE TEXT INPUTS — scoped + !
    
    
    
    
    ant + JS backup */
    .ab-wrap input[type="text"],
    .ab-wrap input[type="number"],
    .ab-wrap input[type="email"],
    .ab-wrap input[type="tel"] {
        background: #0d1535 !important;
        border: 1.5px solid rgba(99,102,241,0.22) !important;
        border-radius: 8px !important;
        padding: .7rem 1rem !important;
        color: #f1f5f9 !important;
        -webkit-text-fill-color: #f1f5f9 !important;
        font-size: .93rem !important;
        outline: none !important;
        width: 100% !important;
        transition: border-color .25s, box-shadow .25s !important;
        font-family: inherit !important;
    }

    .ab-wrap input::placeholder {
        color: #475569 !important;
        opacity: 1 !important;
    }

    .ab-wrap input:focus {
        border-color: #6366f1 !important;
        box-shadow: 0 0 0 3px rgba(99,102,241,.15) !important;
        background: #111d3a !important;
        color: #f1f5f9 !important;
        -webkit-text-fill-color: #f1f5f9 !important;
    }

    .ab-wrap input:-webkit-autofill,
    .ab-wrap input:-webkit-autofill:hover,
    .ab-wrap input:-webkit-autofill:focus {
        -webkit-text-fill-color: #f1f5f9 !important;
        -webkit-box-shadow: 0 0 0 1000px #0d1535 inset !important;
        caret-color: #f1f5f9 !important;
    }

    .ab-hint {
        font-size: .75rem;
        color: var(--ab-muted);
    }

    /* BUTTONS */
    .ab-btn {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        padding: .8rem 1.75rem;
        border-radius: var(--ab-r1);
        border: none;
        cursor: pointer;
        font-weight: 600;
        font-size: .92rem;
        transition: all .25s ease;
        text-decoration: none;
        font-family: inherit;
    }

    .ab-btn-primary {
        background: var(--ab-grad);
        color: #fff;
        box-shadow: 0 4px 14px rgba(99,102,241,.3);
    }

        .ab-btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 22px rgba(99,102,241,.45);
            color: #fff;
        }

    .ab-btn-secondary {
        background: rgba(255,255,255,.05);
        color: var(--ab-txt2);
        border: 1.5px solid var(--ab-border);
    }

        .ab-btn-secondary:hover {
            background: rgba(255,255,255,.1);
            color: var(--ab-txt);
        }

    .ab-btn-success {
        background: linear-gradient(135deg,#10b981,#059669);
        color: #fff;
        box-shadow: 0 4px 14px rgba(16,185,129,.3);
        padding: 1rem 2.5rem;
    }

        .ab-btn-success:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 22px rgba(16,185,129,.45);
        }

    .ab-btn-full {
        width: 100%;
        justify-content: center;
        padding: 1rem;
    }

    .ab-btn-row {
        display: flex;
        gap: .875rem;
        justify-content: center;
        flex-wrap: wrap;
        margin-top: 1.75rem;
    }

    /* LAYOUT CONTROLS */
    .ab-layout-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.25rem;
        margin-bottom: 1.75rem;
    }

    @@media(max-width:560px) {
        .ab-layout-grid {
            grid-template-columns: 1fr;
        }
    }

    .ab-ctrl {
        background: rgba(99,102,241,.05);
        border: 1.5px solid var(--ab-border);
        border-radius: var(--ab-r2);
        padding: 1.4rem;
        transition: border-color .3s;
    }

        .ab-ctrl:hover {
            border-color: var(--ab-bdr-h);
        }

        .ab-ctrl > label {
            display: block;
            font-size: .82rem;
            font-weight: 600;
            color: var(--ab-txt2);
            margin-bottom: .9rem;
        }

    .ab-counter {
        display: flex;
        align-items: center;
        gap: .7rem;
        justify-content: center;
    }

    /*EMOJI CIRCLE BUTTONS */
    .ab-dec, .ab-inc {
        width: 46px;
        height: 46px;
        border-radius: 50%;
        border: 2px solid var(--ab-border);
        background: rgba(255,255,255,.04);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        line-height: 1;
        padding: 0;
        flex-shrink: 0;
        transition: all .22s ease;
    }

        .ab-dec::before {
            content: '🏚️';
        }

        .ab-inc::before {
            content: '🏗️';
        }

        .ab-dec:hover, .ab-inc:hover {
            background: rgba(99,102,241,.18);
            border-color: var(--ab-acc);
            transform: scale(1.13);
            box-shadow: 0 0 14px rgba(99,102,241,.35);
        }

        .ab-dec:active, .ab-inc:active {
            transform: scale(.93);
        }

    /* Number input inside counter */
    .ab-num-in {
        background: #0d1535 !important;
        border: 1.5px solid rgba(99,102,241,0.22) !important;
        border-radius: 8px !important;
        color: #f1f5f9 !important;
        -webkit-text-fill-color: #f1f5f9 !important;
        font-size: 2rem !important;
        font-weight: 800 !important;
        text-align: center !important;
        width: 86px !important;
        padding: .4rem !important;
        -moz-appearance: textfield !important;
        outline: none !important;
    }

        .ab-num-in::-webkit-inner-spin-button,
        .ab-num-in::-webkit-outer-spin-button {
            -webkit-appearance: none;
        }

        .ab-num-in:focus {
            border-color: #6366f1 !important;
            box-shadow: 0 0 0 3px rgba(99,102,241,.15) !important;
        }

    /* STATS */
    .ab-stats {
        display: grid;
        grid-template-columns: repeat(3,1fr);
        gap: .875rem;
        margin-bottom: 1.75rem;
    }

    .ab-stat {
        background: rgba(255,255,255,.03);
        border: 1.5px solid var(--ab-border);
        border-radius: var(--ab-r2);
        padding: 1.1rem .875rem;
        display: flex;
        align-items: center;
        gap: .8rem;
        transition: all .3s;
    }

        .ab-stat:hover {
            border-color: var(--ab-bdr-h);
            background: rgba(99,102,241,.06);
        }

    .ab-stat-hl {
        background: rgba(99,102,241,.09) !important;
        border-color: rgba(99,102,241,.38) !important;
    }

    .ab-stat-ico {
        width: 40px;
        height: 40px;
        border-radius: 9px;
        background: rgba(99,102,241,.16);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        color: var(--ab-acc);
        flex-shrink: 0;
    }

    .ab-stat-val {
        font-size: 1.65rem;
        font-weight: 800;
        color: var(--ab-txt);
        line-height: 1;
        transition: transform .2s,color .2s;
    }

    .ab-stat-lbl {
        font-size: .72rem;
        color: var(--ab-muted);
        font-weight: 500;
        margin-top: .2rem;
    }

    /* PREVIEW */
    .ab-preview-hdr {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.1rem;
        flex-wrap: wrap;
        gap: .75rem;
    }

        .ab-preview-hdr h4 {
            font-size: 1rem;
            font-weight: 700;
            color: var(--ab-txt2);
        }

    .ab-toggle {
        display: flex;
        gap: .35rem;
        background: rgba(255,255,255,.04);
        border: 1px solid var(--ab-border);
        border-radius: var(--ab-r1);
        padding: .28rem;
    }

    .ab-tbtn {
        padding: .42rem .95rem;
        border-radius: 6px;
        border: none;
        background: transparent;
        color: var(--ab-muted);
        cursor: pointer;
        font-size: .83rem;
        font-weight: 600;
        font-family: inherit;
        transition: all .22s;
        display: flex;
        align-items: center;
        gap: .35rem;
    }

        .ab-tbtn.on {
            background: var(--ab-grad);
            color: #fff;
            box-shadow: 0 2px 8px rgba(99,102,241,.3);
        }

    /*  COMPACT 2D */
    .ab-canvas {
        border-radius: var(--ab-r2);
        overflow: hidden;
        min-height: 120px;
    }

    .ab-bld-title {
        text-align: center;
        margin-bottom: .75rem;
        font-size: .88rem;
        font-weight: 700;
        color: var(--ab-acc);
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    .ab-bld-wrap {
        background: rgba(4,7,18,.8);
        border: 1px solid var(--ab-border);
        border-radius: var(--ab-r2);
        padding: .875rem .875rem .5rem;
        overflow: auto;
        max-height: 360px;
    }

    .ab-floor-row {
        display: flex;
        align-items: center;
        gap: .55rem;
        margin-bottom: .4rem;
        min-width: min-content;
    }

    .ab-floor-lbl {
        font-size: .68rem;
        font-weight: 700;
        color: var(--ab-acc);
        min-width: 34px;
        text-align: right;
        flex-shrink: 0;
        opacity: .85;
    }

    .ab-flats-row {
        display: flex;
        gap: .28rem;
        flex-wrap: nowrap;
    }

    .ab-flat {
        width: 46px;
        height: 46px;
        border-radius: 5px;
        border: 1px solid rgba(99,102,241,.28);
        background: rgba(20,28,70,.65);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        cursor: default;
        transition: all .18s;
        position: relative;
        overflow: hidden;
    }

        .ab-flat::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg,rgba(99,102,241,.06),transparent);
        }

        .ab-flat:hover {
            border-color: var(--ab-acc);
            background: rgba(99,102,241,.14);
            transform: scale(1.1);
            z-index: 3;
            box-shadow: 0 2px 10px rgba(99,102,241,.28);
        }

    .ab-flat-num {
        font-size: .65rem;
        font-weight: 800;
        color: var(--ab-txt);
        line-height: 1;
        position: relative;
        z-index: 1;
    }

    .ab-flat-ico {
        font-size: .55rem;
        color: var(--ab-muted);
        margin-top: 2px;
        position: relative;
        z-index: 1;
    }

    /* SUMMARY */
    .ab-summary {
        background: rgba(255,255,255,.025);
        border: 1px solid var(--ab-border);
        border-radius: var(--ab-r2);
        padding: 1.4rem;
        margin-bottom: 1.75rem;
    }

        .ab-summary h4 {
            font-size: .95rem;
            font-weight: 700;
            color: var(--ab-txt2);
            margin-bottom: .9rem;
        }

    .ab-sum-table {
        width: 100%;
        border-collapse: collapse;
    }

