@model ApartmentManagementSystem.Web.ViewModels.Apartment.ApartmentDetailViewModel

@{
    ViewData["Title"] = Model.Name;
}

<div class="apartment-details-container">
    <!-- Breadcrumb -->
    <div class="breadcrumb">
        <a href="@Url.Action("ManageApartments", "ApartmentBuilder")">
            <i class="fas fa-arrow-left"></i> Back to Apartments
        </a>
    </div>

    <!-- Header Section -->
    <div class="details-header">
        <div class="header-left">
            <div class="building-icon-large">
                <i class="fas fa-building"></i>
            </div>
            <div class="header-info">
                <h1 class="apartment-title">@Model.Name</h1>
                <div class="apartment-meta">
                    <span class="meta-item">
                        <i class="fas fa-map-marker-alt"></i>
                        @Model.Address
                    </span>
                    @if (!string.IsNullOrEmpty(Model.City))
                    {
                        <span class="meta-item">
                            <i class="fas fa-city"></i>
                            @Model.City, @Model.State
                        </span>
                    }
                </div>
                <div class="status-badge status-@Model.Status.ToLower()">
                    @Model.Status
                </div>
            </div>
        </div>
        <div class="header-actions">
            <a href="@Url.Action("Visualize", "ApartmentBuilder", new { id = Model.Id })"
               class="btn btn-visualize-large">
                <i class="fas fa-cube"></i>
                View 3D Model
            </a>
        </div>
    </div>

    <!-- Stats Overview -->
    <div class="stats-overview">
        <div class="stat-card">
            <div class="stat-icon"><i class="fas fa-layer-group"></i></div>
            <div class="stat-content">
                <div class="stat-value">@Model.TotalFloors</div>
                <div class="stat-label">Total Floors</div>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon"><i class="fas fa-door-open"></i></div>
            <div class="stat-content">
                <div class="stat-value">@Model.FlatsPerFloor</div>
                <div class="stat-label">Flats per Floor</div>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon"><i class="fas fa-home"></i></div>
            <div class="stat-content">
                <div class="stat-value">@Model.TotalFlats</div>
                <div class="stat-label">Total Flats</div>
            </div>
        </div>

        <div class="stat-card stat-highlight">
            <div class="stat-icon"><i class="fas fa-users"></i></div>
            <div class="stat-content">
                <div class="stat-value">@Model.OccupiedFlats</div>
                <div class="stat-label">Occupied</div>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon"><i class="fas fa-key"></i></div>
            <div class="stat-content">
                <div class="stat-value">@Model.VacantFlats</div>
                <div class="stat-label">Vacant</div>
            </div>
        </div>
    </div>

    <!-- Main Content Grid -->
    <div class="content-grid">
        <!-- Manager Section -->
        <div class="info-card">
            <div class="card-header-custom">
                <h3><i class="fas fa-user-tie"></i> Building Manager</h3>
                @if (Model.Manager == null)
                {
                    <button class="btn btn-sm btn-primary" onclick="openAssignManagerModal()">
                        <i class="fas fa-plus"></i> Assign Manager
                    </button>
                }
            </div>
            <div class="card-body-custom">
                @if (Model.Manager != null)
                {
                    <div class="person-card">
                        <div class="person-avatar">
                            <i class="fas fa-user-tie"></i>
                        </div>
                        <div class="person-info">
                            <h4>@Model.Manager.FullName</h4>
                            <p><i class="fas fa-envelope"></i> @Model.Manager.Email</p>
                            <p><i class="fas fa-phone"></i> @Model.Manager.Phone</p>
                            <p class="text-muted">
                                <i class="fas fa-calendar"></i>
                                Assigned: @Model.Manager.AssignedAt.ToString("MMM dd, yyyy")
                            </p>
                        </div>
                        <button class="btn-remove" onclick="handleRemoveManager()">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                }
                else
                {
                    <div class="empty-section">
                        <i class="fas fa-user-slash"></i>
                        <p>No manager assigned yet</p>
                    </div>
                }
            </div>
        </div>

        <!-- Community Leaders Section -->
        <div class="info-card">
            <div class="card-header-custom">
                <h3><i class="fas fa-users-cog"></i> Community Leaders</h3>
            </div>
            <div class="card-body-custom">
                <!-- President -->
                <div class="leader-item">
                    <div class="leader-role">
                        <i class="fas fa-crown"></i>
                        <span>President</span>
                    </div>
                    @if (Model.President != null)
                    {
                        <div class="leader-info">
                            <strong>@Model.President.FullName</strong>
                            <span class="text-muted">Flat: @Model.President.FlatNumber</span>
                        </div>
                    }
                    else
                    {
                        <button class="btn btn-sm btn-outline" onclick="assignRole('President')">
                            <i class="fas fa-plus"></i> Assign
                        </button>
                    }
                </div>

                <!-- Secretary -->
                <div class="leader-item">
                    <div class="leader-role">
                        <i class="fas fa-clipboard-list"></i>
                        <span>Secretary</span>
                    </div>
                    @if (Model.Secretary != null)
                    {
                        <div class="leader-info">
                            <strong>@Model.Secretary.FullName</strong>
                            <span class="text-muted">Flat: @Model.Secretary.FlatNumber</span>
                        </div>
                    }
                    else
                    {
                        <button class="btn btn-sm btn-outline" onclick="assignRole('Secretary')">
                            <i class="fas fa-plus"></i> Assign
                        </button>
                    }
                </div>

                <!-- Treasurer -->
                <div class="leader-item">
                    <div class="leader-role">
                        <i class="fas fa-coins"></i>
                        <span>Treasurer</span>
                    </div>
                    @if (Model.Treasurer != null)
                    {
                        <div class="leader-info">
                            <strong>@Model.Treasurer.FullName</strong>
                            <span class="text-muted">Flat: @Model.Treasurer.FlatNumber</span>
                        </div>
                    }
                    else
                    {
                        <button class="btn btn-sm btn-outline" onclick="assignRole('Treasurer')">
                            <i class="fas fa-plus"></i> Assign
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="quick-actions-section">
        <h3><i class="fas fa-bolt"></i> Quick Actions</h3>
        <div class="actions-grid">
            <a href="#" class="action-card">
                <i class="fas fa-users"></i>
                <span>Manage Residents</span>
            </a>
            <a href="#" class="action-card">
                <i class="fas fa-tools"></i>
                <span>Manage Staff</span>
            </a>
            <a href="#" class="action-card">
                <i class="fas fa-file-invoice-dollar"></i>
                <span>View Finances</span>
            </a>
            <a href="#" class="action-card">
                <i class="fas fa-calendar-alt"></i>
                <span>Events & Notices</span>
            </a>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/apartment-builder.css" />
    <style>
        .apartment-details-container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 40px 20px;
        }

        .breadcrumb {
            margin-bottom: 30px;
        }

            .breadcrumb a {
                color: #667eea;
                text-decoration: none;
                font-weight: 600;
                display: inline-flex;
                align-items: center;
                gap: 8px;
                transition: all 0.3s ease;
            }

                .breadcrumb a:hover {
                    color: #764ba2;
                    transform: translateX(-5px);
                }

        .details-header {
            background: #1a1f3a;
            border-radius: 20px;
            padding: 40px;
            margin-bottom: 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border: 1px solid #2d3748;
            flex-wrap: wrap;
            gap: 20px;
        }

        .header-left {
            display: flex;
            gap: 25px;
            align-items: center;
        }

        .building-icon-large {
            width: 100px;
            height: 100px;
            background: linear-gradient(135deg, #667eea, #764ba2);
            border-radius: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 3rem;
            color: white;
            box-shadow: 0 10px 30px rgba(102, 126, 234, 0.4);
        }

        .apartment-title {
            font-size: 2.5rem;
            font-weight: 800;
            color: white;
            margin-bottom: 10px;
        }

        .apartment-meta {
            display: flex;
            gap: 20px;
            margin-bottom: 15px;
            flex-wrap: wrap;
        }

        .meta-item {
            color: #a0aec0;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .status-badge {
            display: inline-block;
            padding: 8px 16px;
            border-radius: 20px;
            font-size: 0.9rem;
            font-weight: 600;
            text-transform: uppercase;
        }

        .btn-visualize-large {
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: white;
            padding: 16px 32px;
            border-radius: 12px;
            text-decoration: none;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            transition: all 0.3s ease;
            box-shadow: 0 5px 20px rgba(102, 126, 234, 0.3);
        }

            .btn-visualize-large:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 30px rgba(102, 126, 234, 0.5);
            }

        .stats-overview {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 40px;
        }

        .stat-card {
            background: #1a1f3a;
            border-radius: 16px;
            padding: 25px;
            display: flex;
            align-items: center;
            gap: 20px;
            border: 2px solid #2d3748;
            transition: all 0.3s ease;
        }

            .stat-card:hover {
                border-color: #667eea;
                transform: translateY(-5px);
            }

        .stat-highlight {
            background: linear-gradient(135deg, rgba(102, 126, 234, 0.2), rgba(118, 75, 162, 0.2));
            border-color: #667eea;
        }

        .content-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
            gap: 30px;
            margin-bottom: 40px;
        }

        .info-card {
            background: #1a1f3a;
            border-radius: 20px;
            border: 1px solid #2d3748;
            overflow: hidden;
        }

        .card-header-custom {
            padding: 25px;
            border-bottom: 1px solid #2d3748;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

            .card-header-custom h3 {
                font-size: 1.4rem;
                color: white;
                display: flex;
                align-items: center;
                gap: 12px;
            }

        .card-body-custom {
            padding: 25px;
        }

        .person-card {
            display: flex;
            gap: 20px;
            align-items: center;
            background: rgba(255, 255, 255, 0.03);
            padding: 20px;
            border-radius: 12px;
            position: relative;
        }

        .person-avatar {
            width: 70px;
            height: 70px;
            border-radius: 50%;
            background: linear-gradient(135deg, #667eea, #764ba2);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            color: white;
        }

        .person-info h4 {
            color: white;
            margin-bottom: 8px;
            font-size: 1.2rem;
        }

        .person-info p {
            color: #a0aec0;
            margin-bottom: 5px;
            font-size: 0.9rem;
        }

        .btn-remove {
            position: absolute;
            top: 15px;
            right: 15px;
            width: 30px;
            height: 30px;
            border-radius: 50%;
            border: none;
            background: rgba(245, 101, 101, 0.2);
            color: #f56565;
            cursor: pointer;
            transition: all 0.3s ease;
        }

            .btn-remove:hover {
                background: #f56565;
                color: white;
            }

        .empty-section {
            text-align: center;
            padding: 40px;
            color: #a0aec0;
        }

            .empty-section i {
                font-size: 3rem;
                margin-bottom: 15px;
                opacity: 0.5;
            }

        .leader-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 15px 0;
            border-bottom: 1px solid #2d3748;
        }

            .leader-item:last-child {
                border-bottom: none;
            }

        .leader-role {
            display: flex;
            align-items: center;
            gap: 10px;
            font-weight: 600;
            color: #667eea;
        }

        .leader-info {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
        }

            .leader-info strong {
                color: white;
                margin-bottom: 5px;
            }

        .quick-actions-section h3 {
            font-size: 1.8rem;
            color: white;
            margin-bottom: 25px;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .actions-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
        }

        .action-card {
            background: #1a1f3a;
            border: 2px solid #2d3748;
            border-radius: 16px;
            padding: 30px;
            text-align: center;
            text-decoration: none;
            color: white;
            transition: all 0.3s ease;
        }

            .action-card:hover {
                background: rgba(102, 126, 234, 0.1);
                border-color: #667eea;
                transform: translateY(-5px);
            }

            .action-card i {
                font-size: 2.5rem;
                color: #667eea;
                margin-bottom: 15px;
                display: block;
            }

            .action-card span {
                font-weight: 600;
                font-size: 1.1rem;
            }

        .btn-sm {
            padding: 8px 16px;
            font-size: 0.9rem;
        }

        .btn-outline {
            background: transparent;
            border: 2px solid #667eea;
            color: #667eea;
        }

            .btn-outline:hover {
                background: #667eea;
                color: white;
            }

        .text-muted {
            color: #a0aec0 !important;
            font-size: 0.85rem;
        }

        /* TAB STYLES */
        .btn-tab {
            flex: 1;
            border: none;
            border-radius: 8px;
            padding: 12px;
            background: transparent;
            color: #a0aec0;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
        }

            .btn-tab.active {
                background: linear-gradient(135deg, #667eea, #764ba2);
                color: white;
            }

            .btn-tab:hover {
                background: rgba(102, 126, 234, 0.2);
            }

        @@media (max-width: 768px) {
            .content-grid {
                grid-template-columns: 1fr;
            }

            .header-left {
                flex-direction: column;
                text-align: center;
            }
        }
    </style>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // MANAGER ASSIGNMENT 
        const APARTMENT_ID = '@Model.Id';

        function openAssignManagerModal() {
            const modalHtml = `
                <div class="modal fade" id="managerModal" tabindex="-1">
                    <div class="modal-dialog modal-lg">
                        <div class="modal-content" style="background: #1a1f3a; color: white; border: 1px solid #667eea;">

                            <div class="modal-header" style="border-bottom: 1px solid #2d3748;">
                                <h5 class="modal-title">
                                    <i class="fas fa-user-tie" style="color: #667eea;"></i> Assign Building Manager
                                </h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                            </div>

                            <div class="modal-body">

                                <!-- TABS -->
                                <div class="btn-group w-100 mb-4" style="background: #0a0e27; border-radius: 10px; padding: 5px;">
                                    <button type="button" class="btn-tab active" id="tab1" onclick="switchToTab(1)">
                                        <i class="fas fa-home"></i> From This Apartment
                                    </button>
                                    <button type="button" class="btn-tab" id="tab2" onclick="switchToTab(2)">
                                        <i class="fas fa-user-plus"></i> Any Person
                                    </button>
                                </div>

                                <!-- PANEL 1: RESIDENTS -->
                                <div id="panel1">
                                    <div class="alert" style="background: rgba(102, 126, 234, 0.1); border: 1px solid #667eea; border-radius: 10px; padding: 15px; margin-bottom: 20px;">
                                        <i class="fas fa-info-circle"></i> Select a resident owner from this apartment
                                    </div>

                                    <label class="form-label fw-bold" style="color: white;">
                                        <i class="fas fa-users"></i> Select Resident
                                    </label>
                                    <select class="form-select mb-3" id="selectResident" style="background: #0a0e27; color: white; border: 1px solid #2d3748; padding: 12px; border-radius: 8px;">
                                        <option value="">Loading...</option>
                                    </select>
                                </div>

                                <!-- PANEL 2: EXTERNAL -->
                                <div id="panel2" style="display:none;">
                                    <div class="alert" style="background: rgba(245, 158, 11, 0.1); border: 1px solid #f59e0b; border-radius: 10px; padding: 15px; margin-bottom: 20px;">
                                        <i class="fas fa-exclamation-triangle"></i> Assign anyone as manager
                                    </div>

                                    <div class="mb-3">
                                        <label style="color: white; font-weight: bold;">
                                            <i class="fas fa-user"></i> Full Name <span style="color: #ef4444;">*</span>
                                        </label>
                                        <input type="text" class="form-control" id="inputName" placeholder="Enter full name" style="background: #0a0e27; color: white; border: 1px solid #2d3748; padding: 12px; border-radius: 8px;">
                                    </div>

                                    <div class="mb-3">
                                        <label style="color: white; font-weight: bold;">
                                            <i class="fas fa-phone"></i> Phone <span style="color: #ef4444;">*</span>
                                        </label>
                                        <input type="tel" class="form-control" id="inputPhone" placeholder="10-digit number" maxlength="10" style="background: #0a0e27; color: white; border: 1px solid #2d3748; padding: 12px; border-radius: 8px;">
                                    </div>

                                    <div class="mb-3">
                                        <label style="color: white; font-weight: bold;">
                                            <i class="fas fa-envelope"></i> Email <span style="color: #a0aec0;">(optional)</span>
                                        </label>
                                        <input type="email" class="form-control" id="inputEmail" placeholder="Email address" style="background: #0a0e27; color: white; border: 1px solid #2d3748; padding: 12px; border-radius: 8px;">
                                    </div>
                                </div>

                                <div id="msgError" class="alert alert-danger d-none mt-3"></div>
                                <div id="msgSuccess" class="alert alert-success d-none mt-3"></div>
                            </div>

                            <div class="modal-footer" style="border-top: 1px solid #2d3748;">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                    <i class="fas fa-times"></i> Cancel
                                </button>
                                <button type="button" class="btn btn-primary" id="btnAssign" onclick="handleAssignManager()">
                                    <i class="fas fa-check"></i> Assign Manager
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            `;

            const old = document.getElementById('managerModal');
            if (old) old.remove();

            document.body.insertAdjacentHTML('beforeend', modalHtml);
            loadResidentsList();

            const modal = new bootstrap.Modal(document.getElementById('managerModal'));
            modal.show();
        }

        function switchToTab(tabNum) {
            const panel1 = document.getElementById('panel1');
            const panel2 = document.getElementById('panel2');
            const tab1 = document.getElementById('tab1');
            const tab2 = document.getElementById('tab2');

            clearMessages();

            if (tabNum === 1) {
                panel1.style.display = 'block';
                panel2.style.display = 'none';
                tab1.classList.add('active');
                tab2.classList.remove('active');
            } else {
                panel1.style.display = 'none';
                panel2.style.display = 'block';
                tab1.classList.remove('active');
                tab2.classList.add('active');
            }
        }

        async function loadResidentsList() {
            const select = document.getElementById('selectResident');

            try {
              //  const response = await fetch(`/api/Manager/apartment-residents/${APARTMENT_ID}`);
               const response=await fetch(`/ApartmentBuilder/GetApartmentResidents?apartmentId=${APARTMENT_ID}`);

                const data = await response.json();

                if (data && data.success && data.data && data.data.length > 0) {
                    select.innerHTML = '<option value="">-- Select Resident --</option>';

                    data.data.forEach(r => {
                        const opt = document.createElement('option');
                        opt.value = r.userId;
                        opt.textContent = `${r.fullName} - Flat ${r.flatNumber}`;
                        select.appendChild(opt);
                    });
                } else {
                    select.innerHTML = '<option value="">No residents found</option>';
                    showError('No resident owners found. Use "Any Person" tab.');
                }
            } catch (err) {
                console.error(err);
                select.innerHTML = '<option value="">Error</option>';
                showError('Failed to load residents. Use "Any Person" tab.');
            }
        }

        async function handleAssignManager() {
            const isTab1 = document.getElementById('tab1').classList.contains('active');

            clearMessages();

            const btn = document.getElementById('btnAssign');
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Assigning...';

            let payload = { apartmentId: APARTMENT_ID };

            try {
                if (isTab1) {
                    const userId = document.getElementById('selectResident').value;
                    if (!userId) {
                        showError('Please select a resident');
                        return;
                    }
                    payload.userId = userId;
                    payload.isExternalManager = false;
                } else {
                    const name = document.getElementById('inputName').value.trim();
                    const phone = document.getElementById('inputPhone').value.trim();
                    const email = document.getElementById('inputEmail').value.trim();

                    if (!name) {
                        showError('Name is required');
                        return;
                    }
                    if (!phone || phone.length !== 10 || !/^\d+$/.test(phone)) {
                        showError('Please enter valid 10-digit phone');
                        return;
                    }

                    payload.isExternalManager = true;
                    payload.externalManagerName = name;
                    payload.externalManagerPhone = phone;
                    payload.externalManagerEmail = email || null;
                }

                const response = await fetch('/ApartmentBuilder/AssignManager', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                const result = await response.json();

                if (result.success) {
                    showSuccess('✅ Manager assigned successfully!');
                    setTimeout(() => {
                        location.reload();
                    }, 1500);
                } else {
                    showError(result.message || 'Failed to assign manager');
                }
            } catch (err) {
                console.error(err);
                showError('An error occurred');
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-check"></i> Assign Manager';
            }
        }

        async function handleRemoveManager() {
            if (!confirm('⚠️ Remove current manager?')) return;

            try {
                const response = await fetch('/ApartmentBuilder/RemoveManager', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ apartmentId: APARTMENT_ID })
                });

                const result = await response.json();

                if (result.success) {
                    alert('✅ Manager removed!');
                    location.reload();
                } else {
                    alert('❌ ' + (result.message || 'Failed'));
                }
            } catch (err) {
                console.error(err);
                alert('❌ Error');
            }
        }

        function showError(msg) {
            const el = document.getElementById('msgError');
            const success = document.getElementById('msgSuccess');
            if (success) success.classList.add('d-none');
            if (el) {
                el.textContent = msg;
                el.classList.remove('d-none');
            }
        }

        function showSuccess(msg) {
            const el = document.getElementById('msgSuccess');
            const error = document.getElementById('msgError');
            if (error) error.classList.add('d-none');
            if (el) {
                el.textContent = msg;
                el.classList.remove('d-none');
            }
        }

        function clearMessages() {
            const error = document.getElementById('msgError');
            const success = document.getElementById('msgSuccess');
            if (error) error.classList.add('d-none');
            if (success) success.classList.add('d-none');
        }

                function assignRole(role) {
            const apartmentId = APARTMENT_ID;
            // Redirect to Community/AssignRole with apartmentId and role pre-selected
            window.location.href = `/Community/AssignRole?apartmentId=${apartmentId}&role=${role}`;
        }
    </script>
}






