*@
@model ApartmentManagementSystem.Web.ViewModels.Onboarding.VerifyOtpViewModel
@{
    ViewData["Title"] = "Verify OTP - New User";
    Layout = "_Layout";
}

<style>
    :root {
        --gradient-primary: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        --shadow-lg: 0 8px 24px rgba(0, 0, 0, 0.15);
    }

    body {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .verify-card {
        background: white;
        border-radius: 20px;
        box-shadow: var(--shadow-lg);
        overflow: hidden;
        max-width: 500px;
        width: 100%;
        margin: 2rem auto;
    }

    .card-header-gradient {
        background: var(--gradient-primary);
        color: white;
        padding: 1.5rem 2rem;
        text-align: center;
    }

        .card-header-gradient h4 {
            margin: 0;
            font-weight: 700;
            font-size: 1.5rem;
        }

            .card-header-gradient h4 i {
                margin-right: 0.5rem;
            }

    .card-body-custom {
        padding: 2rem;
    }

    .info-text {
        color: #718096;
        margin-bottom: 1.5rem;
        text-align: center;
        font-size: 0.95rem;
    }

    .form-label {
        font-weight: 600;
        color: #4a5568;
        margin-bottom: 0.5rem;
        font-size: 0.9rem;
    }

    .form-control {
        border: 2px solid #e2e8f0;
        border-radius: 10px;
        padding: 0.75rem 1rem;
        transition: all 0.3s ease;
    }

        .form-control:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
        }

    .otp-input {
        text-align: center;
        font-size: 1.5rem;
        letter-spacing: 8px;
        font-weight: 700;
        font-family: 'Courier New', monospace;
    }

    .btn-submit {
        background: var(--gradient-primary);
        border: none;
        color: white;
        border-radius: 12px;
        padding: 0.85rem 2rem;
        font-weight: 600;
        font-size: 1rem;
        width: 100%;
        box-shadow: 0 4px 12px rgba(102, 126, 234, 0.3);
        transition: all 0.3s ease;
        margin-bottom: 0.75rem;
    }

        .btn-submit:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(102, 126, 234, 0.4);
        }

    .btn-back {
        background: white;
        border: 2px solid #e2e8f0;
        color: #4a5568;
        border-radius: 12px;
        padding: 0.85rem 2rem;
        font-weight: 600;
        width: 100%;
        transition: all 0.3s ease;
    }

        .btn-back:hover {
            border-color: #cbd5e0;
            background: #f7fafc;
        }

    @@media (max-width: 768px) {
        body {
            padding: 1rem;
        }

        .verify-card {
            margin: 1rem;
        }

        .card-body-custom {
            padding: 1.5rem;
        }

        .otp-input {
            font-size: 1.25rem;
            letter-spacing: 5px;
        }
    }
</style>

<div class="container">
    <div class="verify-card">
        <div class="card-header-gradient">
            <h4>
                <i class="bi bi-shield-check"></i> Verify Your OTP
            </h4>
        </div>
        <div class="card-body-custom">
            <p class="info-text">
                Enter the phone number and OTP provided by your admin to continue registration.
            </p>
            <form asp-action="Index" method="post">
                <div class="mb-3">
                    <label asp-for="PrimaryPhone" class="form-label">Phone Number</label>
                    <input asp-for="PrimaryPhone" class="form-control" placeholder="Enter phone number" />
                    <span asp-validation-for="PrimaryPhone" class="text-danger"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="OtpCode" class="form-label">OTP Code</label>
                    <input asp-for="OtpCode" class="form-control otp-input"
                           placeholder="000000" maxlength="6" />
                    <span asp-validation-for="OtpCode" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-submit">
                    <i class="bi bi-check-circle"></i> Verify OTP
                </button>
                <a asp-controller="Login" asp-action="Index" class="btn btn-back">
                    Back to Login
                </a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
