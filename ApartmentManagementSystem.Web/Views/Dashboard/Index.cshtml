                                                {
                                                    <span class="badge bg-warning ms-2">High</span>
                                                }
                                            </h6>
                                            <p class="mb-2 small text-muted">@notice.Message</p>
                                            <small class="text-muted">
                                                <i class="bi bi-person"></i> @notice.PostedBy (@notice.FlatNumber) •
                                                <i class="bi bi-clock"></i> @notice.PostedAt.ToString("MMM dd, hh:mm tt")
                                            </small>
                                        </div>
                                        <span class="badge bg-info">@notice.Category</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            @if (isManager)
            {
                var mgrModel = Model as ApartmentManagementSystem.Web.ViewModels.Dashboard.ManagerDashboardViewModel;
                <div class="col-lg-4">
                    <div class="card">
                        <div class="card-header">
                            <h5 class="mb-0"><i class="bi bi-clock-history"></i> Pending Residents</h5>
                        </div>
                        <div class="card-body">
                            @if (mgrModel.PendingResidents.Any())
                            {
                                <div class="list-group">
                                    @foreach (var resident in mgrModel.PendingResidents.Take(5))
                                    {
                                        <div class="list-group-item">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <div>
                                                    <h6 class="mb-1">@resident.FullName</h6>
                                                    <small class="text-muted">
                                                        <i class="bi bi-phone"></i> @resident.PrimaryPhone<br />
                                                        <i class="bi bi-tag"></i> @resident.ResidentType
                                                    </small>
                                                </div>
                                                <a asp-controller="AdminResidents" asp-action="Pending" class="btn btn-sm btn-primary">
                                                    Assign
                                                </a>
                                            </div>
                                        </div>
                                    }
                                </div>
                                <div class="text-center mt-3">
                                    <a asp-controller="AdminResidents" asp-action="Pending" class="btn btn-outline-primary btn-sm">
                                        View All (@mgrModel.Stats.PendingRegistrations)
                                    </a>
                                </div>
                            }
                            else
                            {
                                <div class="text-center py-4">
                                    <i class="bi bi-check-circle" style="font-size: 3rem; color: #38c96b;"></i>
                                    <p class="text-muted mt-2">No pending residents</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <!-- Recent Activities -->
    @if (Model.RecentActivities != null && Model.RecentActivities.Any())
    {
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header" style="background: linear-gradient(135deg, #5a6fd8 0%, #6b4299 100%) !important;">
                        <h5 class="mb-0"><i class="bi bi-clock-history"></i> Recent Activities</h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Activity</th>
                                        <th>Type</th>
                                        <th>Timestamp</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var activity in Model.RecentActivities.Take(10))
                                    {
                                        <tr>
                                            <td>@activity.Activity</td>
                                            <td>
                                                <span class="role-badge" style="font-size: 0.75rem; padding: 0.25rem 0.65rem;">@activity.Type</span>
                                            </td>
                                            <td class="text-muted small">@activity.Timestamp.ToString("MMM dd, yyyy hh:mm tt")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        async function showApartmentSelector() {
            try {
                const response = await fetch('/api/ApartmentManagement/all');
                const data = await response.json();

                if (data && data.success && data.data && data.data.length > 0) {
                    const apartments = data.data;
                    const modalHtml = `
                        <div class="modal fade" id="apartmentSelectorModal" tabindex="-1">
                            <div class="modal-dialog">
                                <div class="modal-content" style="background: #1a1f3a; color: white; border: 1px solid #5a6fd8;">
                                    <div class="modal-header" style="border-bottom: 1px solid #2d3748;">
                                        <h5 class="modal-title">
                                            <i class="bi bi-building"></i> Select Apartment
                                        </h5>
                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                    </div>
                                    <div class="modal-body">
                                        <label class="form-label fw-bold">Choose apartment to manage community members:</label>
                                        <select class="form-select" id="apartmentSelect" style="background: #0a0e27; color: white; border: 1px solid #2d3748; padding: 12px; border-radius: 8px;">
                                            <option value="">-- Select Apartment --</option>
                                            ${apartments.map(apt => `<option value="${apt.id}">${apt.name}</option>`).join('')}
                                        </select>
                                    </div>
                                    <div class="modal-footer" style="border-top: 1px solid #2d3748;">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                        <button type="button" class="btn btn-primary" onclick="goToCommunityMembers()">Continue</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    `;

                    const old = document.getElementById('apartmentSelectorModal');
                    if (old) old.remove();

                    document.body.insertAdjacentHTML('beforeend', modalHtml);
                    const modal = new bootstrap.Modal(document.getElementById('apartmentSelectorModal'));
                    modal.show();
                } else {
                    alert('No apartments found. Please create an apartment first.');
                }
            } catch (err) {
                console.error(err);
                alert('Failed to load apartments');
            }
        }

        function goToCommunityMembers(apartmentId) {
            if (apartmentId) {
                window.location.href = `/Community/Index?apartmentId=${apartmentId}`;
            } else {
                const select = document.getElementById('apartmentSelect');
                const selectedId = select.value;
                if (!selectedId) {
                    alert('Please select an apartment');
                    return;
                }
                window.location.href = `/Community/Index?apartmentId=${selectedId}`;
            }
        }
    </script>
}












@*
@model ApartmentManagementSystem.Web.ViewModels.Dashboard.EnhancedDashboardViewModel


